---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/blocks/PageHero.astro";
import BlogList from "../../../components/blocks/BlogList.astro";
import LearnMoreSection from "../../../components/blocks/LearnMoreSection.astro";
import TagPills from "../../../components/ui/TagPills.astro";
import CallToAction from "../../../components/blocks/CallToAction.astro";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';
import Markdoc from '@markdoc/markdoc';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const allPosts = await reader.collections.caseStudies.all();

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const slugs = await reader.collections.caseStudies.list();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await reader.collections.caseStudies.read(slug!);
if (!post) throw new Error(`Case study not found: ${slug}`);

const body = await post.body();
const bodyHtml = Markdoc.renderers.html(Markdoc.transform(body.node));

const formattedDate = post.publishedDate
  ? new Date(post.publishedDate).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : "";

const relatedSolutionSlugs = (post.relatedSolutions || []).filter(
  (s): s is string => typeof s === "string"
);
const relatedProductSlugs = (post.relatedProducts || []).filter(
  (s): s is string => typeof s === "string"
);

const relatedSolutionEntries = await Promise.all(
  relatedSolutionSlugs.map(async (s) => ({ slug: s, entry: await reader.collections.solutions.read(s) }))
);
const relatedProductEntries = await Promise.all(
  relatedProductSlugs.map(async (s) => ({ slug: s, entry: await reader.collections.products.read(s) }))
);

const learnMoreItems = [
  ...relatedSolutionEntries
    .filter((r) => r.entry)
    .map((r) => ({
      title: r.entry!.headline || r.slug,
      slug: r.slug,
      subheadline: r.entry!.subheadline,
      basePath: "/solutions",
    })),
  ...relatedProductEntries
    .filter((r) => r.entry)
    .map((r) => ({
      title: r.entry!.headline || r.slug,
      slug: r.slug,
      subheadline: r.entry!.subheadline,
      basePath: "/products",
    })),
];

const otherPosts = allPosts
  .filter((p) => p.slug !== slug)
  .sort((a, b) => (b.entry.publishedDate || "").localeCompare(a.entry.publishedDate || ""))
  .slice(0, 3)
  .map((p) => ({
    title: p.entry.title,
    subtitle: p.entry.subtitle,
    slug: p.slug,
    description: p.entry.description,
    image: p.entry.image,
    publishedDate: p.entry.publishedDate,
    meta: p.entry.client,
    tags: p.entry.tags,
  }));
---

<Base title={post.title}>
  <PageHero headline={post.title} subheadline={post.subtitle || post.description} />

  {post.image?.src && (
    <section class="px-6">
      <div class="max-w-4xl mx-auto reveal -mt-8">
        <img
          src={post.image.src}
          alt={post.image.alt?.trim() ? post.image.alt : post.title}
          class="w-full rounded-2xl border border-black/[0.06]"
        />
      </div>
    </section>
  )}

  <section class="py-16 md:py-20 px-6">
    <div class="max-w-3xl mx-auto reveal">
      {(post.client || formattedDate) && (
        <p class="text-xs font-semibold tracking-widest uppercase text-tolemi-sky-600 mb-6">
          {[post.client, formattedDate].filter(Boolean).join(" • ")}
        </p>
      )}
      <div class="richtext richtext-lead">
        <Fragment set:html={bodyHtml} />
      </div>
      {post.tags && post.tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-black/[0.08]">
          <TagPills tags={post.tags} />
        </div>
      )}
    </div>
  </section>

  <LearnMoreSection items={learnMoreItems} />

  {otherPosts.length > 0 && (
    <section class="py-16 md:py-20 px-6 bg-surface-muted/50">
      <div class="max-w-6xl mx-auto reveal">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-10 text-center">More Case Studies</h2>
      </div>
      <BlogList basePath="/blog/case-studies" items={otherPosts} />
    </section>
  )}

  <CallToAction
    heading="Ready to Get Started?"
    text="See how Tolemi can support your city's work."
    buttonText="Get a Demo"
    buttonLink="https://calendar.app.google/ADWYkErAkBkvTd9C6"
  />
</Base>
