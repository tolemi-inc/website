---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/blocks/PageHero.astro";
import BlogList from "../../../components/blocks/BlogList.astro";
import CallToAction from "../../../components/blocks/CallToAction.astro";
import UseCaseFilterBar from "../../../components/blocks/UseCaseFilterBar.astro";
import { colorForUseCase } from "../../../lib/useCaseColors";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const posts = await reader.collections.caseStudies.all();
const solutions = await reader.collections.solutions.all();

const solutionMap = new Map(
  solutions.map((s) => [s.slug, s.entry.title || s.slug])
);

const items = posts
  .map((p) => {
    const useCases = (p.entry.relatedSolutions || []).filter(
      (s): s is string => typeof s === "string"
    );
    return {
      title: p.entry.title,
      subtitle: p.entry.subtitle,
      slug: p.slug,
      description: p.entry.description,
      image: p.entry.image,
      publishedDate: p.entry.publishedDate,
      meta: p.entry.client,
      filterTags: useCases,
      tags: useCases.map((slug) => ({
        label: solutionMap.get(slug) || slug,
        href: `/blog/case-studies?tag=${encodeURIComponent(slug)}`,
        color: colorForUseCase(slug),
      })),
    };
  })
  .sort((a, b) => (b.publishedDate || "").localeCompare(a.publishedDate || ""));

const filterOptions = Array.from(
  new Set(items.flatMap((i) => i.filterTags))
)
  .map((slug) => ({
    slug,
    label: solutionMap.get(slug) || slug,
    color: colorForUseCase(slug),
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<Base title="Case Studies">
  <PageHero
    headline="Case Studies"
    subheadline="How cities and agencies are using Tolemi to drive results."
  />

  <UseCaseFilterBar basePath="/blog/case-studies" options={filterOptions} />

  <BlogList basePath="/blog/case-studies" items={items} />

  <CallToAction
    heading="Could Your City Be Next?"
    text="See how Tolemi can support your team's work."
    buttonText="Get a Demo"
    buttonLink="https://calendar.app.google/ADWYkErAkBkvTd9C6"
  />
</Base>
