---
import Base from "../../../layouts/Base.astro";
import PageHero from "../../../components/blocks/PageHero.astro";
import BlogList from "../../../components/blocks/BlogList.astro";
import CallToAction from "../../../components/blocks/CallToAction.astro";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const posts = await reader.collections.caseStudies.all();

const items = posts
  .map((p) => ({
    title: p.entry.title,
    subtitle: p.entry.subtitle,
    slug: p.slug,
    description: p.entry.description,
    image: p.entry.image,
    publishedDate: p.entry.publishedDate,
    meta: p.entry.client,
  }))
  .sort((a, b) => (b.publishedDate || "").localeCompare(a.publishedDate || ""));
---

<Base title="Case Studies">
  <PageHero
    headline="Case Studies"
    subheadline="How cities and agencies are using Tolemi to drive results."
  />

  <BlogList basePath="/blog/case-studies" items={items} />

  <CallToAction
    heading="Could Your City Be Next?"
    text="See how Tolemi can support your team's work."
    buttonText="Get a Demo"
    buttonLink="#contact"
  />
</Base>
