---
import Base from "../layouts/Base.astro";
import PageHero from "../components/blocks/PageHero.astro";
import CallToAction from "../components/blocks/CallToAction.astro";
import TeamPhotos from "../components/blocks/TeamPhotos.astro";
import AccordionSection from "../components/blocks/AccordionSection.astro";
import BenefitsGrid from "../components/blocks/BenefitsGrid.astro";
import InternshipSection from "../components/blocks/InternshipSection.astro";
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const careersData = await reader.singletons.careersPage.read();
if (!careersData) throw new Error("Careers page data not found");
---

<Base title={careersData.title}>
  <PageHero
    headline={careersData.headline}
    subheadline={careersData.subheadline}
  />

  <TeamPhotos
    featurePhoto={careersData.teamPhotos.featurePhoto}
    photos={careersData.teamPhotos.photos}
  />

  <AccordionSection
    heading={careersData.culture.heading || undefined}
    items={careersData.culture.items}
  />

  <BenefitsGrid heading={careersData.perksHeading || undefined} items={careersData.perks} />

  <InternshipSection
    eyebrow={careersData.internship.eyebrow}
    heading={careersData.internship.heading}
    body={careersData.internship.body}
    tracks={careersData.internship.tracks}
    outcomes={careersData.internship.outcomes}
    photo={careersData.internship.photo}
    photoCaption={careersData.internship.photoCaption}
  />

  <CallToAction
    heading="Want to Join Our Team?"
    text="If you care about housing and love solving interesting problems and making a difference, we would love to hear from you. See our current openings on Indeed — or if you don't see your role, drop us a line."
    buttonText="View Open Roles"
    buttonLink="https://www.indeed.com/cmp/Tolemi"
    secondaryButtonText="Get in Touch"
    secondaryButtonLink="mailto:careers@tolemi.com"
  />
</Base>
