---
export const prerender = true;

import Base from "../layouts/Base.astro";
import LandingBody from "../components/blocks/LandingBody.astro";

import homeData from "../../content/pages/home.json";

// Blocks are stored as { discriminant, value } by Keystatic
const block = (name: string) =>
  (homeData.blocks.find((b: any) => b.discriminant === name) as any)?.value;
---

<Base title={homeData.title}>
  <LandingBody
    hero={block("hero")}
    story={block("story")}
    products={block("products")}
    registration={block("registration")}
    howWeWork={block("howWeWork")}
    whyUs={block("whyUs")}
    logos={block("logos")}
    stats={block("stats")}
    cta={block("cta")}
  />
</Base>
