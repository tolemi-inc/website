---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/blocks/PageHero.astro";
import FeatureBlock from "../../components/blocks/FeatureBlock.astro";
import CrossLinkCards from "../../components/blocks/CrossLinkCards.astro";
import CallToAction from "../../components/blocks/CallToAction.astro";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Markdoc from '@markdoc/markdoc';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const allSolutions = await reader.collections.solutions.all();

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const slugs = await reader.collections.solutions.list();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const solution = await reader.collections.solutions.read(slug!);
if (!solution) throw new Error(`Solution not found: ${slug}`);

const body = await solution.body();
const bodyHtml = Markdoc.renderers.html(Markdoc.transform(body.node));
const otherSolutions = allSolutions.filter((s) => s.slug !== slug);

const features = (solution.features || []).map((f) => ({
  title: f.title,
  bodyHtml: Markdoc.renderers.html(Markdoc.transform(f.body.node)),
  images: f.images,
}));
---

<Base title={solution.title}>
  <PageHero
    headline={solution.headline}
    subheadline={solution.subheadline}
    image={solution.image}
  />

  <section class="py-16 md:py-20 px-6">
    <div class="max-w-3xl mx-auto reveal richtext richtext-lead">
      <Fragment set:html={bodyHtml} />
    </div>
  </section>

  {features.length > 0 && (
    <section class="py-16 md:py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-14 md:mb-20 text-center reveal">Key Features</h2>
        <div class="flex flex-col gap-20 md:gap-28">
          {features.map((f, i) => (
            <FeatureBlock title={f.title} bodyHtml={f.bodyHtml} images={f.images} reverse={i % 2 === 1} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CrossLinkCards
    heading="Other Solutions"
    basePath="/solutions"
    items={otherSolutions.map((s) => ({ title: s.entry.title, slug: s.slug, subheadline: s.entry.subheadline }))}
  />

  <CallToAction
    heading="Ready to Get Started?"
    text="See how Tolemi can help your city with a personalized demo."
    buttonText="Get a Demo"
    buttonLink="https://calendar.app.google/ADWYkErAkBkvTd9C6"
  />
</Base>
