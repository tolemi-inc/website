---
import Base from "../layouts/Base.astro";
import PageHero from "../components/blocks/PageHero.astro";
import HowWeWork from "../components/blocks/HowWeWork.astro";
import CallToAction from "../components/blocks/CallToAction.astro";
import CityPhotos from "../components/blocks/CityPhotos.astro";
import TeamPhotos from "../components/blocks/TeamPhotos.astro";
import CaptionedImage from "../components/ui/CaptionedImage.astro";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Markdoc from '@markdoc/markdoc';
import { renderRichtext } from '../lib/richtext';

export const prerender = true;

const reader = createReader(process.cwd(), keystaticConfig);
const aboutData = await reader.singletons.aboutPage.read();
if (!aboutData) throw new Error('About page data not found');

const historyBody = await aboutData.historyBody();

// City photos sit above the last paragraph of the history, so split the
// body there and render the two halves separately.
const bodyNodes = historyBody.node.children;
const lastParagraph = bodyNodes.findLastIndex((n) => n.type === 'paragraph');
const splitAt = aboutData.cityPhotos.length > 0 && lastParagraph > 0 ? lastParagraph : bodyNodes.length;
const toHtml = (nodes: typeof bodyNodes) => renderRichtext(new Markdoc.Ast.Node('document', {}, nodes));
// With a history image, the first paragraph sits beside it and the rest of
// the history starts below.
const leadEnd = aboutData.historyImage.photo.src && bodyNodes[0]?.type === 'paragraph' ? 1 : 0;
const historyLeadHtml = leadEnd ? toHtml(bodyNodes.slice(0, leadEnd)) : '';
const historyHtml = toHtml(bodyNodes.slice(leadEnd, splitAt));
const historyClosingHtml = splitAt < bodyNodes.length ? toHtml(bodyNodes.slice(splitAt)) : '';
---

<Base title={aboutData.title}>
  <PageHero headline={aboutData.headline} subheadline={aboutData.subheadline} />

  <TeamPhotos featurePhoto={aboutData.teamPhoto} background="" />

  <section class="py-16 md:py-20 px-6">
    <div class="max-w-3xl mx-auto reveal">
      {historyLeadHtml && (
        <div class="grid sm:grid-cols-[13rem_1fr] md:grid-cols-[15rem_1fr] gap-8 md:gap-10 items-center mb-12 md:mb-16">
          <CaptionedImage
            src={aboutData.historyImage.photo.src!}
            alt={aboutData.historyImage.photo.alt}
            caption={aboutData.historyImage.caption}
            credit={aboutData.historyImage.credit}
            class="max-w-60 mx-auto sm:max-w-none sm:mx-0"
          />
          <div class="richtext">
            <Fragment set:html={historyLeadHtml} />
          </div>
        </div>
      )}
      {aboutData.historyHeading && <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-6">{aboutData.historyHeading}</h2>}
      <div class="richtext">
        <Fragment set:html={historyHtml} />
      </div>
      {historyClosingHtml && (
        <>
          <CityPhotos photos={aboutData.cityPhotos} />
          <div class="richtext">
            <Fragment set:html={historyClosingHtml} />
          </div>
        </>
      )}
    </div>
  </section>

  {aboutData.milestones && aboutData.milestones.length > 0 && (
    <section class="py-16 md:py-20 px-6">
      <div class="max-w-3xl mx-auto reveal">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-10">Milestones</h2>
        <div class="relative border-l-2 border-tolemi-sky/20 pl-8 flex flex-col gap-10">
          {aboutData.milestones.map((m) => (
            <div class="relative">
              <div class="absolute -left-[41px] top-1 w-4 h-4 rounded-full bg-tolemi-sky-600 border-4 border-white"></div>
              <span class="text-sm font-bold text-tolemi-sky-600">{m.year}</span>
              <p class="text-text-secondary mt-1 leading-relaxed">{m.event}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {aboutData.howWeWork && aboutData.howWeWork.steps.length > 0 && (
    <HowWeWork {...aboutData.howWeWork} />
  )}

  <CallToAction
    heading="Ready to Transform Your City's Data?"
    text="Join the growing number of cities using Tolemi to make smarter decisions."
    buttonText="Get a Demo"
    buttonLink="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ26Tpr4z7DJiPH0I5A_GEZp38PjfcTI2kFyL2AzAxRkSzd43n49BtV7fFPUXYaT2xD61pV3oQHo"
  />
</Base>
