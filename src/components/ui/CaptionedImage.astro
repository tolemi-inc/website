---
// An image whose optional caption fades in over it on hover, with an optional
// credit underneath in small muted type, matching CityPhotos.
import HoverCaption from "./HoverCaption.astro";

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  credit?: string;
  captionColor?: string;
  creditColor?: string;
  class?: string;
}

const {
  src,
  alt,
  caption,
  credit,
  captionColor,
  creditColor = "text-text-muted",
  class: classAttr = "",
} = Astro.props;
---

<figure class={classAttr}>
  <div class="group relative overflow-hidden rounded-xl shadow-sm">
    <img
      src={src}
      alt={alt?.trim() || caption || ""}
      loading="lazy"
      decoding="async"
      class="w-full block"
    />
    {caption && <HoverCaption text={caption} textColor={captionColor} />}
  </div>
  {credit && (
    <figcaption class={`mt-2.5 text-xs ${creditColor}`}>Image: {credit}</figcaption>
  )}
</figure>
