---
interface Props {
  images: string[];
  alt?: string;
}

const { images, alt = "" } = Astro.props;
const id = `carousel-${Math.random().toString(36).slice(2, 10)}`;
---

{images.length === 1 && (
  <div class="rounded-2xl overflow-hidden border border-black/[0.06] bg-surface-secondary">
    <img src={images[0]} alt={alt} class="w-full h-auto" />
  </div>
)}

{images.length > 1 && (
  <div class="relative" data-carousel-id={id}>
    <div
      class="carousel-track flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory rounded-2xl scrollbar-none"
      data-carousel-track={id}
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {images.map((src, i) => (
        <div class="snap-start shrink-0 w-full">
          <img
            src={src}
            alt={`${alt} ${i + 1}`}
            class="w-full h-auto rounded-2xl border border-black/[0.06] bg-surface-secondary"
          />
        </div>
      ))}
    </div>

    <button
      type="button"
      class="carousel-prev absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/95 border border-black/[0.06] shadow-md flex items-center justify-center text-text-primary hover:bg-white hover:shadow-lg transition disabled:opacity-30 disabled:cursor-not-allowed"
      data-carousel-prev={id}
      aria-label="Previous image"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      type="button"
      class="carousel-next absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/95 border border-black/[0.06] shadow-md flex items-center justify-center text-text-primary hover:bg-white hover:shadow-lg transition disabled:opacity-30 disabled:cursor-not-allowed"
      data-carousel-next={id}
      aria-label="Next image"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <div class="flex justify-center gap-2 mt-4" data-carousel-dots={id}>
      {images.map((_, i) => (
        <button
          type="button"
          class="carousel-dot w-2 h-2 rounded-full bg-text-muted/30 hover:bg-text-muted/60 transition aria-[current=true]:bg-tolemi-sky-600 aria-[current=true]:w-6"
          data-carousel-dot={id}
          data-index={i}
          aria-label={`Go to image ${i + 1}`}
        />
      ))}
    </div>
  </div>
)}

<style>
  .carousel-track::-webkit-scrollbar { display: none; }
</style>

<script>
  type CarouselNodes = {
    track: HTMLElement;
    prev: HTMLButtonElement;
    next: HTMLButtonElement;
    dots: NodeListOf<HTMLButtonElement>;
  };

  function setupCarousel(id: string) {
    const track = document.querySelector<HTMLElement>(`[data-carousel-track="${id}"]`);
    const prev = document.querySelector<HTMLButtonElement>(`[data-carousel-prev="${id}"]`);
    const next = document.querySelector<HTMLButtonElement>(`[data-carousel-next="${id}"]`);
    const dots = document.querySelectorAll<HTMLButtonElement>(`[data-carousel-dot="${id}"]`);
    if (!track || !prev || !next) return;

    const scrollByOne = (dir: 1 | -1) => {
      track.scrollBy({ left: dir * track.clientWidth, behavior: "smooth" });
    };

    const updateState = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, idx) => d.setAttribute("aria-current", idx === i ? "true" : "false"));
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    prev.addEventListener("click", () => scrollByOne(-1));
    next.addEventListener("click", () => scrollByOne(1));
    dots.forEach((d) =>
      d.addEventListener("click", () => {
        const idx = Number(d.dataset.index);
        track.scrollTo({ left: idx * track.clientWidth, behavior: "smooth" });
      })
    );
    track.addEventListener("scroll", updateState, { passive: true });
    window.addEventListener("resize", updateState);
    updateState();
  }

  document.querySelectorAll<HTMLElement>("[data-carousel-id]").forEach((el) => {
    const id = el.dataset.carouselId;
    if (id) setupCarousel(id);
  });
</script>
