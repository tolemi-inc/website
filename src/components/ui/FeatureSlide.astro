---
import SectionHeader from "./SectionHeader.astro";

interface Props {
  title: string;
  description?: string;
  accentGradient: string;
  bgGradient: string;
  dividerColor?: string;
  reverse?: boolean;
}

const {
  title,
  description,
  accentGradient,
  bgGradient,
  dividerColor,
  reverse = false,
} = Astro.props;
---

<div class={`feature-slide relative overflow-hidden ${bgGradient}`}>
  <div class="max-w-7xl mx-auto px-6 py-24 md:py-32 grid md:grid-cols-2 gap-16 items-center">
    <div class={reverse ? "feature-slide-right md:order-2" : "feature-slide-left"}>
      <div class={`w-8 h-1 rounded-full bg-gradient-to-r ${accentGradient} mb-6`} />
      <SectionHeader
        heading={title}
        subtitle={description}
        align="left"
        size="md"
      />
    </div>
    <div class={reverse ? "feature-slide-left w-full max-w-lg md:order-1" : "feature-slide-right w-full max-w-lg"}>
      <slot />
    </div>
  </div>
  {dividerColor && (
    <div class={`absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent ${dividerColor} to-transparent`} />
  )}
</div>
