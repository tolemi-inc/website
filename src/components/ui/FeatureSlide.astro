---
interface Props {
  title: string;
  description?: string;
  accentGradient: string;
  bgGradient: string;
  dividerColor?: string;
  reverse?: boolean;
}

const {
  title,
  description,
  accentGradient,
  bgGradient,
  dividerColor,
  reverse = false,
} = Astro.props;
---

<section
  class={`feature-card sticky top-0 h-screen min-h-[600px] overflow-hidden bg-surface ${bgGradient}`}
>
  <div class="h-full max-w-7xl mx-auto px-6 py-8 md:py-12 grid md:grid-cols-2 gap-6 md:gap-10 items-center content-center">
    <div class={reverse ? "md:order-2" : ""}>
      <div class={`w-8 h-1 rounded-full bg-gradient-to-r ${accentGradient} mb-4`} />
      <h2 class="font-heading text-2xl md:text-3xl lg:text-4xl font-bold text-text-primary tracking-tight mb-3">
        {title}
      </h2>
      {description && (
        <p class="text-base md:text-lg text-text-secondary max-w-md leading-relaxed">
          {description}
        </p>
      )}
    </div>
    <div class={reverse ? "w-full max-w-md mx-auto md:order-1" : "w-full max-w-md mx-auto"}>
      <slot />
    </div>
  </div>
  {dividerColor && (
    <div class={`absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent ${dividerColor} to-transparent`} />
  )}
</section>
