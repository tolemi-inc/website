---
import {
  useCaseColorClasses,
  type UseCaseColor,
} from "../../lib/useCaseColors";

export interface TagItem {
  label: string;
  href?: string;
  color?: UseCaseColor;
}

interface Props {
  tags: readonly (string | TagItem)[];
  size?: "sm" | "md";
}

const { tags, size = "md" } = Astro.props;

const sizeClasses =
  size === "sm" ? "text-[10px] px-2 py-0.5" : "text-xs px-2.5 py-1";

const defaultClasses =
  "bg-tolemi-sky-50 text-tolemi-sky-700 ring-tolemi-sky-200";

const normalized = (tags || []).map((t) =>
  typeof t === "string" ? { label: t } : t
);
---

{normalized.length > 0 && (
  <ul class="flex flex-wrap gap-1.5">
    {normalized.map((tag) => {
      const colorClasses = tag.color
        ? useCaseColorClasses[tag.color]
        : defaultClasses;
      const baseClasses = `${sizeClasses} inline-block rounded-full font-semibold tracking-wide ring-1 ring-inset ${colorClasses}`;
      return (
        <li>
          {tag.href ? (
            <a
              href={tag.href}
              class={`${baseClasses} transition-colors`}
              data-use-case-tag
            >
              {tag.label}
            </a>
          ) : (
            <span class={baseClasses}>{tag.label}</span>
          )}
        </li>
      );
    })}
  </ul>
)}
