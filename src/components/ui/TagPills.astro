---
import {
  useCaseDotClasses,
  type UseCaseColor,
} from "../../lib/useCaseColors";

export interface TagItem {
  label: string;
  href?: string;
  color?: UseCaseColor;
}

interface Props {
  tags: readonly (string | TagItem)[];
  size?: "sm" | "md";
}

const { tags, size = "md" } = Astro.props;

const sizeClasses =
  size === "sm" ? "text-[11px] gap-1.5 px-2.5 py-1" : "text-xs gap-2 px-3 py-1.5";

const dotSize = size === "sm" ? "w-1.5 h-1.5" : "w-2 h-2";

// Neutral chip; the use-case color is carried by the dot alone.
const chipClasses =
  "bg-white text-text-secondary ring-1 ring-inset ring-black/10";

const normalized = (tags || []).map((t) =>
  typeof t === "string" ? { label: t } : t
);
---

{normalized.length > 0 && (
  <ul class="flex flex-wrap gap-1.5">
    {normalized.map((tag) => {
      const baseClasses = `${sizeClasses} inline-flex items-center rounded-full font-heading font-semibold ${chipClasses}`;
      const dot = tag.color && (
        <span class={`${dotSize} rounded-full shrink-0 ${useCaseDotClasses[tag.color]}`} aria-hidden="true"></span>
      );
      return (
        <li>
          {tag.href ? (
            <a
              href={tag.href}
              class={`${baseClasses} transition-colors hover:text-text-primary hover:ring-black/25`}
              data-use-case-tag
            >
              {dot}
              {tag.label}
            </a>
          ) : (
            <span class={baseClasses}>{dot}{tag.label}</span>
          )}
        </li>
      );
    })}
  </ul>
)}
