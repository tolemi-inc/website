---
interface Props {
  tags: readonly string[];
  size?: "sm" | "md";
}

const { tags, size = "md" } = Astro.props;

const sizeClasses =
  size === "sm" ? "text-[10px] px-2 py-0.5" : "text-xs px-2.5 py-1";
---

{tags && tags.length > 0 && (
  <ul class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <li
        class={`${sizeClasses} rounded-full bg-tolemi-sky/8 text-tolemi-sky-600 border border-tolemi-sky/15 font-medium tracking-wide`}
      >
        {tag}
      </li>
    ))}
  </ul>
)}
