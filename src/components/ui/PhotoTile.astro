---
// A rounded photo that fills its box (give it a height via `class`, or let a
// grid cell size it). An optional caption fades in over the photo, on a dark
// filter, on hover.
import HoverCaption from "./HoverCaption.astro";

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  captionColor?: string;
  overlayColor?: string;
  imgPosition?: string;
  position?: string;
  class?: string;
  [dataAttr: `data-${string}`]: unknown;
}

const {
  src,
  alt,
  caption,
  captionColor,
  overlayColor,
  imgPosition = "object-center",
  position = "relative",
  class: classAttr = "",
  ...attrs
} = Astro.props;
---

<figure class={`${position} flex flex-col ${classAttr}`} {...attrs}>
  <div class="group relative flex-1 min-h-0 overflow-hidden rounded-2xl shadow-lg shadow-black/5">
    <img
      src={src}
      alt={alt?.trim() || caption || ""}
      loading="lazy"
      decoding="async"
      class={`absolute inset-0 w-full h-full object-cover ${imgPosition}`}
    />
    {caption && <HoverCaption text={caption} textColor={captionColor} overlayColor={overlayColor} />}
  </div>
</figure>
