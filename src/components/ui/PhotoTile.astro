---
// A rounded photo that fills its box (give it a height via `class`, or let a
// grid cell size it), with an optional caption underneath. The caption takes
// its line from the box, so the photo shrinks to make room rather than
// overflowing.

interface Props {
  src: string;
  alt?: string;
  caption?: string;
  captionColor?: string;
  imgPosition?: string;
  position?: string;
  class?: string;
  [dataAttr: `data-${string}`]: unknown;
}

const {
  src,
  alt,
  caption,
  captionColor = "text-text-secondary",
  imgPosition = "object-center",
  position = "relative",
  class: classAttr = "",
  ...attrs
} = Astro.props;
---

<figure class={`${position} flex flex-col ${classAttr}`} {...attrs}>
  <div class="relative flex-1 min-h-0 overflow-hidden rounded-2xl shadow-lg shadow-black/5">
    <img
      src={src}
      alt={alt?.trim() || caption || ""}
      loading="lazy"
      decoding="async"
      class={`absolute inset-0 w-full h-full object-cover ${imgPosition}`}
    />
  </div>
  {caption && (
    <figcaption class={`mt-2.5 text-sm leading-snug ${captionColor}`}>
      {caption}
    </figcaption>
  )}
</figure>
