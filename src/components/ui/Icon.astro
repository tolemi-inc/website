---
// Inline line icon (Lucide-style, 24×24, stroke = currentColor). Names match
// the `iconOptions` select in keystatic.config.ts — add a path in lib/icons.ts and an
// option there to make a new icon available in the CMS.
//
// Pass `fill` (background classes, e.g. a `bg-gradient-to-br …` string) to
// paint the icon with a background instead of currentColor — the icon becomes
// a mask over it, so it can share a gradient with a CardDot exactly.
import { icons, iconMask } from "../../lib/icons";

interface Props {
  name?: string;
  class?: string;
  fill?: string;
}

const { name, class: classAttr = "w-5 h-5", fill } = Astro.props;

const svg = name ? icons[name] : undefined;
const mask = name && fill ? iconMask(name) : undefined;
---

{mask ? (
  <span
    aria-hidden="true"
    class={`inline-block ${classAttr} ${fill}`}
    style={`-webkit-mask: ${mask} center / contain no-repeat; mask: ${mask} center / contain no-repeat;`}
  ></span>
) : svg && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class={classAttr}
    set:html={svg}
  />
)}
