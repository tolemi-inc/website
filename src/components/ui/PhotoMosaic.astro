---
// A bento grid of photos. Each photo's `size` sets its footprint — standard
// (1×1), wide (2×1), tall (1×2) or large (2×2) — and dense packing fills the
// gaps, so order photos roughly as you'd like them read. Captions overlay the
// bottom of the tile on a dark fade. `focus` picks which part of the photo
// stays in frame when the tile crops it.
import PhotoTile from "./PhotoTile.astro";

interface Photo {
  photo?: { src: string | null; alt?: string } | null;
  caption?: string;
  size?: string;
  focus?: string;
}
interface Props {
  photos?: Photo[];
  rowHeight?: string;
  captionColor?: string;
}

const {
  photos = [],
  rowHeight = "auto-rows-[150px] sm:auto-rows-[190px] lg:auto-rows-[220px]",
  captionColor,
} = Astro.props;

const SPANS: Record<string, string> = {
  standard: "",
  wide: "col-span-2",
  tall: "row-span-2",
  large: "col-span-2 row-span-2",
};

const FOCUS: Record<string, string> = {
  center: "object-center",
  top: "object-top",
  bottom: "object-bottom",
};

const items = photos.filter((p) => p.photo?.src);
---

{items.length > 0 && (
  <div class={`grid grid-cols-2 md:grid-cols-4 grid-flow-dense ${rowHeight} gap-3 md:gap-4 reveal`}>
    {items.map((p) => (
      <PhotoTile
        src={p.photo!.src!}
        alt={p.photo!.alt}
        caption={p.caption}
        captionColor={captionColor}
        imgPosition={FOCUS[p.focus ?? "center"] ?? FOCUS.center}
        class={SPANS[p.size ?? "standard"] ?? ""}
      />
    ))}
  </div>
)}
