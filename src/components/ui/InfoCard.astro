---
// The site's informational card: colored dot in the top-right corner, an
// optional icon inline with the title, and a light (white) or dark (navy)
// variant. `accent` picks a logo color for both: the icon is always painted
// with the dot's exact gradient so the two never drift apart. Use the "title" slot / default slot instead of the title /
// description props when the text needs inline HTML.
import CardDot from "./CardDot.astro";
import Icon from "./Icon.astro";
import { dotFill, type BrandAccent } from "../../lib/brandAccents";

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  icon?: string;
  dark?: boolean;
  headingTag?: "h2" | "h3" | "h4" | "h5";
  accent?: BrandAccent;
  dotColor?: string;
  iconColor?: string;
  eyebrowColor?: string;
  darkEyebrowColor?: string;
  titleSize?: string;
  class?: string;
}

const {
  title,
  description,
  eyebrow,
  icon,
  dark = false,
  headingTag: Heading = "h3",
  accent = "sky",
  dotColor = dotFill(accent),
  iconColor = dotColor,
  eyebrowColor = "text-tolemi-sky-600",
  darkEyebrowColor = "text-tolemi-sky",
  titleSize = "text-lg",
  class: classAttr = "",
} = Astro.props;

const hasBody = description || Astro.slots.has("default");
---

<div
  class={`relative h-full rounded-2xl p-5 md:p-6 ${
    dark
      ? "bg-tolemi-navy shadow-lg shadow-tolemi-navy/20"
      : "bg-surface border border-text-muted/10 shadow-lg shadow-black/5"
  } ${classAttr}`}
>
  <CardDot color={dotColor} size="w-4.5 h-4.5" position="top-[25px] right-6 md:top-[29px] md:right-7" />
  {eyebrow && (
    <p
      class={`font-heading text-xs font-semibold uppercase tracking-[0.15em] lining-nums mb-2 pr-10 ${
        dark ? darkEyebrowColor : eyebrowColor
      }`}
    >
      {eyebrow}
    </p>
  )}
  <div class="flex items-center gap-2.5 min-h-7 mb-1.5 pr-10">
    {icon && <Icon name={icon} fill={iconColor} class="w-5 h-5 flex-shrink-0" />}
    <Heading class={`font-heading ${titleSize} font-bold leading-snug ${dark ? "text-white" : "text-text-primary"}`}>
      <slot name="title">{title}</slot>
    </Heading>
  </div>
  {hasBody && (
    <p class={`text-sm leading-relaxed ${dark ? "text-white/75" : "text-text-secondary"}`}>
      <slot>{description}</slot>
    </p>
  )}
</div>
