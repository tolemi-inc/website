---
// The site's informational card: colored dot in the top-right corner, an
// optional icon inline with the title, on a white background. `accent` picks
// a logo color for both the dot and the icon: the icon is always painted
// with the dot's exact gradient so the two never drift apart. Use the "title" slot / default slot instead of the title /
// description props when the text needs inline HTML.
import CardDot from "./CardDot.astro";
import Icon from "./Icon.astro";
import { dotFill, type BrandAccent } from "../../lib/brandAccents";

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  icon?: string;
  headingTag?: "h2" | "h3" | "h4" | "h5";
  accent?: BrandAccent;
  dotColor?: string;
  iconColor?: string;
  eyebrowColor?: string;
  eyebrowStyle?: string;
  iconSize?: string;
  titleSize?: string;
  bodySize?: string;
  class?: string;
}

const {
  title,
  description,
  eyebrow,
  icon,
  headingTag: Heading = "h3",
  accent = "sky",
  dotColor = dotFill(accent),
  iconColor = dotColor,
  eyebrowColor = "text-tolemi-sky-600",
  eyebrowStyle = "text-xs font-semibold uppercase tracking-[0.15em] mb-2",
  iconSize = "w-5 h-5",
  titleSize = "text-lg",
  bodySize = "text-sm",
  class: classAttr = "",
} = Astro.props;

const hasBody = description || Astro.slots.has("default");
---

<div
  class={`relative h-full rounded-2xl p-5 md:p-6 bg-surface border border-text-muted/10 shadow-lg shadow-black/5 ${classAttr}`}
>
  <CardDot color={dotColor} size="w-4.5 h-4.5" position="top-[25px] right-6 md:top-[29px] md:right-7" />
  {eyebrow && (
    <p
      class={`font-heading lining-nums pr-10 ${eyebrowStyle} ${eyebrowColor}`}
    >
      {eyebrow}
    </p>
  )}
  <div class="flex items-center gap-2.5 min-h-7 mb-1.5 pr-10">
    {icon && <Icon name={icon} fill={iconColor} class={`${iconSize} flex-shrink-0`} />}
    <Heading class={`font-heading ${titleSize} font-bold leading-snug text-text-primary`}>
      <slot name="title">{title}</slot>
    </Heading>
  </div>
  {hasBody && (
    <p class={`${bodySize} leading-relaxed text-text-secondary`}>
      <slot>{description}</slot>
    </p>
  )}
</div>
