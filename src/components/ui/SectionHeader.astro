---
interface Props {
  eyebrow?: string;
  heading: string;
  subtitle?: string;
  eyebrowColor?: string;
  headingColor?: string;
  subtitleColor?: string;
  align?: "center" | "left";
  size?: "lg" | "md";
}
const {
  eyebrow,
  heading,
  subtitle,
  eyebrowColor = "text-tolemi-sky-600",
  headingColor = "text-text-primary",
  subtitleColor = "text-text-secondary",
  align = "center",
  size = "lg",
} = Astro.props;

const alignClass = align === "center" ? "text-center" : "";
const headingSize =
  size === "lg"
    ? "text-3xl md:text-5xl lg:text-6xl"
    : "text-2xl md:text-3xl lg:text-4xl";
const subtitleMaxW =
  align === "center" ? "max-w-2xl mx-auto" : "max-w-sm";
---

<div class={`${alignClass} mb-14 md:mb-20 reveal`}>
  {eyebrow && (
    <p class={`text-xs font-semibold tracking-widest uppercase ${eyebrowColor} mb-4`}>
      {eyebrow}
    </p>
  )}
  <h2
    class={`font-heading ${headingSize} font-bold ${headingColor} tracking-tight mb-5`}
  >
    {heading}
  </h2>
  {subtitle && (
    <p class={`text-base md:text-lg ${subtitleColor} ${subtitleMaxW} leading-relaxed`}>
      {subtitle}
    </p>
  )}
</div>
