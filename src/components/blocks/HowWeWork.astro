---
// How we work — the turnkey lifecycle as numbered cards that alternate
// left and right down the page, so the eye zigzags from one step to the next.
import SectionHeader from "../ui/SectionHeader.astro";
import InfoCard from "../ui/InfoCard.astro";
import { accentTextGradients, type BrandAccent } from "../../lib/brandAccents";

interface Step {
  title: string;
  description?: string;
  icon?: string;
}
interface Props {
  heading?: string;
  subheading?: string;
  steps?: Step[];
  closing?: string;
  accents?: BrandAccent[];
  numberColors?: string[];
}

const {
  heading = "How We Work",
  subheading,
  steps = [],
  closing,
  // corner-dot colors — the same trio as the product tabs
  accents = ["red", "yellow", "sky"],
  // each number wears its step's dot color
  numberColors = accents.map((a) => `bg-gradient-to-br ${accentTextGradients[a]} bg-clip-text text-transparent`),
} = Astro.props;
---

<section class="py-16 md:py-24 px-6 bg-surface-secondary">
  <div class="max-w-5xl mx-auto">
    <SectionHeader heading={heading} subtitle={subheading} />

    <ol class="space-y-4 md:space-y-5 reveal">
      {steps.map((step, i) => {
        const onLeft = i % 2 === 0;
        return (
          <li>
            <div class={`sm:w-[60%] ${onLeft ? "" : "sm:ml-auto"}`}>
              <InfoCard
                title={step.title}
                description={step.description}
                icon={step.icon}
                eyebrow={String(i + 1)}
                eyebrowStyle="text-4xl md:text-5xl font-bold leading-none mb-2"
                iconSize="w-7 h-7"
                eyebrowColor={numberColors[i % numberColors.length]}
                accent={accents[i % accents.length]}
              />
            </div>
          </li>
        );
      })}
    </ol>

    {closing && (
      <p class="text-center font-heading text-lg md:text-xl font-semibold text-text-primary mt-14 reveal">
        {closing}
      </p>
    )}
  </div>
</section>
