---
// A row of captioned photos of partner places. Stacks on mobile, three-up
// from `sm`. Captions fade in over each photo on hover; credits sit under it
// in small muted type.
import HoverCaption from "../ui/HoverCaption.astro";

interface Photo {
  photo?: { src: string | null; alt?: string } | null;
  caption?: string;
  credit?: string;
}
interface Props {
  photos?: Photo[];
  captionColor?: string;
  creditColor?: string;
}

const {
  photos = [],
  captionColor,
  creditColor = "text-text-muted",
} = Astro.props;

const items = photos.filter((p) => p.photo?.src);
---

{items.length > 0 && (
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6 my-10 md:my-12">
    {items.map((p) => (
      <figure>
        <div class="group relative overflow-hidden rounded-xl shadow-sm">
          <img
            src={p.photo!.src}
            alt={p.photo!.alt?.trim() || p.caption || ""}
            loading="lazy"
            decoding="async"
            class="w-full aspect-[4/3] object-cover block"
          />
          {p.caption && <HoverCaption text={p.caption} textColor={captionColor} />}
        </div>
        {p.credit && (
          <figcaption class={`mt-2.5 text-xs ${creditColor}`}>Photo: {p.credit}</figcaption>
        )}
      </figure>
    ))}
  </div>
)}
