---
// Internship program on a navy band: an optional photo on the left; eyebrow,
// heading, body, the program's tracks (each a colored dot and name that
// expands to a short description; native <details>, all start closed) and an
// outcomes line on the right.
import PhotoTile from "../ui/PhotoTile.astro";
import { dotFill, type BrandAccent } from "../../lib/brandAccents";

type Image = { src: string | null; alt?: string } | null;
interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  tracks?: { title: string; description?: string }[];
  outcomes?: string;
  photo?: Image;
  photoCaption?: string;
  background?: string;
  eyebrowColor?: string;
  headingColor?: string;
  bodyColor?: string;
  accents?: BrandAccent[];
}

const {
  eyebrow,
  heading,
  body,
  tracks = [],
  outcomes,
  photo,
  photoCaption,
  background = "bg-tolemi-navy",
  eyebrowColor = "text-tolemi-sky",
  headingColor = "text-white",
  bodyColor = "text-white/75",
  accents = ["sky", "red", "yellow"],
} = Astro.props;
---

{heading && (
  <section class={`py-20 md:py-32 px-6 ${background}`}>
    <div class={`max-w-6xl mx-auto grid gap-12 md:gap-16 items-center reveal ${photo?.src ? "md:grid-cols-2" : ""}`}>
      {photo?.src && (
        <PhotoTile src={photo.src} alt={photo.alt} caption={photoCaption} class="aspect-[4/3]" />
      )}
      <div>
        {eyebrow && (
          <p class={`font-heading text-xs font-semibold uppercase tracking-[0.15em] mb-4 ${eyebrowColor}`}>
            {eyebrow}
          </p>
        )}
        <h2 class={`font-heading text-3xl md:text-5xl font-bold tracking-tight mb-6 ${headingColor}`}>
          {heading}
        </h2>
        {body && <p class={`text-base md:text-lg leading-relaxed mb-8 ${bodyColor}`}>{body}</p>}
        {tracks.length > 0 && (
          <ul class="mb-8 divide-y divide-white/10 border-y border-white/10">
            {tracks.map((track, i) => (
              <li>
                <details class="group">
                  <summary class="flex items-center gap-3 py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                    <span class={`w-3 h-3 rounded-full flex-shrink-0 ${dotFill(accents[i % accents.length])}`} aria-hidden="true"></span>
                    <span class={`flex-1 font-heading text-lg font-bold ${headingColor}`}>{track.title}</span>
                    <svg aria-hidden="true"
                      class={`w-5 h-5 flex-shrink-0 transition-transform duration-200 group-open:rotate-45 ${headingColor}`}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </summary>
                  {track.description && (
                    <p class={`pl-6 pb-5 -mt-1 text-sm md:text-base leading-relaxed ${bodyColor}`}>{track.description}</p>
                  )}
                </details>
              </li>
            ))}
          </ul>
        )}
        {outcomes && <p class={`text-base md:text-lg leading-relaxed ${bodyColor}`}>{outcomes}</p>}
      </div>
    </div>
  </section>
)}
