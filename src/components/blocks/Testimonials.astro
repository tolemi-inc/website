---
interface TestimonialItem {
  quote: string;
  author?: string;
  role?: string;
}

interface Props {
  heading?: string;
  items?: TestimonialItem[];
}

const { heading, items = [] } = Astro.props;
---

<section class="py-32 md:py-40 px-6 bg-surface relative">
  <div class="max-w-6xl mx-auto">
    {heading && (
      <div class="text-center mb-20 md:mb-24 reveal">
        <p class="text-xs font-semibold tracking-widest uppercase text-tolemi-indigo mb-4">Testimonials</p>
        <h2 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary">{heading}</h2>
      </div>
    )}
    <div class="grid md:grid-cols-2 gap-8">
      {items.map((item, i) => (
        <blockquote class="bg-surface-secondary rounded-2xl p-8 md:p-10 border-l-4 border-l-tolemi-indigo/40 reveal" style={`transition-delay: ${i * 150}ms`}>
          <p class="text-base md:text-lg text-text-secondary italic mb-6 leading-relaxed">"{item.quote}"</p>
          <footer>
            {item.author && (
              <span class="font-heading font-semibold text-text-primary text-sm">{item.author}</span>
            )}
            {item.role && (
              <span class="text-text-muted text-xs ml-2">— {item.role}</span>
            )}
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
