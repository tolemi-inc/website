---
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  heading?: string;
  subheading?: string;
}

const { heading, subheading } = Astro.props;
---

{heading && (
  <section id="features" class="py-20 md:py-28 px-6 bg-surface">
    <div class="max-w-7xl mx-auto reveal">
      <SectionHeader
        heading={heading}
        subtitle={subheading}
      />
    </div>
  </section>
)}
