---
interface Props {
  headline: string;
  subheadline?: string;
  ctaText?: string;
  ctaLink?: string;
}

const { headline, subheadline, ctaText, ctaLink } = Astro.props;
---

<!-- Outer wrapper: tall enough for sticky scroll (100vh visible + scroll space for overlays) -->
<div id="hero-scroll-wrapper" class="relative" style="height: 175vh;">
  <section
    id="hero"
    class="sticky top-0 min-h-screen overflow-hidden bg-surface flex flex-col"
  >
    <!-- Two-column: text left, square map right -->
    <div
      class="pt-20 md:pt-24 pb-8 px-6 max-w-7xl mx-auto w-full flex-1 flex flex-col md:flex-row items-center gap-8 md:gap-12 min-h-0"
    >
      <!-- Left: headline + subheadline + CTAs -->
      <div class="md:flex-1 md:py-12 md:self-center">
        <h1
          class="font-heading text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight text-text-primary leading-[1.08] max-w-xl animate-fade-in-up"
        >
          {headline}
        </h1>
        {
          subheadline && (
            <p class="text-base md:text-lg text-text-secondary mt-5 max-w-md leading-relaxed">
              {subheadline}
            </p>
          )
        }
        <div class="flex flex-wrap gap-4 mt-8">
          {
            ctaText && (
              <a
                href={ctaLink || "#"}
                class="inline-flex items-center gap-2 bg-tolemi-dark text-white font-semibold px-7 py-3.5 rounded-full hover:shadow-lg hover:shadow-tolemi-dark/25 transition-all"
              >
                {ctaText}
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            )
          }
          <a
            href="#features"
            class="inline-flex items-center gap-2 border border-text-muted/20 text-text-primary font-medium px-7 py-3.5 rounded-full hover:bg-surface-secondary transition-all"
          >
            See how it works
          </a>
        </div>
      </div>

      <!-- Right: square map with slider overlay -->
      <div class="w-full md:w-1/2 lg:w-[55%] shrink-0">
        <div
          class="relative aspect-[4/5] rounded-2xl overflow-hidden border border-black/[0.06]"
        >
          <div id="map" class="absolute inset-0 w-full h-full"></div>
          <div
            class="absolute inset-0 pointer-events-none z-[1] mix-blend-overlay opacity-80"
            style="background: url('/grain-texture.svg'); background-size: 200px 200px;"
          >
          </div>

          <!-- Slider overlay (desktop only) -->
          <div
            id="hero-sliders"
            class="hidden md:flex absolute bottom-4 right-4 z-10 bg-white/70 backdrop-blur-xl rounded-2xl p-4 shadow-lg"
          >
            <svg
              id="slider-svg"
              viewBox="0 0 230 170"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="w-[200px] lg:w-[220px]"
            >
              <defs>
                <linearGradient id="trackSkyGrad" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#FFCB1B" stop-opacity="0.25"
                  ></stop>
                  <stop offset="100%" stop-color="#4CD5FF" stop-opacity="0.3"
                  ></stop>
                </linearGradient>
                <linearGradient
                  id="trackYellowGrad"
                  x1="0"
                  y1="0"
                  x2="1"
                  y2="0"
                >
                  <stop offset="0%" stop-color="#FF0025" stop-opacity="0.2"
                  ></stop>
                  <stop offset="100%" stop-color="#FFCB1B" stop-opacity="0.3"
                  ></stop>
                </linearGradient>
                <linearGradient id="trackRedGrad" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#FF0025" stop-opacity="0.3"
                  ></stop>
                  <stop offset="100%" stop-color="#FF0025" stop-opacity="0.08"
                  ></stop>
                </linearGradient>
              </defs>

              <!-- Labels -->
              <text
                x="8"
                y="22"
                fill="#343332"
                font-size="11"
                font-weight="600"
                font-family="Inter, sans-serif"
                opacity="0.7">Flood Zones</text
              >
              <text
                x="8"
                y="77"
                fill="#343332"
                font-size="11"
                font-weight="600"
                font-family="Inter, sans-serif"
                opacity="0.7">Transit</text
              >
              <text
                x="8"
                y="132"
                fill="#343332"
                font-size="11"
                font-weight="600"
                font-family="Inter, sans-serif"
                opacity="0.7">Heat Islands</text
              >

              <!-- Tracks (base) -->
              {
                [32, 87, 142].map((y) => (
                  <g>
                    <rect
                      x="8"
                      y={y}
                      width="214"
                      height="24"
                      rx="12"
                      fill="#e8e7e3"
                    />
                    <rect
                      x="8"
                      y={y}
                      width="214"
                      height="24"
                      rx="12"
                      fill="none"
                      stroke="#222222"
                      stroke-width="0.5"
                    />
                  </g>
                ))
              }

              <!-- Colored track overlays -->
              <g id="track-sky-fill" opacity="0">
                <rect
                  x="8"
                  y="32"
                  width="214"
                  height="24"
                  rx="12"
                  fill="url(#trackSkyGrad)"></rect>
                <rect
                  x="8"
                  y="32"
                  width="214"
                  height="24"
                  rx="12"
                  fill="none"
                  stroke="#4CD5FF"
                  stroke-opacity="0.4"
                  stroke-width="0.5"></rect>
              </g>
              <g id="track-yellow-fill" opacity="0">
                <rect
                  x="8"
                  y="87"
                  width="214"
                  height="24"
                  rx="12"
                  fill="url(#trackYellowGrad)"></rect>
                <rect
                  x="8"
                  y="87"
                  width="214"
                  height="24"
                  rx="12"
                  fill="none"
                  stroke="#FFCB1B"
                  stroke-opacity="0.4"
                  stroke-width="0.5"></rect>
              </g>
              <g id="track-red-fill" opacity="0">
                <rect
                  x="8"
                  y="142"
                  width="214"
                  height="24"
                  rx="12"
                  fill="url(#trackRedGrad)"></rect>
                <rect
                  x="8"
                  y="142"
                  width="214"
                  height="24"
                  rx="12"
                  fill="none"
                  stroke="#FF0025"
                  stroke-opacity="0.4"
                  stroke-width="0.5"></rect>
              </g>

              <!-- Dots — sky, yellow, red -->
              <circle id="dot-sky" cx="20" cy="44" r="10" fill="#4CD5FF"
              ></circle>
              <circle id="dot-yellow" cx="20" cy="99" r="10" fill="#FFCB1B"
              ></circle>
              <circle id="dot-red" cx="20" cy="154" r="10" fill="#FF0025"
              ></circle>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>
</div><!-- end hero-scroll-wrapper -->

<script>
  import "maplibre-gl/dist/maplibre-gl.css";
  import maplibregl from "maplibre-gl";
  import { Protocol } from "pmtiles";

  // --- MapLibre map initialization ---
  let map: maplibregl.Map | null = null;
  let mapStyleLoaded = false;

  try {
    const protocol = new Protocol();
    maplibregl.addProtocol("pmtiles", protocol.tile);

    const style: maplibregl.StyleSpecification = {
      version: 8,
      sources: {
        parcels: {
          type: "vector",
          url: "pmtiles:///maps/boston_parcels.pmtiles",
        },
        heat_islands: {
          type: "vector",
          url: "pmtiles:///maps/boston_heat_islands.pmtiles",
        },
        floodmap: {
          type: "vector",
          url: "pmtiles:///maps/boston_floodmap.pmtiles",
        },
        mbta: {
          type: "vector",
          url: "pmtiles:///maps/boston_mbta.pmtiles",
        },
      },
      layers: [
        {
          id: "background",
          type: "background",
          paint: { "background-color": "#f8f8f6" },
        },
        {
          id: "parcels-fill",
          type: "fill",
          source: "parcels",
          "source-layer": "boston_parcels",
          paint: {
            "fill-color": [
              "interpolate",
              ["linear"],
              ["coalesce", ["get", "shape_starea_"], 500],
              100,
              "#eeedea",
              1000,
              "#e8e7e3",
              5000,
              "#dddcd7",
              15000,
              "#d2d0cb",
              50000,
              "#c5c3bd",
            ],
            "fill-opacity": 1,
          },
        },
        {
          id: "parcels-outline",
          type: "line",
          source: "parcels",
          "source-layer": "boston_parcels",
          paint: {
            "line-color": "#222222",
            "line-width": 0.5,
          },
        },
        {
          id: "heat-islands",
          type: "fill",
          source: "heat_islands",
          "source-layer": "boston_heat_islands",
          paint: {
            "fill-color": [
              "interpolate",
              ["linear"],
              ["to-number", ["get", "gridcode"], 0],
              0,
              "#FED976",
              3,
              "#FEB24C",
              6,
              "#FD8D3C",
              9,
              "#FC4E2A",
              12,
              "#E31A1C",
              14,
              "#B10026",
            ],
            "fill-opacity": 0,
          },
        },
        {
          id: "floodmap",
          type: "fill",
          source: "floodmap",
          "source-layer": "boston_floodmap",
          paint: {
            "fill-color": "#4CD5FF",
            "fill-opacity": 0,
          },
        },
        {
          id: "mbta-lines",
          type: "line",
          source: "mbta",
          "source-layer": "boston_mbta",
          paint: {
            "line-color": "#FFCB1B",
            "line-width": 3,
            "line-opacity": 0,
          },
        },
      ],
    };

    map = new maplibregl.Map({
      container: "map",
      style,
      center: [-71.06, 42.36],
      zoom: 13,
      interactive: false,
      attributionControl: false,
    });

    map.on("style.load", () => {
      mapStyleLoaded = true;
    });
    map.on("error", (e) => {
      console.warn("MapLibre error:", e.error);
    });
  } catch (e) {
    console.warn("Map init failed:", e);
  }

  // --- Scroll-driven animation (runs regardless of map) ---
  const wrapper = document.getElementById("hero-scroll-wrapper");
  const sliderSvg = document.getElementById(
    "slider-svg",
  ) as unknown as SVGSVGElement;
  const dotSky = document.getElementById(
    "dot-sky",
  ) as unknown as SVGCircleElement;
  const dotYellow = document.getElementById(
    "dot-yellow",
  ) as unknown as SVGCircleElement;
  const dotRed = document.getElementById(
    "dot-red",
  ) as unknown as SVGCircleElement;

  const trackSkyFill = document.getElementById("track-sky-fill");
  const trackYellowFill = document.getElementById("track-yellow-fill");
  const trackRedFill = document.getElementById("track-red-fill");

  const trackLeft = 20;
  const trackRight = 210;

  // Current positions (what's rendered)
  let skyX = trackLeft;
  let yellowX = trackLeft;
  let redX = trackLeft;

  // Target positions (what we lerp toward)
  let targetSkyX = trackLeft;
  let targetYellowX = trackLeft;
  let targetRedX = trackLeft;

  // Track which dots the user has manually dragged (skip scroll override)
  let manualSky = false;
  let manualYellow = false;
  let manualRed = false;

  function clamp(v: number, min: number, max: number) {
    return Math.max(min, Math.min(max, v));
  }

  function dotProgress(currentX: number): number {
    return clamp((currentX - trackLeft) / (trackRight - trackLeft), 0, 1);
  }

  function updateDots() {
    if (dotSky) dotSky.setAttribute("cx", String(skyX));
    if (dotYellow) dotYellow.setAttribute("cx", String(yellowX));
    if (dotRed) dotRed.setAttribute("cx", String(redX));
  }

  function updateOverlays() {
    const skyOpacity = dotProgress(skyX);
    const yellowOpacity = dotProgress(yellowX);
    const redOpacity = dotProgress(redX);

    // Map overlay layers — order: blue (floodplains), yellow (transit), red (heat)
    if (map && mapStyleLoaded) {
      try {
        map.setPaintProperty("floodmap", "fill-opacity", skyOpacity * 0.5);
        map.setPaintProperty("mbta-lines", "line-opacity", yellowOpacity);
        map.setPaintProperty("heat-islands", "fill-opacity", redOpacity * 0.6);
      } catch (_) {}
    }

    // Colored track fills
    if (trackSkyFill) trackSkyFill.setAttribute("opacity", String(skyOpacity));
    if (trackYellowFill)
      trackYellowFill.setAttribute("opacity", String(yellowOpacity));
    if (trackRedFill) trackRedFill.setAttribute("opacity", String(redOpacity));
  }

  const lerpSpeed = 0.12;

  function lerp(a: number, b: number, t: number) {
    return a + (b - a) * t;
  }

  function onScroll() {
    if (!wrapper) return;
    const rect = wrapper.getBoundingClientRect();
    const viewH = window.innerHeight;
    const scrolled = clamp(-rect.top / (rect.height - viewH), 0, 1);

    // Order: sky first, yellow second, red third
    const skyProgress = clamp(scrolled / 0.33, 0, 1);
    const yellowProgress = clamp((scrolled - 0.33) / 0.33, 0, 1);
    const redProgress = clamp((scrolled - 0.66) / 0.34, 0, 1);

    if (!manualSky)
      targetSkyX = trackLeft + skyProgress * (trackRight - trackLeft);
    if (!manualYellow)
      targetYellowX = trackLeft + yellowProgress * (trackRight - trackLeft);
    if (!manualRed)
      targetRedX = trackLeft + redProgress * (trackRight - trackLeft);
  }

  function animate() {
    skyX = lerp(skyX, targetSkyX, lerpSpeed);
    yellowX = lerp(yellowX, targetYellowX, lerpSpeed);
    redX = lerp(redX, targetRedX, lerpSpeed);

    updateDots();
    updateOverlays();
    requestAnimationFrame(animate);
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  requestAnimationFrame(animate);

  // --- Drag interaction ---
  let activeDot: "sky" | "yellow" | "red" | null = null;

  function svgPoint(evt: PointerEvent): DOMPoint {
    const pt = sliderSvg.createSVGPoint();
    pt.x = evt.clientX;
    pt.y = evt.clientY;
    return pt.matrixTransform(sliderSvg.getScreenCTM()!.inverse());
  }

  function onPointerDown(evt: PointerEvent) {
    if (!sliderSvg) return;
    const pt = svgPoint(evt);

    const dots: [string, number, number][] = [
      ["sky", skyX, 44],
      ["yellow", yellowX, 99],
      ["red", redX, 154],
    ];

    for (const [name, cx, cy] of dots) {
      const dx = pt.x - cx;
      const dy = pt.y - cy;
      if (Math.sqrt(dx * dx + dy * dy) < 22) {
        activeDot = name as "sky" | "yellow" | "red";
        sliderSvg.style.cursor = "grabbing";
        (evt.target as Element)?.setPointerCapture?.(evt.pointerId);
        evt.preventDefault();
        return;
      }
    }
  }

  function onPointerMove(evt: PointerEvent) {
    if (!activeDot || !sliderSvg) return;
    const pt = svgPoint(evt);
    const newX = clamp(pt.x, trackLeft, trackRight);

    // Set both current and target so animate loop doesn't fight us
    if (activeDot === "sky") {
      skyX = newX;
      targetSkyX = newX;
      manualSky = true;
    } else if (activeDot === "yellow") {
      yellowX = newX;
      targetYellowX = newX;
      manualYellow = true;
    } else {
      redX = newX;
      targetRedX = newX;
      manualRed = true;
    }

    updateDots();
    updateOverlays();
  }

  function onPointerUp() {
    if (sliderSvg) sliderSvg.style.cursor = "grab";
    activeDot = null;
  }

  if (sliderSvg) {
    sliderSvg.addEventListener("pointerdown", onPointerDown);
    sliderSvg.addEventListener("pointermove", onPointerMove);
    sliderSvg.addEventListener("pointerup", onPointerUp);
    sliderSvg.addEventListener("pointerleave", onPointerUp);
    sliderSvg.style.cursor = "grab";
  }

  // Initial state
  onScroll();
  updateDots();
  updateOverlays();
</script>
