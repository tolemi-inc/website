---
import CardDot from "../ui/CardDot.astro";
import AccentLine from "../ui/AccentLine.astro";

interface LearnMoreItem {
  title: string;
  slug: string;
  subheadline?: string;
  basePath: string;
}

interface Props {
  heading?: string;
  items: LearnMoreItem[];
}

const { heading = "Learn More", items } = Astro.props;
---

{items.length > 0 && (
  <section class="py-16 md:py-20 px-6 bg-surface-muted/50">
    <div class="max-w-6xl mx-auto reveal">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-10 text-center">{heading}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((item) => (
          <a
            href={`${item.basePath}/${item.slug}`}
            class="group relative flex flex-col bg-white rounded-3xl border border-black/[0.08] p-8 hover:shadow-lg hover:shadow-black/[0.06] transition-all duration-300"
          >
            <CardDot />
            <h3 class="font-heading text-xl font-semibold text-text-primary mb-3 pr-12 group-hover:text-tolemi-sky-600 transition-colors">
              {item.title}
            </h3>
            {item.subheadline && (
              <p class="text-text-secondary text-sm leading-relaxed">{item.subheadline}</p>
            )}
            <div class="mt-auto pt-6">
              <AccentLine color="bg-tolemi-dark" width="w-full" thickness="h-0.5" class="mb-4" />
              <span class="flex items-center justify-between text-sm font-semibold text-text-primary">
                Learn more
                <svg aria-hidden="true" class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
