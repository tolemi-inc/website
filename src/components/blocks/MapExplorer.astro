<script>
  const mapExplorer = document.getElementById("map-explorer");
  const mapSvg = document.getElementById("map-svg");
  const highlights = [1, 2, 3, 4].map((i) =>
    document.getElementById(`hl-${i}`),
  );
  const infoCards = [1, 2, 3, 4].map((i) =>
    document.getElementById(`info-card-${i}`),
  );

  function onMapScroll() {
    if (!mapExplorer || !mapSvg) return;

    const rect = mapExplorer.getBoundingClientRect();
    const scrollH = rect.height - window.innerHeight;
    const p = Math.max(0, Math.min(1, -rect.top / scrollH));

    // Gentle zoom on map
    const zoom = Math.min(1, p / 0.15);
    const scale = 1 + zoom * 0.5;
    mapSvg.style.transform = `scale(${scale})`;
    mapSvg.style.transformOrigin = "50% 50%";

    // Reveal highlights and info cards sequentially
    const count = 4;
    const start = 0.1,
      end = 0.9;
    const slice = (end - start) / count;

    let activeIndex = -1;
    for (let i = 0; i < count; i++) {
      const iStart = start + i * slice;
      const iEnd = iStart + slice * 0.5;
      const fadeIn = Math.max(0, Math.min(1, (p - iStart) / (iEnd - iStart)));

      if (highlights[i]) highlights[i]!.setAttribute("opacity", String(fadeIn));
      if (fadeIn > 0.5) activeIndex = i;
    }

    // Brighten active card, dim others
    for (let i = 0; i < count; i++) {
      if (infoCards[i]) {
        const el = infoCards[i] as HTMLElement;
        el.style.opacity = i === activeIndex ? "1" : "0.4";
        el.style.transform = i === activeIndex ? "scale(1.02)" : "scale(1)";
      }
    }
  }

  window.addEventListener("scroll", onMapScroll, { passive: true });
  onMapScroll();
</script>
