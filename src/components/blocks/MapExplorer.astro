  {
    parcel: { x: 664, y: 208, w: 68, h: 50 },
    card: { x: 660, y: 262, w: 76, h: 36 },
    dot: { cx: 671, cy: 274 },
    labelPos: { x: 678, y: 278 },
    detailPos: { x: 668, y: 292 },
    defaultColor: "sky",
  },
  {
    parcel: { x: 588, y: 328, w: 72, h: 104 },
    card: { x: 592, y: 370, w: 64, h: 36 },
    dot: { cx: 603, cy: 382 },
    labelPos: { x: 610, y: 386 },
    detailPos: { x: 600, y: 400 },
    defaultColor: "red",
  },
  {
    parcel: { x: 428, y: 448, w: 144, h: 50 },
    card: { x: 460, y: 502, w: 78, h: 36 },
    dot: { cx: 471, cy: 514 },
    labelPos: { x: 478, y: 518 },
    detailPos: { x: 468, y: 532 },
    defaultColor: "sky",
  },
];

// ─── Single color palette: edit here to change both map highlights AND cards ───
const palette: Record<string, {
  // SVG map highlight colors (hex)
  fill: string;
  stroke: string;
  labelFill: string;
  glowColor: string;
  // Inner gradient shared by SVG highlights and HTML cards
  // [from, to] hex stops — used as a linearGradient in SVG and CSS background on cards
  gradient: [string, string];
  // HTML card classes (Tailwind)
  dot: string;
  border: string;
  bg: string;
  stat: string;
}> = {
  yellow: {
    fill: "#FFCB1B",   stroke: "#FFCB1B",   labelFill: "#b8920a", glowColor: "#FFCB1B",
    gradient: ["#FFCB1B", "#FFE17A"],
    dot: "bg-tolemi-yellow",  border: "border-tolemi-yellow/20",  bg: "bg-tolemi-yellow/5",  stat: "text-tolemi-dark",
  },
  sky: {
    fill: "#4CD5FF",   stroke: "#4CD5FF",   labelFill: "#0e9bc4", glowColor: "#4CD5FF",
    gradient: ["#4CD5FF", "#A0EAFF"],
    dot: "bg-tolemi-sky",     border: "border-tolemi-sky/20",     bg: "bg-tolemi-sky/5",     stat: "text-tolemi-sky-600",
  },
  red: {
    fill: "#FF0025",   stroke: "#FF0025",   labelFill: "#dd0020", glowColor: "#FF0025",
    gradient: ["#FF0025", "#FF6680"],
    dot: "bg-tolemi-red",     border: "border-tolemi-red/20",     bg: "bg-tolemi-red/5",     stat: "text-tolemi-red",
  },
};
// Aliases — point these at an existing palette entry
palette.green = palette.sky;
palette.indigo = palette.sky;
palette.coral = palette.red;

// Card descriptions — color comes from the JSON card's `color` field via palette
const cardDescriptions = [
  {
    title: "Building Permits",
    stat: "12 new this week",
    description: "Track every permit application, approval, and inspection across the city. Spot development trends before they hit the market.",
  },
  {
    title: "Zoning Changes",
    stat: "R-1 → Mixed Use",
    description: "Monitor rezoning proposals, variances, and overlay districts. See how land use is shifting and what it means for development potential.",
  },
  {
    title: "Code Violations",
    stat: "Overdue 14 days",
    description: "Surface code enforcement actions, open violations, and compliance timelines. Identify properties with repeated issues and assess risk.",
  },
  {
    title: "Assessments",
    stat: "$425k · +8.2% YoY",
    description: "Access assessment history, value trends, and comparable properties. Understand how values are changing at the parcel level.",
  },
];
