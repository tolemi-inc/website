---
interface Props {
  sources: string[];
  cardClass?: string;
  layout?: "vertical" | "grid";
  id?: string;
}
const {
  sources,
  cardClass = "w-[110px] h-[44px]",
  layout = "vertical",
  id,
} = Astro.props;
---

<div class="flex flex-col items-center flex-shrink-0">
  <div
    class={`df-source-container transition-opacity duration-500 ${layout === "grid" ? "grid grid-cols-3 gap-1.5" : "flex flex-col gap-1"}`}
    id={id}
  >
    {
      sources.map((file) => (
        <div
          class={`df-source ${cardClass} rounded bg-surface border border-text-muted/10 overflow-hidden flex items-center justify-center p-1.5`}
          style="background: white;"
        >
          <img
            src={`/data_sources/${file}`}
            alt=""
            class="max-w-full max-h-full object-contain"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
  <h3
    class="font-heading text-[10px] font-bold text-text-muted uppercase tracking-widest mt-4"
  >
    Data Sources
  </h3>
</div>
