---
// Registration spotlight — "Your property registry, empowered by your data."
// Teaser bullets only: enough to want a demo, not the whole playbook.
import DemoButton from "../../ui/DemoButton.astro";

interface Bullet {
  title: string;
  description?: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  bullets?: Bullet[];
  imagePath?: string;
  imageAlt?: string;
  ctaText?: string;
  ctaLink?: string;
  eyebrowColor?: string;
  accentGradient?: string;
}

const {
  eyebrow,
  heading,
  body,
  bullets = [],
  imagePath,
  imageAlt,
  ctaText,
  ctaLink,
  eyebrowColor = "text-tolemi-sky-400",
  accentGradient = "from-tolemi-indigo-500 via-tolemi-sky to-tolemi-green",
} = Astro.props;
---

<section id="registration" class="relative py-24 md:py-32 px-6 overflow-hidden bg-tolemi-navy scroll-mt-20">
  <!-- Accent glows -->
  <div class="absolute top-0 left-1/4 w-1/2 h-1/2 bg-tolemi-indigo/15 blur-[140px]"></div>
  <div class="absolute bottom-0 right-0 w-1/3 h-1/2 bg-tolemi-sky/10 blur-[120px]"></div>

  <div class="relative z-10 max-w-6xl mx-auto">
    <div class={`grid gap-12 md:gap-16 items-center ${imagePath ? "md:grid-cols-2" : "max-w-3xl"}`}>
      <div class="reveal">
        {eyebrow && (
          <p class={`font-heading text-sm font-semibold uppercase tracking-[0.2em] ${eyebrowColor} mb-4`}>
            {eyebrow}
          </p>
        )}
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white tracking-tight mb-6">
          {heading}
        </h2>
        {body && (
          <p class="text-base md:text-lg text-white/70 leading-relaxed mb-10">{body}</p>
        )}

        <div class="flex flex-col gap-6 mb-10">
          {bullets.map((bullet) => (
            <div class="flex gap-4">
              <div class={`w-1 rounded-full bg-gradient-to-b ${accentGradient} flex-shrink-0`}></div>
              <div>
                <h3 class="font-heading font-bold text-white mb-1">{bullet.title}</h3>
                {bullet.description && (
                  <p class="text-sm md:text-base text-white/60 leading-relaxed">{bullet.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        {ctaText && <DemoButton href={ctaLink || "#"} arrow>{ctaText}</DemoButton>}
      </div>

      {imagePath && (
        <div class="reveal">
          <img
            src={imagePath}
            alt={imageAlt || ""}
            class="w-full rounded-xl shadow-2xl border border-white/10"
            loading="lazy"
          />
        </div>
      )}
    </div>
  </div>
</section>
