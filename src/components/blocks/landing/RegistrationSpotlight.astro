---
// Registration spotlight — "Your property registry, empowered by your data."
// Teaser bullets only: enough to want a demo, not the whole playbook.
import DemoButton from "../../ui/DemoButton.astro";

interface Bullet {
  title: string;
  description?: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  bullets?: Bullet[];
  imagePath?: string;
  imageAlt?: string;
  ctaText?: string;
  ctaLink?: string;
  eyebrowColor?: string;
  bulletGradients?: string[];
}

const {
  eyebrow,
  heading,
  body,
  bullets = [],
  imagePath,
  imageAlt,
  ctaText,
  ctaLink,
  eyebrowColor = "text-tolemi-sky-600",
  bulletGradients = [
    "from-tolemi-indigo-500 to-tolemi-sky-500",
    "from-tolemi-sky-500 to-tolemi-green-500",
    "from-tolemi-coral-400 to-tolemi-yellow-400",
  ],
} = Astro.props;
---

<section id="registration" class="relative py-24 md:py-32 px-6 overflow-hidden bg-surface-secondary">
  <div class="relative z-10 max-w-6xl mx-auto">
    <div class={`grid gap-12 md:gap-16 items-center ${imagePath ? "md:grid-cols-2" : "max-w-3xl"}`}>
      <div class="reveal">
        {eyebrow && (
          <p class={`font-heading text-sm font-semibold uppercase tracking-[0.2em] ${eyebrowColor} mb-4`}>
            {eyebrow}
          </p>
        )}
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-6">
          {heading}
        </h2>
        {body && (
          <p class="text-base md:text-lg text-text-secondary leading-relaxed mb-10">{body}</p>
        )}

        <div class="flex flex-col gap-6 mb-10">
          {bullets.map((bullet, i) => (
            <div class="flex gap-4">
              <div class={`w-1 rounded-full bg-gradient-to-b ${bulletGradients[i % bulletGradients.length]} flex-shrink-0`}></div>
              <div>
                <h3 class="font-heading font-bold text-text-primary mb-1">{bullet.title}</h3>
                {bullet.description && (
                  <p class="text-sm md:text-base text-text-secondary leading-relaxed">{bullet.description}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        {ctaText && (
          <div class="text-center md:text-left">
            <DemoButton href={ctaLink || "#"} arrow>{ctaText}</DemoButton>
          </div>
        )}
      </div>

      {imagePath && (
        <div class="reveal order-first md:order-none">
          <img
            src={imagePath}
            alt={imageAlt || ""}
            class="w-full rounded-xl shadow-xl border border-text-muted/10"
            loading="lazy"
          />
        </div>
      )}
    </div>
  </div>
</section>
