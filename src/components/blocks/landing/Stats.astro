---
import StatCard from "../../ui/StatCard.tsx";

interface StatItem {
  value: string;
  label: string;
}

interface Props {
  heading?: string;
  items?: StatItem[];
}

const { heading, items = [] } = Astro.props;
---

<section class="py-32 md:py-40 px-6 relative overflow-hidden bg-surface">
  <div class="max-w-7xl mx-auto relative z-10">
    {heading && (
      <div class="text-center mb-20 md:mb-24 reveal">
        <h2 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary">{heading}</h2>
      </div>
    )}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8 max-w-4xl mx-auto">
      {items.map((item, i) => (
        <StatCard value={item.value} label={item.label} index={i} />
      ))}
    </div>
  </div>
</section>
