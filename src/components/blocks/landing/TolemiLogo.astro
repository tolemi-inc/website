---
interface Props {
  class?: string;
}
const { class: className = "w-16 h-16" } = Astro.props;
---

<div class="flex flex-col items-center flex-shrink-0">
  <div class="rounded-2xl border border-text-muted/10 bg-surface p-4 shadow-sm">
    <img
      src="/logos/dark_gradient.svg"
      alt="Tolemi"
      class:list={[className, "dark:hidden object-contain"]}
    />
    <img
      src="/logos/light_gradient.svg"
      alt="Tolemi"
      class:list={[className, "hidden dark:block object-contain"]}
    />
  </div>
  <h3
    class="font-heading text-[10px] font-bold text-text-muted uppercase tracking-widest mt-4"
  >
    Tolemi
  </h3>
</div>
