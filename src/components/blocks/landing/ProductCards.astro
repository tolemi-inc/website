---
interface Props {
  variant?: "desktop" | "mobile";
}
const { variant = "desktop" } = Astro.props;

const isDesktop = variant === "desktop";
const linkClass = isDesktop
  ? "flex items-center gap-2.5 p-2.5 rounded-xl bg-surface border border-text-muted/10 shadow-sm hover:shadow-md transition-all duration-200 group"
  : "flex items-center gap-3 p-3 rounded-xl bg-surface border border-text-muted/10 shadow-sm";
const iconBoxSize = isDesktop ? "w-7 h-7" : "w-8 h-8";
const iconSize = isDesktop ? "w-3.5 h-3.5" : "w-4 h-4";
const titleClass = isDesktop
  ? "font-heading text-xs font-bold text-text-primary"
  : "font-heading text-xs font-bold text-text-primary";
const wrapperClass = isDesktop ? "space-y-2 w-[200px]" : "space-y-2 w-full max-w-[260px]";

const products = [
  {
    href: "/products/building-blocks",
    name: "BuildingBlocks",
    desc: "Property intelligence",
    color: "tolemi-sky",
    hoverColor: isDesktop ? "hover:border-tolemi-sky/30" : "",
    iconColor: "text-tolemi-sky-600",
    bgColor: "bg-tolemi-sky/10",
    hoverTextColor: isDesktop ? "group-hover:text-tolemi-sky-600" : "",
    icon: "M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z",
  },
  {
    href: "/products/slate",
    name: "Slate",
    desc: "Code enforcement",
    color: "tolemi-red",
    hoverColor: isDesktop ? "hover:border-tolemi-red/30" : "",
    iconColor: "text-tolemi-red",
    bgColor: "bg-tolemi-red/10",
    hoverTextColor: isDesktop ? "group-hover:text-tolemi-red" : "",
    icon: "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z",
  },
  {
    href: "/products/publicity",
    name: "Publicity",
    desc: "Community engagement",
    color: "tolemi-green",
    hoverColor: isDesktop ? "hover:border-tolemi-green/30" : "",
    iconColor: "text-tolemi-green",
    bgColor: "bg-tolemi-green/10",
    hoverTextColor: isDesktop ? "group-hover:text-tolemi-green" : "",
    icon: "M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z",
  },
];
---

<div class="flex flex-col items-center flex-shrink-0">
  <div class={wrapperClass}>
    {
      products.map((p) => (
        <a
          href={p.href}
          class={`${linkClass} ${p.hoverColor}`}
        >
          <div
            class={`${iconBoxSize} rounded-lg ${p.bgColor} flex items-center justify-center flex-shrink-0`}
          >
            <svg
              class={`${iconSize} ${p.iconColor}`}
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d={p.icon}
              />
            </svg>
          </div>
          <div>
            <div class={`${titleClass} ${p.hoverTextColor} transition-colors`}>
              {p.name}
            </div>
            <div class="text-[10px] text-text-muted">
              {p.desc}
            </div>
          </div>
        </a>
      ))
    }
  </div>
  <h3
    class="font-heading text-[10px] font-bold text-text-muted uppercase tracking-widest mt-4"
  >
    Products
  </h3>
</div>
