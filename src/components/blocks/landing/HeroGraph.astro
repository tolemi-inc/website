---
// HeroGraph — the landing hero: the mission statement beside a live ownership graph.
// Fictional demo data lives in the inline script's NODES constant; all real copy
// (headline, subheadline, CTA) comes from Keystatic via props.
import DemoButton from "../../ui/DemoButton.astro";
import AccentPeriod from "../../ui/AccentPeriod.astro";
import { accentGradients } from "../../../lib/brandAccents";
import { iconMask } from "../../../lib/icons";

interface Props {
  headline: string;
  subheadline?: string;
  ctaText?: string;
  ctaLink?: string;
  periodColor?: string;
  highlightColor?: string;
  listColors?: string[];
  listIcons?: string[];
}

const {
  headline,
  subheadline,
  ctaText,
  ctaLink,
  periodColor = `bg-gradient-to-br ${accentGradients.red} bg-clip-text text-transparent`,
  // full class string for a lone **phrase**; add bg-clip-text etc. for gradient text
  highlightColor = "text-text-primary",
  // the logo's dots, cool to warm: sky, yellow, orange (yellow into red), red.
  // Sky starts a step deeper than the rest; at 400 it glares next to the warms.
  listColors = [
    "bg-gradient-to-r from-tolemi-sky-500 to-tolemi-sky-600",
    "bg-gradient-to-r from-tolemi-yellow-400 to-tolemi-yellow-500",
    "bg-gradient-to-r from-tolemi-yellow-500 to-tolemi-red-400",
    "bg-gradient-to-r from-tolemi-red-400 to-tolemi-red-500",
  ],
  // one icon per list line, painted with these gradients (names from lib/icons.ts)
  listIcons = ["shield", "building", "key", "flower"],
} = Astro.props;

// the headline may mark key phrases with **double asterisks**; they render
// extra-bold in the highlight color. A series of them, with or without
// commas ("**a**, **b**, and **c**" or "**a** **b** **c**"), stacks one per line, each led by its own icon
// painted in that line's list color. A line never wraps; on a narrow
// column the whole headline shrinks to fit instead (see the h1 size).
const headlineHtml = headline
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/\s*\*\*[^*]+?\*\*(?:,?\s*(?:and\s+)?\*\*[^*]+?\*\*)+/g, (series) => {
    let i = 0;
    return series.replace(/\s*((?:and\s+)?)\*\*(.+?)\*\*/g, (_, and, phrase) => {
      const color = listColors[i % listColors.length];
      const mask = iconMask(listIcons[i++ % listIcons.length]);
      const icon = mask
        ? `<span aria-hidden="true" class="inline-block w-[0.8em] h-[0.8em] mr-[0.35em] align-[-0.05em] ${color}" style='-webkit-mask: ${mask} center / contain no-repeat; mask: ${mask} center / contain no-repeat;'></span>`
        : "";
      return `<br><span class="hero-line">${icon}${and}<strong class="font-bold ${highlightColor}">${phrase}</strong></span>`;
    });
  })
  .replace(/\*\*(.+?)\*\*/g, `<strong class="font-bold ${highlightColor}">$1</strong>`);
---

<section class="relative overflow-hidden pt-24 lg:pt-28 pb-12 px-6 bg-surface">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 items-center gap-10 lg:gap-14">
    {/* the mission, left */}
    <div class="w-full text-left @container">
      <h1 class="font-heading text-[length:min(clamp(1.5rem,6.5vw,2.5rem),6.4cqi)] lg:text-[length:min(clamp(2rem,3vw,2.875rem),6.4cqi)] font-bold text-text-primary tracking-tight leading-[1.15] mb-6 reveal">
        <AccentPeriod text={headlineHtml} color={periodColor} html />
      </h1>
      {subheadline && (
        <p class="max-w-2xl text-base md:text-lg text-text-secondary leading-relaxed mb-9 reveal">
          {subheadline}
        </p>
      )}
      {ctaText && (
        <div class="reveal">
          <DemoButton href={ctaLink || "#"} size="lg" arrow>{ctaText}</DemoButton>
        </div>
      )}
    </div>
    {/* the graph, right */}
    <div class="gstage w-full max-w-2xl mx-auto" id="herograph-stage">
      <svg id="herograph-svg" viewBox="0 0 560 560"
        aria-label="Scattered facts spring into an ownership graph; labeled identifiers — a shared phone number and mailing address — draw three owners together into one portfolio"
      ></svg>
      <div class="tslider">
        <span class="tsl-label">Data silos</span>
        <div class="tsl-track" id="herograph-track" role="slider" tabindex="0"
          aria-label="From data silos to Tolemi insights"
          aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="tsl-veil" id="herograph-veil"></div>
          <div class="tsl-knob" id="herograph-knob"></div>
        </div>
        <span class="tsl-label">Tolemi insights</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* each headline list line stays on one line; the whole h1 shrinks with the
     column (6.4cqi) so the list never wraps and matches the lead sentence */
  .hero-line { white-space: nowrap; }

  .gstage { position: relative; width: 100%; }
  #herograph-svg { cursor: pointer; display: block; width: 100%; height: auto; }
  #herograph-svg .gel { transition: opacity 0.55s ease; }
  #herograph-svg .gel.dim { opacity: 0.14 !important; }
  #herograph-svg text { font-family: var(--font-sans); pointer-events: none; }
  #herograph-svg .hg-label { fill: #343332; font-size: 12px; font-weight: 600; text-anchor: middle; }
  #herograph-svg .hg-sub { fill: #8b909a; font-size: 10.5px; text-anchor: middle; }
  #herograph-svg .hg-glyph { fill: #0a5568; font-weight: 700; text-anchor: middle; }
  #herograph-svg .hg-own { stroke-width: 2; stroke-opacity: 0.6; stroke-linecap: round; }
  #herograph-svg .hg-link { stroke-width: 2.8; stroke-dasharray: 6 5; stroke-linecap: round; }
  #herograph-svg .hg-node { cursor: pointer; }
  #herograph-svg .hg-node:focus { outline: none; }
  #herograph-svg .hg-node:focus-visible circle { stroke: #343332; stroke-width: 2; }

  /* profile cards */
  .gcard {
    position: absolute; left: 0; top: 0; display: flex; flex-direction: column;
    background-color: #ffffff; border: 1px solid #e4e6ee; border-radius: 1em;
    /* a whisper of the card's tone at the top, fading to white */
    background-image: linear-gradient(180deg, var(--wash, #ffffff), #ffffff 60%);
    border-left: 0.3em solid var(--acc, #e4e6ee);
    padding: 0.65em 1em; cursor: pointer; will-change: transform;
    box-shadow: 0 10px 22px -14px var(--glow, rgba(52, 51, 50, 0.35));
    transition: opacity 0.5s, border-color 0.4s, background-color 0.4s, box-shadow 0.4s;
  }
  .gcard.flag { border-style: dashed; border-left-style: solid; border-color: #FFCB1B; }
  .gcard.ghost { border-color: #c8ccd6; border-style: dashed; border-left-style: solid; }
  .gcard.dim { opacity: 0.14; }
  /* before every cell has landed, only the landed cells show — no box yet */
  .gcard.shell { background-color: transparent; background-image: none; border-color: transparent; box-shadow: none; }
  .gcard.shell .ic, .gcard.shell .lb { opacity: 0; }
  .gcard.shell .gc-table { border-top-color: transparent; }
  .gcard:focus-visible { outline: 2px solid #0e9bc4; outline-offset: 2px; }
  .gcard .ic {
    width: 2em; height: 2em; border-radius: 50%; flex: none;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.4s, opacity 0.4s;
  }
  .gcard .gc-head { display: flex; align-items: center; gap: 0.8em; }
  /* names and pills share one look wherever they sit, so a cell that leaves
     its table arrives in a card as the same object */
  .gstage .gnm { font: 700 1em/1.3 var(--font-sans); color: #26272b; white-space: nowrap; }
  .gstage .pill {
    display: inline-block; font: 600 0.95em/1.5 var(--font-sans); color: #33353a;
    white-space: nowrap; padding: 0 0.7em; border-radius: 999px; background: #f2f3f6;
  }
  .gstage .pill.t-reg { background: #d4f4ff; color: #0a7a9e; }
  /* identifiers and "Linked" are what tie owners together — they wear the
     link lines' sky */
  .gstage .pill.t-id {
    background: linear-gradient(90deg, #eefbff, #d4f4ff); color: #0a7a9e;
    box-shadow: inset 0 0 0 1px rgba(14, 155, 196, 0.28);
  }
  .gstage .pill.t-use { background: #f0f0ee; color: #55565a; }
  .gstage .pill.warn { background: #fff0c2; color: #C2410C; }
  .gstage .pill.t-alert { background: #ffe0e4; color: #b3001a; }

  .gcard .nm { font-size: 1.15em; min-width: 9em; opacity: 0; }
  .gcard .nm.in { opacity: 1; }
  .gcard .gc-table {
    display: flex; flex-direction: column; gap: 0.3em;
    border-top: 1px solid #eef0f4; transition: border-color 0.4s; margin-top: 0.5em; padding-top: 0.5em; min-width: 11.5em;
  }
  .gcard .gc-row { display: flex; justify-content: space-between; gap: 1.6em; align-items: baseline; }
  .gcard .gc-row .lb {
    font: 600 0.8em/1.4 var(--font-sans); letter-spacing: 0.06em; text-transform: uppercase;
    color: #9aa0ab; white-space: nowrap; transition: opacity 0.4s;
  }
  .gcard .gc-row .vl { min-height: 1.3em; opacity: 0; transform: translateX(-4px);
    transition: opacity 0.35s, transform 0.35s; }
  .gcard .gc-row .vl.src { transform: none; transition: none; }
  .gcard .gc-row .vl.in { opacity: 1; transform: none; }

  /* a cell in flight: the real cell hides while this stands in for it */
  .gfly {
    position: absolute; left: 0; top: 0; z-index: 3; pointer-events: none;
    opacity: 0; will-change: transform;
  }

  /* the disjointed source tables — where every record starts */
  .gsrc {
    position: absolute; left: 0; top: 0; z-index: 1; background: #ffffff; font-size: 1.05em;
    border: 1px solid #e4e6ee; border-top: 0.32em solid var(--tc, #d5d8de);
    border-radius: 0.8em; padding: 0 0 0.35em; overflow: hidden;
    box-shadow: 0 12px 26px -14px rgba(52, 51, 50, 0.32);
    pointer-events: none;
  }
  .gsrc-title {
    display: flex; align-items: center; gap: 0.55em;
    font: 700 0.85em/1.3 var(--font-sans); letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--tink, #9aa0ab); background: var(--tbg, #f6f6f4);
    padding: 0.7em 1.4em 0.6em 1.2em;
  }
  .gsrc-grid { display: grid; grid-template-columns: auto auto; column-gap: 1.6em; padding: 0 1.2em; }
  .gsrc-th {
    font: 600 0.72em/1 var(--font-sans); letter-spacing: 0.08em; text-transform: uppercase;
    color: #9aa0ab; padding: 0.9em 0 0.6em; border-bottom: 1px solid #e4e6ee;
  }
  .gsrc-td {
    display: flex; align-items: center; min-height: 2em;
    border-bottom: 1px solid #f0f1f4;
  }
  .gsrc-td.last { border-bottom: 0; }
  .gcard { z-index: 2; }


  /* the Tolemi slider — a soft brand rainbow; vividness follows the knob */
  .tslider { display: flex; align-items: center; gap: 16px; margin-top: 14px; padding: 0 2px; }
  .tsl-label {
    font: 600 10px/1.3 var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase;
    color: #55565a; white-space: nowrap;
  }
  .tsl-track {
    position: relative; flex: 1; height: 10px; border-radius: 999px; cursor: pointer;
    touch-action: none;
    background: linear-gradient(90deg, #ff8091, #ffdb70, #7fd194, #7fdfff, #4CD5FF);
    box-shadow: inset 0 1px 2px rgba(52, 51, 50, 0.18);
  }
  /* invisible halo so the 10px track meets the ~44px touch-target minimum */
  .tsl-track::before {
    content: ""; position: absolute; left: 0; right: 0; top: -17px; bottom: -17px;
  }
  .tsl-veil {
    position: absolute; top: 0; bottom: 0; right: 0; left: 0; border-radius: 999px;
    background: rgba(255, 255, 255, 0.68); pointer-events: none;
  }
  .tsl-track:focus-visible { outline: 2px solid #343332; outline-offset: 4px; }
  .tsl-knob {
    position: absolute; top: 50%; left: 0%; width: 20px; height: 20px; border-radius: 50%;
    transform: translate(-50%, -50%); background: #343332;
    box-shadow: 0 2px 8px rgba(52, 51, 50, 0.4);
    pointer-events: none; transition: transform 0.2s;
  }
  .tslider.dragging .tsl-knob { transform: translate(-50%, -50%) scale(1.18); }
  @media (max-width: 640px) { .tsl-label { font-size: 8.5px; } }

</style>

<script>
  const NS = "http://www.w3.org/2000/svg";
  // deterministic pseudo-random (0-99): same scatter every load, no Math.random
  const hash = (i: number) => ((i * 2654435761) >>> 0) % 100;
  const REDUCED = matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ========== PROPERTY GRAPH HERO — from source tables to one picture ========== */
  // The slider's start state is literal: four disjointed source tables
  // (Addresses, Current use, Rental registrations, Assessments). Scrubbing
  // right, the records slide out of their tables into profile cards, the cards
  // cluster by owner, and the owners link into one portfolio. Facts with no
  // source row — "Registered: Never", "311 calls" — appear later, derived.
  (() => {
    const svg = document.getElementById("herograph-svg");
    const wrap = document.getElementById("herograph-stage");
    const VW = 560, VH = 560;
    const mk = (tag, attrs, parent) => {
      const e = document.createElementNS(NS, tag);
      for (const k in attrs) e.setAttribute(k, attrs[k]);
      (parent || svg).appendChild(e);
      return e;
    };
    // each kind of card wears a brand tone: owners the brand dark, registered
    // rentals sky, never-registered ones yellow. `g` is the icon's gradient
    // (light → deep), `acc` the accent bar, `line` where its ownership lines
    // start or end, `wash` the card's top tint, `glow` its shadow.
    const TONES = {
      owner: { g: ["#5a5957", "#343332"], acc: "#343332", line: "#c8ccd6", wash: "#f5f5f5", glow: "rgba(52, 51, 50, 0.38)" },
      reg:   { g: ["#76dcff", "#1dbfed"], acc: "#4CD5FF", line: "#4CD5FF", wash: "#eefbff", glow: "rgba(14, 155, 196, 0.34)" },
      unreg: { g: ["#ffd75c", "#FFA31A"], acc: "#FFCB1B", line: "#FFCB1B", wash: "#fffbeb", glow: "rgba(255, 163, 26, 0.38)" },
      ghost: { g: ["#c8ccd6", "#b7bcc7"], acc: "#b7bcc7", line: "#b7bcc7", wash: "#ffffff", glow: "rgba(52, 51, 50, 0.3)" },
    };
    const toneOf = n => TONES[n.kind === "owner" ? "owner" : n.reg ? "reg" : "unreg"];
    const paint = (n, t) => {
      n.icEl.style.background = `linear-gradient(135deg, ${t.g[0]}, ${t.g[1]})`;
      n.el.style.setProperty("--acc", t.acc);
      n.el.style.setProperty("--wash", t.wash);
      n.el.style.setProperty("--glow", t.glow);
    };
    const ICON_PERSON =
      '<svg viewBox="-8 -8.5 16 17" width="1.2em" height="1.2em" aria-hidden="true"><path d="M0,-6.2 a3,3 0 1,1 -0.01,0 M-5.4,7 C-5.4,1.6 5.4,1.6 5.4,7 Z" fill="#fff"/></svg>';
    const ICON_HOUSE =
      '<svg viewBox="-7.5 -7 15 14" width="1.2em" height="1.2em" aria-hidden="true"><path d="M-5.4,-0.4 L0,-5.4 L5.4,-0.4 L5.4,5 L-5.4,5 Z" fill="#fff"/></svg>';

    // rows with no `at` are filled by a cell flying in from a source table;
    // rows with `at` are derived by Tolemi and reveal at that slider position.
    const NODES = [
      { id: "e1", kind: "owner", lx: 140, ly: 170, ox: 115, oy: 185,
        name: "Maple Grove Rentals LLC",
        rows: [
          { lb: "Properties", vl: "3", at: 0.58 },
          { lb: "Portfolio", vl: "Linked", at: 0.7 },
        ],
        tip: "Owns three registered rentals · part of one linked portfolio" },
      { id: "e2", kind: "owner", lx: 330, ly: 90, ox: 355, oy: 80,
        name: "MG Holdings LLC",
        rows: [
          { lb: "Properties", vl: "2", at: 0.58 },
          { lb: "Portfolio", vl: "Linked", at: 0.7 },
        ],
        tip: "Three owner identities, one portfolio — Tolemi links them" },
      { id: "e3", kind: "owner", lx: 440, ly: 265, ox: 470, oy: 285,
        name: "J. Harmon",
        rows: [
          { lb: "Properties", vl: "2", at: 0.58 },
          { lb: "Portfolio", vl: "Linked", at: 0.7 },
        ],
        tip: "A personal name on the filings — same portfolio" },

      { id: "p1", kind: "prop", reg: true, owner: "e1", lx: 75, ly: 335,
        name: "27 Winslow Ave",
        rows: [
          { lb: "Current use", vl: "2-Fam Res" },
          { lb: "Registered", vl: "2025" },
        ],
        tip: "Active rental registration" },
      { id: "p2", kind: "prop", reg: true, owner: "e1", lx: 185, ly: 455,
        name: "118 Elm St",
        rows: [
          { lb: "Current use", vl: "3-Fam Res" },
          { lb: "Registered", vl: "2024" },
        ],
        tip: "Active rental registration" },
      { id: "p3", kind: "prop", reg: true, owner: "e1", lx: 260, ly: 305,
        name: "112 Elm St",
        rows: [
          { lb: "Current use", vl: "2-Fam Res" },
          { lb: "Registered", vl: "2024" },
        ],
        tip: "Active rental registration" },
      { id: "p5", kind: "prop", reg: true, owner: "e2", lx: 300, ly: 235,
        name: "301 Court St",
        rows: [
          { lb: "Current use", vl: "2-Fam Res" },
          { lb: "Registered", vl: "2025" },
        ],
        tip: "Active rental registration" },
      { id: "p4", kind: "prop", reg: false, owner: "e2", lx: 430, ly: 380,
        late: [80, 520], name: "44 Brayton Rd",
        rows: [
          { lb: "Current use", vl: "1-Fam Res" },
          { lb: "Registered", vl: "Never", at: 0.45, warn: true },
        ],
        tip: "Never registered — claimed by the linked portfolio" },
      { id: "p6", kind: "prop", reg: false, owner: "e3", lx: 340, ly: 490,
        late: [470, 530], name: "52 Delano St",
        rows: [
          { lb: "311 calls", vl: "5 in 12 mo" },
          { lb: "Registered", vl: "Never", at: 0.45, warn: true },
        ],
        tip: "Never registered — five code calls in twelve months" },
      { id: "p7", kind: "prop", reg: true, owner: "e3", lx: 490, ly: 425,
        name: "9 Falmouth St",
        rows: [
          { lb: "Current use", vl: "1-Fam Res" },
          { lb: "Registered", vl: "2023" },
        ],
        tip: "Active rental registration" },
    ];
    const byId = Object.fromEntries(NODES.map(n => [n.id, n]));
    NODES.forEach(n => {
      if (n.kind === "owner") { n.gx = n.ox; n.gy = n.oy; }
      else {
        const o = byId[n.owner];
        n.gx = n.lx + (o.ox - o.lx); n.gy = n.ly + (o.oy - o.ly);
      }
    });

    // the ownership timeline: each owner in turn grows a line to each of its
    // properties and reels them in; then the owners link and pull together;
    // last, the portfolio claims the never-registered (`late`) properties.
    const OWN = 0.3, GROW = 0.06, PULL = 0.15;
    const LINK = 0.62, MERGE = 0.72, CLAIM = 0.86;
    ["e1", "e2", "e3"].forEach((id, k) => (byId[id].grow = OWN + k * 0.04));

    // the disjointed databases: four systems that never talk to each other.
    // Each row is [record id, value]; the address cell carries the record's
    // name. Every cell leaves its table and lands in a card, so addresses
    // filed in several systems merge into one profile.
    const TABLES = [
      { title: "Current use", cols: ["Address", "Use"], lb: "Current use", slot: "use",
        x: 18, y: 44, c: "#4CD5FF", ink: "#0a7a9e", bg: "#eefbff", rows: [
        ["p1", "2-Fam Res"], ["p2", "3-Fam Res"], ["p3", "2-Fam Res"],
        ["p5", "2-Fam Res"], ["p4", "1-Fam Res"], ["p7", "1-Fam Res"],
      ] },
      { title: "Rental registry", cols: ["Address", "Year"], lb: "Registered", slot: "reg",
        rx: 18, y: 128, c: "#37A04F", ink: "#246b35", bg: "#f0faf2", rows: [
        ["p1", "2025"], ["p2", "2024"], ["p3", "2024"], ["p5", "2025"], ["p7", "2023"],
      ] },
      { title: "Assessments", cols: ["Address", "Owner"], slot: "nm",
        x: 30, y: 336, c: "#FFCB1B", ink: "#C2410C", bg: "#fffbeb", rows: [
        ["p3", "e1"], ["p5", "e2"], ["p7", "e3"],
      ] },
      { title: "311 requests", cols: ["Address", "Calls"], lb: "311 calls", slot: "calls",
        rx: 40, y: 440, c: "#FF0025", ink: "#b3001a", bg: "#fff1f3", rows: [
        ["p6", "5 in 12 mo"],
      ] },
    ];

    const EDGES = [];
    // gradients track their own line's endpoints (userSpaceOnUse), so they
    // never collapse on a flat line
    const defs = mk("defs", {});
    // ownership lines run from a quiet grey at the owner into the property's tone
    NODES.filter(n => n.kind === "prop").forEach(p => {
      const grad = mk("linearGradient", { id: `hg-own-grad-${p.id}`, gradientUnits: "userSpaceOnUse" }, defs);
      mk("stop", { offset: "0", "stop-color": TONES.owner.line }, grad);
      mk("stop", { offset: "1", "stop-color": toneOf(p).line }, grad);
      EDGES.push({ a: p.owner, b: p.id, kind: "own", g: 0, grad,
        at: p.late ? CLAIM : byId[p.owner].grow,
        l: mk("line", { class: "gel hg-own", stroke: `url(#hg-own-grad-${p.id})` }) });
    });
    // portfolio links run bright sky into deep sky
    [["e1", "e2"], ["e2", "e3"]].forEach(([a, b], k) => {
      const grad = mk("linearGradient", { id: `hg-link-grad-${k}`, gradientUnits: "userSpaceOnUse" }, defs);
      mk("stop", { offset: "0", "stop-color": "#4CD5FF" }, grad);
      mk("stop", { offset: "1", "stop-color": "#0e9bc4" }, grad);
      EDGES.push({ a, b, kind: "link", g: 0, at: LINK + k * 0.04, grad,
        l: mk("line", { class: "gel hg-link", stroke: `url(#hg-link-grad-${k})` }) });
    });
    EDGES.forEach(e => (e.l.style.opacity = 0));
    const neighbors = {};
    EDGES.forEach(e => {
      (neighbors[e.a] = neighbors[e.a] || new Set()).add(e.b);
      (neighbors[e.b] = neighbors[e.b] || new Set()).add(e.a);
    });

    // ---- render: profile cards ----
    const TONE = { "Registered": "t-reg", "Phone": "t-id", "Mailing": "t-id",
      "Current use": "t-use", "Properties": "t-use", "Portfolio": "t-id",
      "311 calls": "t-alert" };
    const SLOT = { "Current use": "use", "Registered": "reg", "311 calls": "calls" };
    NODES.forEach((n, i) => {
      // scattered, then spread apart by resolve() once card sizes are known;
      // unclaimed (`late`) properties wait at their parking spot out on the edge
      n.sx0 = n.sx = n.late ? n.late[0] : 70 + (hash(i * 17 + 3) / 100) * (VW - 140);
      n.sy0 = n.sy = n.late ? n.late[1] : 60 + (hash(i * 29 + 11) / 100) * (VH - 120);
      n.x = n.sx; n.y = n.sy; n.tx = n.sx; n.ty = n.sy; n.vx = 0; n.vy = 0;

      const el = document.createElement("div");
      el.className = "gcard shell" + (n.kind === "prop" && !n.reg ? " flag" : "");
      el.setAttribute("role", "img");
      el.setAttribute("tabindex", "0");
      el.setAttribute("aria-label", `${n.name} — ${n.tip}`);
      const rowsHtml = n.rows.map(r =>
        `<div class="gc-row"><span class="lb">${r.lb}</span>` +
        `<span class="vl pill ${r.warn ? "warn" : TONE[r.lb] || ""}"${
          r.at != null ? ` data-at="${r.at}"` : ""}>${r.vl}</span></div>`
      ).join("");
      el.innerHTML =
        `<div class="gc-head"><span class="ic">${
          n.kind === "owner" ? ICON_PERSON
          : ICON_HOUSE.replace('#fff', n.reg ? '#0a3a47' : '#6b5500')}</span>` +
        `<span class="nm gnm">${n.name}</span></div>` +
        `<div class="gc-table">${rowsHtml}</div>`;
      wrap.appendChild(el);
      n.el = el;
      n.icEl = el.querySelector(".ic");
      paint(n, toneOf(n));
      n.slotEls = { nm: el.querySelector(".nm") };
      el.querySelectorAll(".gc-row").forEach((row, k) => {
        const r = n.rows[k];
        if (SLOT[r.lb] && r.at == null) n.slotEls[SLOT[r.lb]] = row.querySelector(".vl");
      });
    });
    const cards = NODES;

    // ---- the source tables, and a mover for every cell ----
    const DB_ICON =
      '<svg viewBox="0 0 16 16" width="1.15em" height="1.15em" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="8" cy="3.6" rx="5.6" ry="2.1"/><path d="M2.4 3.6v8.8c0 1.2 2.5 2.1 5.6 2.1s5.6-.9 5.6-2.1V3.6M2.4 8c0 1.2 2.5 2.1 5.6 2.1s5.6-.9 5.6-2.1"/></svg>';
    const MOVERS = [], FLY = 0.12; // FLY: slider span of one cell's flight
    TABLES.forEach((t, ti) => {
      const el = document.createElement("div");
      el.className = "gsrc";
      el.style.setProperty("--tc", t.c);
      el.style.setProperty("--tink", t.ink);
      el.style.setProperty("--tbg", t.bg);
      const last = t.rows.length - 1;
      el.innerHTML = `<div class="gsrc-title">${DB_ICON}${t.title}</div>` +
        `<div class="gsrc-grid">${t.cols.map(c => `<span class="gsrc-th">${c}</span>`).join("")}` +
        t.rows.map(([id, v], k) => {
          const td = `gsrc-td${k === last ? " last" : ""}`;
          const val = t.slot === "nm"
            ? `<span class="gnm">${byId[v].name}</span>`
            : `<span class="pill ${TONE[t.lb]}">${v}</span>`;
          return `<span class="${td}"><span class="gnm">${byId[id].name}</span></span>` +
            `<span class="${td}">${val}</span>`;
        }).join("") + `</div>`;
      wrap.appendChild(el);
      t.el = el;
      // each table empties in turn; its cells leave a beat apart
      t.st = 0.02 + ti * 0.025;
      const cells = el.querySelectorAll(".gsrc-td > span");
      t.rows.forEach(([id, v], k) => {
        const st = t.st + k * 0.004;
        const pairs = [[cells[2 * k], byId[id], "nm"],
          [cells[2 * k + 1], t.slot === "nm" ? byId[v] : byId[id], t.slot]];
        pairs.forEach(([src, node, slot]) => {
          const fly = src.cloneNode(true);
          fly.classList.add("gfly");
          wrap.appendChild(fly);
          node.slotEls[slot].classList.add("src");
          MOVERS.push({ src, fly, node, dst: node.slotEls[slot], st });
        });
      });
      t.end = t.st + last * 0.004;
    });
    // the boxes draw in together, once the last cell has landed
    const SHOW_AT = Math.max(...MOVERS.map(m => m.st)) + FLY;
    const REVEALS = [...wrap.querySelectorAll("[data-at]")];

    const setGhost = (n, ghost) => {
      if (n.kind !== "prop" || n.reg) return;
      paint(n, ghost ? TONES.ghost : TONES.unreg);
      n.el.classList.toggle("ghost", ghost);
    };

    // ---- scale, measurement, collision, flight paths ----
    let SC = { sx: 1, sy: 1 };
    function measure() {
      const r = svg.getBoundingClientRect();
      SC = { sx: r.width / VW, sy: r.height / VH };
      // the graph compresses as one object: type scales with the stage
      wrap.style.fontSize = Math.max(5.5, 8.8 * SC.sx) + "px";
      cards.forEach(n => { n.hw = n.el.offsetWidth / 2; n.hh = n.el.offsetHeight / 2; });
    }
    function placeTables() {
      TABLES.forEach(t => {
        if (t.rx != null) {
          t.el.style.left = "auto";
          t.el.style.right = t.rx * SC.sx + "px";
        } else {
          t.el.style.left = t.x * SC.sx + "px";
        }
        t.el.style.top = t.y * SC.sy + "px";
      });
    }
    function resolve(px, py, outx, outy) {
      const items = cards.map(n => ({ n, x: n[px], y: n[py],
        hw: n.hw / SC.sx + 14, hh: n.hh / SC.sy + 12 }));
      for (let it = 0; it < 48; it++) {
        let moved = false;
        for (let a = 0; a < items.length; a++)
          for (let b = a + 1; b < items.length; b++) {
            const A = items[a], B = items[b];
            const dx = B.x - A.x, dy = B.y - A.y;
            const ox = A.hw + B.hw - Math.abs(dx);
            const oy = A.hh + B.hh - Math.abs(dy);
            if (ox > 0 && oy > 0) {
              moved = true;
              if (ox < oy) { const s = (dx >= 0 ? 1 : -1) * ox / 2; A.x -= s; B.x += s; }
              else { const s = (dy >= 0 ? 1 : -1) * oy / 2; A.y -= s; B.y += s; }
            }
          }
        items.forEach(A => {
          A.x = Math.max(A.hw + 4, Math.min(VW - A.hw - 4, A.x));
          A.y = Math.max(A.hh + 4, Math.min(VH - A.hh - 4, A.y));
        });
        if (!moved) break;
      }
      items.forEach(A => { A.n[outx] = A.x; A.n[outy] = A.y; });
    }
    // flight paths are measured with the cards at their scattered positions
    function measureFlight() {
      const w = wrap.getBoundingClientRect();
      MOVERS.forEach(m => {
        const s = m.src.getBoundingClientRect(), d = m.dst.getBoundingClientRect();
        m.fx = s.left - w.left; m.fy = s.top - w.top;
        m.tx = d.left - w.left; m.ty = d.top - w.top;
        m.fs = parseFloat(getComputedStyle(m.src).fontSize);
        m.ts = parseFloat(getComputedStyle(m.dst).fontSize);
      });
    }

    // ---- spring engine ----
    const S = 95, D = 13;
    let raf = null, last = 0, pending = false;
    function render(n) {
      n.el.style.transform =
        `translate(${n.x * SC.sx - n.hw}px, ${n.y * SC.sy - n.hh}px)`;
    }
    function frame(now) {
      const dt = Math.min(32, now - (last || now)) / 1000;
      last = now;
      let live = false;
      NODES.forEach(n => {
        n.vx += (S * (n.tx - n.x) - D * n.vx) * dt;
        n.vy += (S * (n.ty - n.y) - D * n.vy) * dt;
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        if (Math.abs(n.vx) + Math.abs(n.vy) +
            Math.abs(n.tx - n.x) + Math.abs(n.ty - n.y) > 0.25) live = true;
        render(n);
      });
      EDGES.forEach(drawEdge);
      raf = live || pending ? requestAnimationFrame(frame) : null;
      if (!raf) last = 0;
    }
    // a line runs from its owner out to the tip, `g` of the way to the property
    function drawEdge(e) {
      const A = byId[e.a], B = byId[e.b];
      e.l.setAttribute("x1", A.x); e.l.setAttribute("y1", A.y);
      e.l.setAttribute("x2", A.x + (B.x - A.x) * e.g);
      e.l.setAttribute("y2", A.y + (B.y - A.y) * e.g);
      if (e.grad) {
        e.grad.setAttribute("x1", A.x); e.grad.setAttribute("y1", A.y);
        e.grad.setAttribute("x2", B.x); e.grad.setAttribute("y2", B.y);
      }
    }
    function wake() { if (!raf) { last = 0; raf = requestAnimationFrame(frame); } }

    // ---- the Tolemi slider: disjointed databases → Tolemi insights ----
    // 0 → 0.3 cells leave their tables for the cards; 0.3 → 0.6 owners reel in
    // their properties; 0.6 → 1 the owners link into one portfolio. Reversible.
    const track = document.getElementById("herograph-track");
    const knobEl = document.getElementById("herograph-knob");
    const veil = document.getElementById("herograph-veil");
    let V = 0, autoRaf = null;
    const cancelAuto = () => { if (autoRaf) cancelAnimationFrame(autoRaf); autoRaf = null; };
    const mixv = (a, b, u) => a + (b - a) * u;
    const clamp01 = v => Math.max(0, Math.min(1, v));
    const ease = u => (u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2);
    const span = (a, d) => ease(clamp01((V - a) / d));
    function setV(v) {
      V = clamp01(v);
      knobEl.style.left = V * 100 + "%";
      veil.style.left = V * 100 + "%";
      track.setAttribute("aria-valuenow", String(Math.round(V * 100)));
      NODES.forEach(n => {
        const gx = n.gx2 ?? n.gx, gy = n.gy2 ?? n.gy;
        const lx = n.lx2 ?? n.lx, ly = n.ly2 ?? n.ly;
        // a property moves only once its owner's line has reached it
        const o = n.kind === "owner" ? n : byId[n.owner];
        const u1 = n.late ? span(OWN, 0.3) : span(o.grow + GROW, PULL);
        const u2 = n.late ? span(CLAIM + GROW, 1 - CLAIM - GROW) : span(MERGE, 0.16);
        n.tx = mixv(mixv(n.sx, gx, u1), lx, u2);
        n.ty = mixv(mixv(n.sy, gy, u1), ly, u2);
        n.el.classList.toggle("shell", V < SHOW_AT);
        setGhost(n, V < CLAIM);
      });
      REVEALS.forEach(el => el.classList.toggle("in", V >= +el.dataset.at));
      // a cell hides in its table the moment it leaves; its slot fills on landing
      const landed = new Set();
      MOVERS.forEach(m => {
        const u = clamp01((V - m.st) / FLY);
        const e = u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
        m.src.style.visibility = u > 0 ? "hidden" : "";
        m.fly.style.opacity = u > 0 && u < 1 ? 1 : 0;
        m.fly.style.fontSize = mixv(m.fs, m.ts, e) + "px";
        m.fly.style.transform =
          `translate(${mixv(m.fx, m.tx, e)}px, ${mixv(m.fy, m.ty, e)}px)`;
        if (u >= 1) landed.add(m.dst);
      });
      MOVERS.forEach(m => m.dst.classList.toggle("in", landed.has(m.dst)));
      // an emptied table folds away
      TABLES.forEach(t => {
        t.el.style.opacity = 1 - clamp01((V - t.end - 0.01) / 0.05);
      });
      EDGES.forEach(e => {
        e.g = span(e.at, GROW);
        e.l.style.opacity = e.g > 0 ? 1 : 0;
      });
      wake();
    }
    const vFromEvent = ev => {
      const r = track.getBoundingClientRect();
      return (ev.clientX - r.left) / r.width;
    };
    track.addEventListener("pointerdown", ev => {
      cancelAuto();
      track.setPointerCapture(ev.pointerId);
      track.parentElement.classList.add("dragging");
      setV(vFromEvent(ev));
      const move = e => setV(vFromEvent(e));
      track.addEventListener("pointermove", move);
      track.addEventListener("pointerup", () => {
        track.removeEventListener("pointermove", move);
        track.parentElement.classList.remove("dragging");
      }, { once: true });
    });
    track.addEventListener("keydown", ev => {
      if (ev.key === "ArrowLeft") { cancelAuto(); setV(V - 0.05); ev.preventDefault(); }
      if (ev.key === "ArrowRight") { cancelAuto(); setV(V + 0.05); ev.preventDefault(); }
    });

    function layout() {
      resolve("sx0", "sy0", "sx", "sy");
      // unclaimed properties hold their scattered spot until the portfolio claims them
      NODES.forEach(n => { if (n.late) { n.gx = n.sx; n.gy = n.sy; } });
      resolve("gx", "gy", "gx2", "gy2");
      resolve("lx", "ly", "lx2", "ly2");
    }

    // ---- sequencing ----
    let timers = [];
    function reset() {
      timers.forEach(clearTimeout); timers = [];
      pending = false;
      cancelAuto();
      measure();
      placeTables();
      layout();
      NODES.forEach(n => {
        n.x = n.tx = n.sx; n.y = n.ty = n.sy; n.vx = n.vy = 0;
        render(n);
      });
      measureFlight();
      setV(0);
    }
    function finish() {
      cancelAuto();
      measure();
      placeTables();
      layout();
      setV(1);
      NODES.forEach(n => { n.x = n.tx; n.y = n.ty; n.vx = n.vy = 0; render(n); });
      EDGES.forEach(drawEdge);
    }
    function play() {
      reset();
      if (REDUCED) { finish(); return; }
      pending = true;
      wake();
      timers.push(setTimeout(() => {
        const t0 = performance.now(), DUR = 6200;
        const step = now => {
          if (autoRaf === null) return;
          const u = Math.min(1, (now - t0) / DUR);
          setV(u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2);
          if (u < 1) autoRaf = requestAnimationFrame(step);
          else { autoRaf = null; pending = false; }
        };
        autoRaf = requestAnimationFrame(step);
      }, 600));
    }

    // ---- hover: isolate a card's part of the graph ----
    function isolate(id) {
      const keep = new Set([id, ...(neighbors[id] || [])]);
      NODES.forEach(n => n.el.classList.toggle("dim", !keep.has(n.id)));
      EDGES.forEach(e => e.l.classList.toggle("dim", !(e.a === id || e.b === id)));
    }
    function clearIso() {
      NODES.forEach(n => n.el.classList.remove("dim"));
      EDGES.forEach(e => e.l.classList.remove("dim"));
    }
    NODES.forEach(n => {
      const show = () => isolate(n.id);
      n.el.addEventListener("mouseenter", show);
      n.el.addEventListener("focus", show);
      n.el.addEventListener("mouseleave", clearIso);
      n.el.addEventListener("blur", clearIso);
    });

    window.addEventListener("resize", () => {
      measure();
      placeTables();
      layout();
      NODES.forEach(render);
      if (V < 0.01) measureFlight();
      setV(V);
    });

    reset();
    const io = new IntersectionObserver(en => {
      if (en[0].isIntersecting) { io.disconnect(); play(); }
    }, { threshold: 0.4 });
    io.observe(svg);
    svg.addEventListener("click", ev => { if (ev.target === svg) play(); });
  })();
</script>
