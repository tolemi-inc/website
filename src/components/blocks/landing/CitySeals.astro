---
interface Props {
  displaySeals: number[];
  gridCols?: number;
  sealSize?: string;
  id?: string;
}
const {
  displaySeals,
  gridCols = 3,
  sealSize = "w-9 h-9",
  id,
} = Astro.props;
---

<div class="flex flex-col items-center flex-shrink-0">
  <div class={`df-seal-container transition-opacity duration-500 grid grid-cols-${gridCols} gap-1.5`} id={id}>
    {
      displaySeals.map((sealId) => (
        <div
          class={`df-seal ${sealSize} rounded-full overflow-hidden border border-text-muted/15 bg-surface`}
        >
          <img
            src={`/city_seals/${sealId}.png`}
            alt=""
            class="w-full h-full object-cover rounded-full"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
  <h3
    class="font-heading text-[10px] font-bold text-text-muted uppercase tracking-widest mt-4"
  >
    Cities
  </h3>
</div>
