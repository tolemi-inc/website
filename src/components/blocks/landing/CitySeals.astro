---
interface Props {
  displaySeals: number[];
  allSealIds: number[];
  gridCols?: number;
  sealSize?: string;
  id?: string;
}
const {
  displaySeals,
  allSealIds,
  gridCols = 3,
  sealSize = "w-9 h-9",
  id,
} = Astro.props;
---

<div class="flex flex-col items-center flex-shrink-0">
  <h3
    class="font-heading text-[10px] font-bold text-text-muted uppercase tracking-widest mb-4"
  >
    Cities
  </h3>
  <div class={`grid grid-cols-${gridCols} gap-1.5`} id={id}>
    {
      displaySeals.map((sealId) => (
        <div
          class={`df-seal flip-card ${sealSize} rounded-full overflow-hidden border border-text-muted/15 bg-surface`}
        >
          <div class="flip-card-inner">
            <div class="flip-face flip-front">
              <img
                src={`/city_seals/${sealId}.png`}
                alt=""
                class="w-full h-full object-cover rounded-full"
                loading="lazy"
              />
            </div>
            <div class="flip-face flip-back">
              <img
                src={`/city_seals/${allSealIds[Math.floor(Math.random() * allSealIds.length)]}.png`}
                alt=""
                class="w-full h-full object-cover rounded-full"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
