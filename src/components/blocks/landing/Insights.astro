---
// Insights — scroll-driven property filter + heatmap + details
import SectionHeader from "../../ui/SectionHeader.astro";
import InsightsPanel from "./InsightsPanel.astro";
import InsightsMap from "./InsightsMap.astro";
---

<section class="relative bg-surface" data-insights>
  <!-- Extra height for scroll-driven filtering -->
  <div class="h-[300vh]">
    <div class="sticky top-0 min-h-screen flex items-center">
      <div class="w-full py-20 md:py-28 px-6">
        <SectionHeader
          heading="Actionable Insights, Instantly."
          subtitle="Filter properties by any combination of traits. Drill down to see details about each one."
        />
        <div class="max-w-7xl mx-auto">
          <div
            id="insights-stage"
            class="grid gap-6 items-stretch lg:grid-cols-[260px_1fr_260px] md:grid-cols-[240px_1fr]"
          >
            <InsightsPanel />
            <InsightsMap id="insights-map" />
            <!-- Details card -->
            <div
              id="parcel-details"
              class="opacity-0 pointer-events-none transition-all duration-300 md:col-span-2 lg:col-span-1 flex flex-col"
            >
              <!-- Nav above card -->
              <div
                id="detail-nav"
                class="flex items-center justify-between mb-2 px-1 hidden"
              >
                <span
                  class="text-xs font-semibold text-text-muted uppercase tracking-widest"
                  >Property Details</span
                >
                <div class="flex items-center gap-2">
                  <button
                    id="detail-prev"
                    class="w-7 h-7 rounded-full bg-text-muted/10 hover:bg-text-muted/20 flex items-center justify-center transition-colors"
                    aria-label="Previous"
                  >
                    <svg
                      class="w-3.5 h-3.5 text-text-secondary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M15 19l-7-7 7-7"></path></svg
                    >
                  </button>
                  <span
                    id="detail-pos"
                    class="text-xs font-semibold text-text-muted tabular-nums min-w-[3ch] text-center"
                  ></span>
                  <button
                    id="detail-next"
                    class="w-7 h-7 rounded-full bg-text-muted/10 hover:bg-text-muted/20 flex items-center justify-center transition-colors"
                    aria-label="Next"
                  >
                    <svg
                      class="w-3.5 h-3.5 text-text-secondary"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M9 5l7 7-7 7"></path></svg
                    >
                  </button>
                </div>
              </div>
              <div
                class="bg-surface rounded-xl border border-text-muted/10 shadow-sm p-5 md:p-6 flex-1 flex flex-col"
              >
                <h3
                  id="detail-address"
                  class="font-heading text-base font-bold text-text-primary mb-4 leading-tight"
                >
                </h3>
                <div class="space-y-2.5 text-sm">
                  <div class="flex justify-between">
                    <span class="text-text-muted">Sale Price</span>
                    <span
                      id="detail-price"
                      class="font-semibold text-text-primary tabular-nums"
                    ></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Assessed Value</span>
                    <span
                      id="detail-assessed"
                      class="font-semibold text-text-primary tabular-nums"
                    ></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Last Sale</span>
                    <span
                      id="detail-date"
                      class="font-semibold text-text-primary"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Zoning</span>
                    <span
                      id="detail-zoning"
                      class="font-semibold text-text-primary"></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Lot Size</span>
                    <span
                      id="detail-acres"
                      class="font-semibold text-text-primary tabular-nums"
                    ></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Permits (total)</span>
                    <span
                      id="detail-permits"
                      class="font-semibold text-text-primary tabular-nums"
                    ></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Permits (6 mo)</span>
                    <span
                      id="detail-permits-recent"
                      class="font-semibold text-text-primary tabular-nums"
                    ></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-text-muted">Police Calls (6 mo)</span>
                    <span
                      id="detail-calls"
                      class="font-semibold text-text-primary tabular-nums"
                    ></span>
                  </div>
                </div>
                <div
                  id="detail-tags"
                  class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-text-muted/10"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initInsights() {
    const section = document.querySelector<HTMLElement>("[data-insights]");
    if (!section) return;

    const mapContainer = document.getElementById("insights-map");
    const mapParcels = document.querySelectorAll(
      "#insights-map path[data-idx]",
    );
    const metaScript = mapContainer?.querySelector("[data-parcel-meta]");
    const parcelMeta: any[] = metaScript
      ? JSON.parse(metaScript.textContent || "[]")
      : [];

    const priceMin = document.getElementById("price-min") as HTMLInputElement;
    const priceMax = document.getElementById("price-max") as HTMLInputElement;
    const dateMin = document.getElementById("date-min") as HTMLInputElement;
    const dateMax = document.getElementById("date-max") as HTMLInputElement;
    const priceMinLabel = document.getElementById("price-min-label")!;
    const priceMaxLabel = document.getElementById("price-max-label")!;
    const dateMinLabel = document.getElementById("date-min-label")!;
    const dateMaxLabel = document.getElementById("date-max-label")!;
    const priceRangeFill = document.getElementById("price-range-fill")!;
    const dateRangeFill = document.getElementById("date-range-fill")!;
    const filterRental = document.getElementById(
      "filter-rental",
    ) as HTMLInputElement;
    const filterOwner = document.getElementById(
      "filter-owner",
    ) as HTMLInputElement;
    const filterVacant = document.getElementById(
      "filter-vacant",
    ) as HTMLInputElement;
    const filterCount = document.getElementById("filter-count")!;
    const detailsPanel = document.getElementById("parcel-details")!;
    const hoverOverlay = document.getElementById("hover-overlay")!;
    const selectionOverlay = document.getElementById("selection-overlay")!;
    const detailNav = document.getElementById("detail-nav")!;
    const detailPos = document.getElementById("detail-pos")!;
    const detailPrev = document.getElementById("detail-prev")!;
    const detailNext = document.getElementById("detail-next")!;

    if (!priceMin || !mapParcels.length || !parcelMeta.length) return;

    let selectedIdx = -1;
    let hoveredIdx = -1;
    let userTookOverCheckboxes = false;
    let userTookOverSliders = false;
    let scrollAutoSelect = true;
    const matchedParcels = new Set<number>();
    let matchedList: number[] = []; // ordered list for cycling

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }
    function clamp01(t: number) {
      return Math.max(0, Math.min(1, t));
    }

    function formatPrice(v: number): string {
      if (v >= 1_000_000) return `$${(v / 1_000_000).toFixed(1)}M`;
      return `$${Math.round(v / 1000)}k`;
    }

    function updateRangeFill(
      minInput: HTMLInputElement,
      maxInput: HTMLInputElement,
      fillEl: HTMLElement,
    ) {
      const min = Number(minInput.min);
      const max = Number(minInput.max);
      const lo = Number(minInput.value);
      const hi = Number(maxInput.value);
      const leftPct = ((lo - min) / (max - min)) * 100;
      const rightPct = ((hi - min) / (max - min)) * 100;
      fillEl.style.left = leftPct + "%";
      fillEl.style.width = rightPct - leftPct + "%";
    }

    function applyFilters() {
      const pMinVal = Number(priceMin.value);
      const pMaxVal = Number(priceMax.value);
      const dMinVal = Number(dateMin.value);
      const dMaxVal = Number(dateMax.value);

      const checkRental = filterRental.checked;
      const checkOwner = filterOwner.checked;
      const checkVacant = filterVacant.checked;
      const anyCheckbox = checkRental || checkOwner || checkVacant;

      priceMinLabel.textContent = formatPrice(pMinVal);
      priceMaxLabel.textContent = formatPrice(pMaxVal);
      dateMinLabel.textContent = dateMin.value;
      dateMaxLabel.textContent = dateMax.value;

      updateRangeFill(priceMin, priceMax, priceRangeFill);
      updateRangeFill(dateMin, dateMax, dateRangeFill);

      let matchCount = 0;
      matchedParcels.clear();
      matchedList = [];

      mapParcels.forEach((el, i) => {
        const p = parcelMeta[i];
        if (!p) return;

        const saleYear = new Date(p.last_sale_date).getFullYear();
        const inPrice =
          p.property_value >= pMinVal && p.property_value <= pMaxVal;
        const inDate = saleYear >= dMinVal && saleYear <= dMaxVal;

        let inCheckbox = true;
        if (anyCheckbox) {
          inCheckbox =
            (checkRental && p.is_rental) ||
            (checkOwner && p.is_owner_occupied) ||
            (checkVacant && p.is_vacant);
        }

        const match = inPrice && inDate && inCheckbox;
        const svgEl = el as SVGElement;

        if (match) {
          matchCount++;
          matchedParcels.add(i);
          matchedList.push(i);
          // All matched parcels get 0.6 — selectParcel will boost the selected one
          svgEl.setAttribute("fill-opacity", "0.35");
        } else {
          svgEl.setAttribute("fill-opacity", "0.08");
        }
        svgEl.style.cursor = "pointer";
      });

      filterCount.textContent = `${matchCount} of ${parcelMeta.length}`;

      // Auto-deselect only when scroll is driving selection and the parcel no longer matches
      if (
        scrollAutoSelect &&
        selectedIdx >= 0 &&
        !matchedParcels.has(selectedIdx)
      ) {
        selectParcel(-1);
      }

      // Auto-select first match when scroll narrows to a small set
      if (
        scrollAutoSelect &&
        matchCount > 0 &&
        matchCount <= 8 &&
        selectedIdx < 0
      ) {
        selectParcel(matchedList[0]);
      }

      // Re-apply selection highlight (selectParcel sets opacity to 1)
      if (selectedIdx >= 0 && mapParcels[selectedIdx]) {
        (mapParcels[selectedIdx] as SVGElement).setAttribute(
          "fill-opacity",
          "1",
        );
      }

      // Update nav visibility and position indicator
      if (
        matchedList.length > 1 &&
        selectedIdx >= 0 &&
        matchedParcels.has(selectedIdx)
      ) {
        detailNav.classList.remove("hidden");
        const pos = matchedList.indexOf(selectedIdx);
        detailPos.textContent = `${pos + 1} / ${matchedList.length}`;
      } else {
        detailNav.classList.add("hidden");
      }
    }

    function selectParcel(idx: number) {
      const prevIdx = selectedIdx;
      selectedIdx = idx;
      selectionOverlay.innerHTML = "";

      // Reset previous selection back to matched opacity
      if (prevIdx >= 0 && prevIdx !== idx && mapParcels[prevIdx]) {
        (mapParcels[prevIdx] as SVGElement).setAttribute(
          "fill-opacity",
          matchedParcels.has(prevIdx) ? "0.35" : "0.08",
        );
      }

      if (idx >= 0 && mapParcels[idx]) {
        // Boost selected parcel to full opacity
        (mapParcels[idx] as SVGElement).setAttribute("fill-opacity", "1");

        // Glowing clone of the selected parcel
        const glow = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "path",
        );
        glow.setAttribute("d", mapParcels[idx].getAttribute("d")!);
        glow.setAttribute(
          "fill",
          (mapParcels[idx] as SVGElement).getAttribute("fill")!,
        );
        glow.setAttribute("fill-opacity", "0.6");
        glow.setAttribute("stroke", "white");
        glow.setAttribute("stroke-width", "1.5");
        glow.setAttribute("filter", "url(#selection-glow)");
        glow.setAttribute("pointer-events", "none");
        selectionOverlay.appendChild(glow);

        showDetails(idx);
      } else {
        hideDetails();
      }
    }

    function showDetails(idx: number) {
      const p = parcelMeta[idx];
      if (!p) return;

      document.getElementById("detail-address")!.textContent = p.street_address;
      document.getElementById("detail-price")!.textContent = formatPrice(
        p.property_value,
      );
      document.getElementById("detail-assessed")!.textContent = formatPrice(
        p.assessed_value,
      );
      document.getElementById("detail-date")!.textContent = p.last_sale_date;
      document.getElementById("detail-zoning")!.textContent = p.zoning;
      document.getElementById("detail-acres")!.textContent =
        p.acres < 0.01 ? "<0.01 ac" : p.acres.toFixed(2) + " ac";
      document.getElementById("detail-permits")!.textContent = String(
        p.building_permits,
      );
      document.getElementById("detail-permits-recent")!.textContent = String(
        p.count_permits_last_six_months,
      );
      document.getElementById("detail-calls")!.textContent = String(
        p.count_police_calls_last_six_months,
      );

      const tagsEl = document.getElementById("detail-tags")!;
      tagsEl.innerHTML = "";
      const tagClass = "text-[11px] font-semibold px-2 py-0.5 rounded-full";
      if (p.is_rental) {
        tagsEl.innerHTML += `<span class="${tagClass} bg-tolemi-indigo/10 text-tolemi-indigo-600">Rental</span>`;
      }
      if (p.is_owner_occupied) {
        tagsEl.innerHTML += `<span class="${tagClass} bg-tolemi-sky/10 text-tolemi-sky-700">Owner Occupied</span>`;
      }
      if (p.is_vacant) {
        tagsEl.innerHTML += `<span class="${tagClass} bg-tolemi-red/10 text-tolemi-red-500">Vacant</span>`;
      }

      detailsPanel.classList.remove("opacity-0", "pointer-events-none");
      detailsPanel.classList.add("opacity-100");
    }

    function hideDetails() {
      detailsPanel.classList.add("opacity-0", "pointer-events-none");
      detailsPanel.classList.remove("opacity-100");
    }

    // Slider interaction — user takes over from scroll.
    // Clamp each pair so the min thumb can't pass the max thumb (and vice versa).
    const sliderPairs: [HTMLInputElement, HTMLInputElement][] = [
      [priceMin, priceMax],
      [dateMin, dateMax],
    ];
    sliderPairs.forEach(([minInput, maxInput]) => {
      minInput.addEventListener("input", () => {
        if (Number(minInput.value) > Number(maxInput.value)) {
          minInput.value = maxInput.value;
        }
        userTookOverSliders = true;
        applyFilters();
      });
      maxInput.addEventListener("input", () => {
        if (Number(maxInput.value) < Number(minInput.value)) {
          maxInput.value = minInput.value;
        }
        userTookOverSliders = true;
        applyFilters();
      });
    });

    // Checkbox interaction — user takes over from scroll
    [filterRental, filterOwner, filterVacant].forEach((input) => {
      input.addEventListener("change", () => {
        userTookOverCheckboxes = true;
        applyFilters();
      });
    });

    // Hover glow on any parcel
    function setHover(idx: number) {
      if (idx === hoveredIdx) return;
      hoveredIdx = idx;
      hoverOverlay.innerHTML = "";
      if (idx < 0 || !mapParcels[idx]) return;
      const glow = document.createElementNS(
        "http://www.w3.org/2000/svg",
        "path",
      );
      glow.setAttribute("d", mapParcels[idx].getAttribute("d")!);
      glow.setAttribute("fill", "white");
      glow.setAttribute("fill-opacity", "0.25");
      glow.setAttribute("stroke", "white");
      glow.setAttribute("stroke-width", "0.8");
      glow.setAttribute("pointer-events", "none");
      hoverOverlay.appendChild(glow);
    }

    mapParcels.forEach((el, i) => {
      el.addEventListener("mouseenter", () => setHover(i));
      el.addEventListener("mouseleave", () => setHover(-1));
    });

    // Click any parcel to select — user takes control
    mapParcels.forEach((el, i) => {
      el.addEventListener("click", () => {
        scrollAutoSelect = false;
        if (i === selectedIdx) {
          selectParcel(-1);
        } else {
          selectParcel(i);
        }
        applyFilters();
      });
    });

    // Prev/next navigation through matched parcels
    function cycleSelection(delta: number) {
      if (matchedList.length === 0) return;
      const currentPos = matchedList.indexOf(selectedIdx);
      const nextPos =
        (currentPos + delta + matchedList.length) % matchedList.length;
      scrollAutoSelect = false;
      selectParcel(matchedList[nextPos]);
      applyFilters();
    }

    detailPrev.addEventListener("click", () => cycleSelection(-1));
    detailNext.addEventListener("click", () => cycleSelection(1));

    // Scroll-driven filtering
    // Progress 0→1 maps to progressively narrower filters
    function onScroll() {
      const rect = section!.getBoundingClientRect();
      const sectionHeight = section!.offsetHeight;
      const viewportH = window.innerHeight;

      const scrolled = -rect.top;
      const scrollRange = sectionHeight - viewportH;
      const progress = Math.max(0, Math.min(1, scrolled / scrollRange));

      if (!userTookOverSliders) {
        // Phase 1 (0–0.12): price min rises
        const pMinBase = lerp(200000, 800000, clamp01(progress / 0.12));
        // Phase 2 (0.12–0.25): price max drops
        const pMaxBase = lerp(
          4000000,
          1300000,
          clamp01((progress - 0.12) / 0.13),
        );
        // Phase 3 (0.25–0.40): date min rises
        const dMinBase = lerp(1890, 2015, clamp01((progress - 0.25) / 0.15));
        // Phase 4 (0.40–0.55): date max drops
        const dMaxBase = lerp(2026, 2022, clamp01((progress - 0.4) / 0.15));
        // No further tightening — these values already give ~5 matches with rental
        priceMin.value = String(Math.round(pMinBase));
        priceMax.value = String(Math.round(pMaxBase));
        dateMin.value = String(Math.round(dMinBase));
        dateMax.value = String(Math.round(dMaxBase));
      }
      // Phase 5 (0.55–0.65): rental checkbox (only if user hasn't taken over)
      if (!userTookOverCheckboxes) {
        filterRental.checked = progress > 0.6;
        filterOwner.checked = false;
        filterVacant.checked = false;
      }

      // Reset selection when scrolling back to wide filters
      if (progress < 0.55 && selectedIdx >= 0) {
        scrollAutoSelect = true;
        selectParcel(-1);
      }

      applyFilters();
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  initInsights();
  document.addEventListener("astro:page-load", initInsights);
</script>
