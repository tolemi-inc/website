---
// PropertyDetails — "Every Property. Every Detail." map + detail cards
import MapPlaceholder from "./MapPlaceholder.astro";
import DetailCards from "./DetailCards.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
---

<section
  class="relative bg-surface"
  data-property-details
>
  <!-- Extra height gives scroll room for 4 card steps + intro/outro -->
  <div class="h-[300vh]">
    <div class="sticky top-0 min-h-screen flex items-center">
      <div class="w-full py-20 md:py-28 px-6">
        <div class="max-w-7xl mx-auto">
          <SectionHeader
            eyebrow="Property Details"
            heading="Every Property. Every Detail."
            subtitle="Explore comprehensive information about each property in our integrated real estate database."
          />
          <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
            <MapPlaceholder id="detail-map" />
            <DetailCards />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Card config: field key, type, format function, card accent color
  const CARD_CONFIG = [
    { key: "building_permits", type: "numeric", format: (v: any) => `${v}`, accent: "#0ea5e9" },
    { key: "zoning", type: "categorical", format: (v: any) => v, accent: "#eab308" },
    { key: "assessed_value", type: "numeric", format: (v: any) => `$${(v / 1000).toFixed(0)}k`, accent: "#ef4444" },
    { key: "last_sale_date", type: "numeric", format: (v: any) => v, accent: "#22c55e" },
  ];

  // Heatmap: tolemi blue → green → yellow → red (brightened)
  const HEATMAP_STOPS = [
    { r: 56, g: 189, b: 248 },  // sky-400
    { r: 74, g: 222, b: 128 },  // green-400
    { r: 250, g: 204, b: 21 },  // yellow-400
    { r: 248, g: 113, b: 113 }, // red-400
  ];

  // Categorical colors — bright, one per unique zoning value
  const CATEGORY_COLORS = [
    "#38bdf8", // sky-400
    "#4ade80", // green-400
    "#facc15", // yellow-400
    "#f87171", // red-400
    "#818cf8", // indigo-400
    "#fb923c", // orange-400
  ];

  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

  function heatmapColor(t: number): string {
    // t is 0..1, maps across HEATMAP_STOPS
    const clamped = Math.max(0, Math.min(1, t));
    const segCount = HEATMAP_STOPS.length - 1;
    const seg = Math.min(Math.floor(clamped * segCount), segCount - 1);
    const local = clamped * segCount - seg;
    const a = HEATMAP_STOPS[seg], b = HEATMAP_STOPS[seg + 1];
    const r = Math.round(lerp(a.r, b.r, local));
    const g = Math.round(lerp(a.g, b.g, local));
    const bl = Math.round(lerp(a.b, b.b, local));
    return `rgb(${r},${g},${bl})`;
  }

  function initPropertyDetails() {
    const section = document.querySelector<HTMLElement>("[data-property-details]");
    if (!section) return;

    const svg = section.querySelector("svg");
    const labelsGroup = svg?.querySelector<SVGGElement>("[data-labels]");
    const hoverOverlay = svg?.querySelector<SVGGElement>("[data-hover-overlay]");
    const paths = svg?.querySelectorAll<SVGPathElement>("path[data-idx]");
    const cards = section.querySelectorAll<HTMLElement>("[data-card]");
    const parcelMeta: any[] = JSON.parse(
      section.querySelector<HTMLScriptElement>("[data-parcel-meta]")?.textContent || "[]"
    );

    if (!svg || !paths || !cards.length || !parcelMeta.length || !labelsGroup || !hoverOverlay) return;

    const LABEL_FIT_W = 28;
    const LABEL_FIT_H = 12;
    const LEADER_LEN = 18;

    let activeCard = -1;
    let featuredParcel = -1;
    let hoveredIdx = -1;
    let currentColorFn: ((meta: any) => string) | null = null;

    const STORAGE_KEY = "tolemi-featured-parcel";

    // Compute faint base colors from assessed_value
    const assessedValues = parcelMeta.map((m) => m.assessed_value);
    const avMin = Math.min(...assessedValues);
    const avMax = Math.max(...assessedValues);
    const avRange = avMax - avMin || 1;
    const baseColors = parcelMeta.map((m) => {
      const t = (m.assessed_value - avMin) / avRange;
      return heatmapColor(t);
    });
    const BASE_OPACITY = "0.15";

    // Restore from session or fall back to the largest parcel
    const largest = parcelMeta.reduce((best, m, i) =>
      m.w * m.h > parcelMeta[best].w * parcelMeta[best].h ? i : best, 0);
    const stored = sessionStorage.getItem(STORAGE_KEY);
    let selectedParcel = stored !== null && Number(stored) < parcelMeta.length
      ? Number(stored) : largest;

    function applyBaseColors() {
      paths!.forEach((p, i) => {
        p.setAttribute("fill", baseColors[i]);
        p.setAttribute("fill-opacity", BASE_OPACITY);
        p.setAttribute("stroke", "#cbd5e1");
        p.removeAttribute("filter");
      });
    }

    // Apply faint base colors initially
    applyBaseColors();

    function setHover(idx: number) {
      if (idx === hoveredIdx) return;
      hoveredIdx = idx;
      hoverOverlay!.innerHTML = "";
      if (idx < 0 || !paths![idx]) return;
      const glow = document.createElementNS("http://www.w3.org/2000/svg", "path");
      glow.setAttribute("d", paths![idx].getAttribute("d")!);
      glow.setAttribute("fill", "white");
      glow.setAttribute("fill-opacity", "0.3");
      glow.setAttribute("stroke", "white");
      glow.setAttribute("stroke-width", "0.8");
      glow.setAttribute("pointer-events", "none");
      hoverOverlay!.appendChild(glow);
    }

    function featureParcel(idx: number) {
      // Reset previous featured parcel to base color
      if (featuredParcel >= 0 && paths![featuredParcel]) {
        paths![featuredParcel].setAttribute("fill", baseColors[featuredParcel]);
        paths![featuredParcel].setAttribute("fill-opacity", BASE_OPACITY);
        paths![featuredParcel].setAttribute("stroke", "#cbd5e1");
        paths![featuredParcel].removeAttribute("filter");
      }

      labelsGroup!.innerHTML = "";
      featuredParcel = idx;

      if (idx >= 0) {
        selectedParcel = idx;
        sessionStorage.setItem(STORAGE_KEY, String(idx));
      }

      if (idx < 0) return;

      // Determine color: use card-specific color if a card is active, else assessed_value base
      const meta = parcelMeta[idx];
      const color = (activeCard >= 0 && currentColorFn)
        ? currentColorFn(meta)
        : baseColors[idx];

      // Color the featured parcel
      const path = paths![idx];
      path.setAttribute("fill", color);
      path.setAttribute("fill-opacity", "0.85");
      path.setAttribute("stroke", color);
      path.setAttribute("filter", "url(#parcel-glow)");

      // Only show label when a card is active
      if (activeCard < 0) return;

      const config = CARD_CONFIG[activeCard];
      const label = config.format(meta[config.key]);
      const fitsInside = meta.w >= LABEL_FIT_W && meta.h >= LABEL_FIT_H;

      let labelX = meta.cx;
      let labelY = meta.cy;

      if (!fitsInside) {
        const dx = meta.cx > 200 ? 1 : -1;
        const dy = meta.cy > 150 ? 1 : -1;
        labelX = meta.cx + dx * LEADER_LEN;
        labelY = meta.cy + dy * LEADER_LEN;

        const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
        line.setAttribute("x1", String(meta.cx));
        line.setAttribute("y1", String(meta.cy));
        line.setAttribute("x2", String(labelX));
        line.setAttribute("y2", String(labelY));
        line.setAttribute("stroke", color);
        line.setAttribute("stroke-width", "0.8");
        labelsGroup!.appendChild(line);

        const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        dot.setAttribute("cx", String(meta.cx));
        dot.setAttribute("cy", String(meta.cy));
        dot.setAttribute("r", "1.5");
        dot.setAttribute("fill", color);
        labelsGroup!.appendChild(dot);
      }

      const attrs: Record<string, string> = {
        x: String(labelX),
        y: String(labelY),
        "text-anchor": "middle",
        "dominant-baseline": "central",
        "font-size": "7",
        "font-weight": "700",
        "font-family": "Inter, system-ui, sans-serif",
      };

      const halo = document.createElementNS("http://www.w3.org/2000/svg", "text");
      for (const [k, v] of Object.entries(attrs)) halo.setAttribute(k, v);
      halo.setAttribute("fill", "white");
      halo.setAttribute("stroke", "white");
      halo.setAttribute("stroke-width", "3.5");
      halo.setAttribute("stroke-linejoin", "round");
      halo.setAttribute("stroke-linecap", "round");
      halo.textContent = label;
      labelsGroup!.appendChild(halo);

      const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
      for (const [k, v] of Object.entries(attrs)) text.setAttribute(k, v);
      text.setAttribute("fill", "#1a1a1a");
      text.textContent = label;
      labelsGroup!.appendChild(text);
    }

    function setActiveCard(index: number) {
      if (index === activeCard) return;
      activeCard = index;

      // Reset all parcels to faint base colors
      applyBaseColors();

      labelsGroup!.innerHTML = "";
      featuredParcel = -1;
      currentColorFn = null;

      // Reset all cards
      cards.forEach((c) => {
        c.style.borderColor = "";
        c.style.boxShadow = "";
        c.style.transform = "";
      });

      if (index < 0 || index >= CARD_CONFIG.length) {
        // No card active — still feature the selected parcel with base color
        featureParcel(selectedParcel);
        return;
      }

      const config = CARD_CONFIG[index];

      // Compute color mapping
      if (config.type === "categorical") {
        const unique = [...new Set(parcelMeta.map((m) => m[config.key]))];
        const colorMap: Record<string, string> = {};
        unique.forEach((val, i) => { colorMap[val] = CATEGORY_COLORS[i % CATEGORY_COLORS.length]; });
        currentColorFn = (m) => colorMap[m[config.key]];
      } else {
        const values = parcelMeta.map((m) => {
          const v = m[config.key];
          if (config.key === "last_sale_date") return new Date(v).getTime();
          return Number(v);
        });
        const min = Math.min(...values);
        const max = Math.max(...values);
        const range = max - min || 1;
        currentColorFn = (m) => {
          const v = config.key === "last_sale_date" ? new Date(m[config.key]).getTime() : Number(m[config.key]);
          return heatmapColor((v - min) / range);
        };
      }

      // Feature the default parcel
      featureParcel(selectedParcel);

      // Highlight active card
      const card = cards[index];
      card.style.borderColor = config.accent;
      card.style.boxShadow = `0 0 0 1px ${config.accent}, 0 4px 12px ${config.accent}33`;
      card.style.transform = "scale(1.02)";
    }

    // Hover — always works
    paths.forEach((p, i) => {
      p.style.cursor = "pointer";
      p.addEventListener("mouseenter", () => {
        setHover(i);
        featureParcel(i);
      });
    });

    // Click — always changes selected parcel
    paths.forEach((p, i) => {
      p.addEventListener("click", () => {
        selectedParcel = i;
        sessionStorage.setItem(STORAGE_KEY, String(i));
        featureParcel(i);
      });
    });

    // Restore default when mouse leaves the map
    svg.addEventListener("mouseleave", () => {
      setHover(-1);
      featureParcel(selectedParcel);
    });

    function onScroll() {
      const rect = section!.getBoundingClientRect();
      const sectionHeight = section!.offsetHeight;
      const viewportH = window.innerHeight;

      const scrolled = -rect.top;
      const scrollRange = sectionHeight - viewportH;
      const progress = Math.max(0, Math.min(1, scrolled / scrollRange));

      const cardCount = CARD_CONFIG.length;
      const start = 0.1;
      const end = 0.9;
      const cardProgress = (progress - start) / (end - start);

      if (cardProgress < 0 || progress <= 0) {
        setActiveCard(-1);
      } else if (cardProgress >= 1) {
        setActiveCard(cardCount - 1);
      } else {
        setActiveCard(Math.floor(cardProgress * cardCount));
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  initPropertyDetails();
  document.addEventListener("astro:page-load", initPropertyDetails);
</script>
