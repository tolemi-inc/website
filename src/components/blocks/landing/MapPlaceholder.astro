---
interface Props {
  id?: string;
}
const { id } = Astro.props;
---

<div
  id={id}
  class="w-full aspect-[4/3] rounded-xl bg-surface border border-text-muted/10 shadow-sm overflow-hidden relative"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-tolemi-sky-50/50 to-transparent"
  >
  </div>
  <svg
    class="absolute inset-0 w-full h-full"
    viewBox="0 0 400 300"
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g stroke="#0e9bc4" stroke-width="0.5" opacity="0.1">
      <line x1="0" y1="50" x2="400" y2="50" />
      <line x1="0" y1="100" x2="400" y2="100" />
      <line x1="0" y1="150" x2="400" y2="150" />
      <line x1="0" y1="200" x2="400" y2="200" />
      <line x1="0" y1="250" x2="400" y2="250" />
      <line x1="50" y1="0" x2="50" y2="300" />
      <line x1="100" y1="0" x2="100" y2="300" />
      <line x1="150" y1="0" x2="150" y2="300" />
      <line x1="200" y1="0" x2="200" y2="300" />
      <line x1="250" y1="0" x2="250" y2="300" />
      <line x1="300" y1="0" x2="300" y2="300" />
      <line x1="350" y1="0" x2="350" y2="300" />
    </g>
    <g id={id ? "map-parcels" : undefined}>
      <rect x="55" y="55" width="40" height="40" rx="2" fill="#0e9bc4" opacity="0.12" />
      <rect x="105" y="55" width="40" height="40" rx="2" fill="#0e9bc4" opacity="0.12" />
      <rect x="155" y="105" width="40" height="40" rx="2" fill="#FFCB1B" opacity="0.12" />
      <rect x="205" y="55" width="40" height="40" rx="2" fill="#FF0025" opacity="0.12" />
      <rect x="255" y="105" width="40" height="40" rx="2" fill="#0e9bc4" opacity="0.12" />
      <rect x="55" y="155" width="40" height="40" rx="2" fill="#FFCB1B" opacity="0.12" />
      <rect x="105" y="155" width="40" height="40" rx="2" fill="#37A04F" opacity="0.12" />
      <rect x="205" y="155" width="40" height="40" rx="2" fill="#0e9bc4" opacity="0.12" />
      <rect x="305" y="55" width="40" height="40" rx="2" fill="#37A04F" opacity="0.12" />
      <rect x="305" y="155" width="40" height="40" rx="2" fill="#FF0025" opacity="0.12" />
      <rect x="155" y="205" width="40" height="40" rx="2" fill="#0e9bc4" opacity="0.12" />
      <rect x="255" y="205" width="40" height="40" rx="2" fill="#FFCB1B" opacity="0.12" />
    </g>
  </svg>
  <div
    class="absolute bottom-3 left-3 text-[10px] text-text-muted/50 font-heading uppercase tracking-widest"
  >
    Map placeholder — import your assets here
  </div>
</div>
