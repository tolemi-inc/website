---
import fs from "node:fs";
import path from "node:path";

interface Props {
  id?: string;
}
const { id } = Astro.props;

const geojsonPath = path.join(process.cwd(), "public/maps/boston_blocks.geojson");
const geojson = JSON.parse(fs.readFileSync(geojsonPath, "utf-8"));

const SVG_WIDTH = 400;
const SVG_HEIGHT = 300;
const PADDING = 10;

// Compute bounding box
let minLng = Infinity, maxLng = -Infinity, minLat = Infinity, maxLat = -Infinity;
for (const f of geojson.features) {
  for (const mp of f.geometry.coordinates) {
    for (const ring of mp) {
      for (const [lng, lat] of ring) {
        if (lng < minLng) minLng = lng;
        if (lng > maxLng) maxLng = lng;
        if (lat < minLat) minLat = lat;
        if (lat > maxLat) maxLat = lat;
      }
    }
  }
}

const lngRange = maxLng - minLng;
const latRange = maxLat - minLat;
const drawW = SVG_WIDTH - PADDING * 2;
const drawH = SVG_HEIGHT - PADDING * 2;

const lngScale = drawW / lngRange;
const latScale = drawH / latRange;
const scale = Math.min(lngScale, latScale);
const offsetX = PADDING + (drawW - lngRange * scale) / 2;
const offsetY = PADDING + (drawH - latRange * scale) / 2;

function project(lng: number, lat: number): [number, number] {
  const x = offsetX + (lng - minLng) * scale;
  const y = offsetY + (maxLat - lat) * scale;
  return [Math.round(x * 100) / 100, Math.round(y * 100) / 100];
}

// Build SVG path data + centroid + bounding size
const parcels = geojson.features.map((f: any) => {
  const allPts: [number, number][] = [];
  const rings = f.geometry.coordinates.flatMap((mp: any) =>
    mp.map((ring: any) => {
      const pts = ring.map((coord: any) => {
        const p = project(coord[0], coord[1]);
        allPts.push(p);
        return p;
      });
      return "M" + pts.map((p: any) => p.join(",")).join("L") + "Z";
    })
  );
  const cx = allPts.reduce((s, p) => s + p[0], 0) / allPts.length;
  const cy = allPts.reduce((s, p) => s + p[1], 0) / allPts.length;
  let pMinX = Infinity, pMaxX = -Infinity, pMinY = Infinity, pMaxY = -Infinity;
  for (const [x, y] of allPts) {
    if (x < pMinX) pMinX = x; if (x > pMaxX) pMaxX = x;
    if (y < pMinY) pMinY = y; if (y > pMaxY) pMaxY = y;
  }
  return {
    d: rings.join(" "),
    cx: Math.round(cx * 100) / 100,
    cy: Math.round(cy * 100) / 100,
    w: Math.round((pMaxX - pMinX) * 100) / 100,
    h: Math.round((pMaxY - pMinY) * 100) / 100,
  };
});

// Emit lightweight parcel metadata for client-side coloring
const parcelMeta = geojson.features.map((f: any, i: number) => ({
  cx: parcels[i].cx,
  cy: parcels[i].cy,
  w: parcels[i].w,
  h: parcels[i].h,
  building_permits: f.properties.building_permits,
  zoning: f.properties.zoning,
  assessed_value: f.properties.assessed_value,
  last_sale_date: f.properties.last_sale_date,
}));
---

<div
  id={id}
  class="w-full aspect-[4/3] rounded-xl bg-surface border border-text-muted/10 shadow-sm overflow-hidden relative"
  data-map-container
>
  <div class="absolute inset-0 bg-gradient-to-br from-tolemi-sky-50/50 to-transparent"></div>
  <svg
    class="absolute inset-0 w-full h-full"
    viewBox={`0 0 ${SVG_WIDTH} ${SVG_HEIGHT}`}
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <filter id="parcel-glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>
    <g stroke="#cbd5e1" stroke-width="0.3">
      {parcels.map((p: any, i: number) => (
        <path
          d={p.d}
          fill="#f1f5f9"
          fill-opacity="1"
          data-idx={i}
          style="transition: fill 0.3s, fill-opacity 0.3s, stroke 0.3s, filter 0.3s;"
        />
      ))}
    </g>
    <g data-hover-overlay></g>
    <g data-labels></g>
  </svg>
  <script is:inline type="application/json" data-parcel-meta set:html={JSON.stringify(parcelMeta)} />
</div>
