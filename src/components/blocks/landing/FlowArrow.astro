---
interface Props {
  direction?: "horizontal" | "vertical";
}
const { direction = "horizontal" } = Astro.props;
---

{direction === "horizontal" ? (
  <div class="px-4 flex-shrink-0">
    <svg
      width="36"
      height="20"
      viewBox="0 0 36 20"
      fill="none"
      class="text-text-muted/30"
    >
      <path
        d="M0 10h28m0 0l-6-4m6 4l-6 4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
) : (
  <div class="flex justify-center my-2">
    <svg
      width="20"
      height="28"
      viewBox="0 0 20 28"
      fill="none"
      class="text-text-muted/30"
    >
      <path
        d="M10 0v22m0 0l-4-4m4 4l4-4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </div>
)}
