---
// The typewriter query panel with "Tolemi Insights" badge
---

<div>
  <div
    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-tolemi-sky/10 border border-tolemi-sky/20 mb-4"
  >
    <svg
      class="w-3.5 h-3.5 text-tolemi-sky-600"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5.002 5.002 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
      />
    </svg>
    <span class="font-heading text-xs font-bold text-tolemi-sky-600"
      >Tolemi Insights</span
    >
  </div>
  <div
    class="w-full bg-surface rounded-xl border border-text-muted/10 shadow-sm p-6 md:p-8"
  >
    <div class="flex items-center gap-2 mb-5">
      <div class="w-2 h-2 rounded-full bg-tolemi-sky-600 animate-pulse"></div>
      <span
        class="text-xs font-semibold text-text-muted uppercase tracking-widest"
        >Querying</span
      >
    </div>
    <div class="min-h-[3.5rem] flex items-start">
      <span
        id="typewriter-text"
        class="font-heading text-xl md:text-2xl font-bold text-text-primary"
      ></span>
      <span
        class="inline-block w-0.5 h-7 bg-tolemi-sky-600 ml-0.5 animate-pulse"
      ></span>
    </div>
    <div class="mt-5 pt-4 border-t border-text-muted/10">
      <div
        id="typewriter-answer"
        class="flex items-center gap-2 opacity-0 transition-opacity duration-500"
      >
        <div
          class="w-5 h-5 rounded-full bg-tolemi-green/15 flex items-center justify-center flex-shrink-0"
        >
          <svg
            class="w-3 h-3 text-tolemi-green"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M5 13l4 4L19 7"
            />
          </svg>
        </div>
        <span
          id="typewriter-answer-text"
          class="text-sm font-medium text-tolemi-green"></span>
      </div>
    </div>
  </div>
</div>
