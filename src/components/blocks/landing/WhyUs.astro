---
// Why us — humans and citizens who care, not another generic software vendor.
import AccentLine from "../../ui/AccentLine.astro";
import InfoCard from "../../ui/InfoCard.astro";
import { accentGradients, accentDarkTextGradients, accentTextGradients, type BrandAccent } from "../../../lib/brandAccents";

interface Point {
  title: string;
  description?: string;
  icon?: string;
  dark?: boolean;
}
interface Props {
  heading?: string;
  body?: string;
  points?: Point[];
  accentGradient?: string;
  pointAccents?: BrandAccent[];
  titleSize?: string;
  bodySize?: string;
}

// point descriptions may mark emphasis with **double asterisks**; the
// phrase renders oversized as gradient text in the point's own colors
const boldify = (s: string, gradient: string) =>
  s.replace(
    /\*\*(.+?)\*\*/g,
    `<strong class="text-[1.25em] font-bold bg-gradient-to-r ${gradient} bg-clip-text text-transparent">$1</strong>`
  );

// the leading number in stat titles (e.g. "10", "9K") wears the point's
// gradient, and plus signs get the same gradient oversized as a design
// statement (leading-none: a zero line box would give the gradient no area
// to paint, leaving the clipped text invisible)
const statify = (s: string, gradient: string) =>
  s
    .replace(
      /^([\d.,]+[KMB]?)/,
      `<span class="bg-gradient-to-r ${gradient} bg-clip-text text-transparent">$1</span>`
    )
    .replace(
      /\+/g,
      `<span class="inline-block text-[1.45em] leading-none font-extrabold relative top-[0.08em] bg-gradient-to-b ${gradient} bg-clip-text text-transparent">+</span>`
    );

const {
  heading = "Why Tolemi",
  body,
  points = [],
  accentGradient = accentGradients.sky,
  pointAccents = ["sky", "yellow", "red"],
  titleSize = "text-2xl md:text-3xl",
  bodySize = "text-base md:text-lg font-medium",
} = Astro.props;
---

<section class="py-16 md:py-24 px-6 bg-surface-secondary">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 md:gap-20 items-start">
    <div class="reveal">
      <AccentLine color={`bg-gradient-to-r ${accentGradient}`} width="w-12" class="mb-6" />
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary tracking-tight mb-6">
        {heading}
      </h2>
      {body && (
        <p class="text-base md:text-lg text-text-secondary leading-relaxed">{body}</p>
      )}
    </div>

    <div class="flex flex-col gap-8 md:pt-4 reveal">
      {points.map((point, i) => {
        const accent = pointAccents[i % pointAccents.length];
        // bright on navy, the dimmer twin on white so the text stays legible
        const textGradient = (point.dark ? accentDarkTextGradients : accentTextGradients)[accent];
        return (
          <InfoCard icon={point.icon} dark={point.dark} accent={accent} titleSize={titleSize} bodySize={bodySize}>
            <Fragment slot="title" set:html={statify(point.title, textGradient)} />
            {point.description && (
              <Fragment set:html={boldify(point.description, textGradient)} />
            )}
          </InfoCard>
        );
      })}
    </div>
  </div>
</section>
