---
// Pipeline — "Your Data, Unified" diagram
// Cities → Data Sources → Tolemi → Products flow

import CitySeals from "./CitySeals.astro";
import DataSourceCards from "./DataSourceCards.astro";
import FlowArrow from "./FlowArrow.astro";
import TolemiLogo from "./TolemiLogo.astro";
import ProductCards from "./ProductCards.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import pipelineData from "../../../data/pipeline.json";

const { cityGroups, sourceGroups, allCityIds } = pipelineData;

const pick = <T,>(arr: T[]) => arr[Math.floor(Math.random() * arr.length)];

const displaySeals = pick(cityGroups);
const displaySources = pick(sourceGroups);

// For flip-card backs, use a different source group
const otherSources = sourceGroups.find(g => g !== displaySources) ?? displaySources;
const sourceBackOrder = otherSources;
---

<section
  id="pipeline"
  class="py-20 md:py-28 px-6 bg-surface relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto">
    <SectionHeader
      eyebrow="How it works"
      heading="Your Data, Unified"
      subtitle="Tolemi connects to your city's existing data sources and transforms them into a single, intelligent platform."
    />

    {/* ===== DESKTOP: single-row horizontal flow ===== */}
    <div class="hidden md:flex items-center justify-center gap-0 reveal">
      <CitySeals
        displaySeals={displaySeals}
        allSealIds={allCityIds}
        gridCols={3}
        sealSize="w-9 h-9"
        id="df-seals-grid"
      />
      <FlowArrow direction="horizontal" />
      <DataSourceCards
        sources={displaySources}
        backOrder={sourceBackOrder}
        cardClass="w-[110px] h-[26px]"
        layout="vertical"
        id="df-sources"
      />
      <FlowArrow direction="horizontal" />
      <TolemiLogo size="md" />
      <FlowArrow direction="horizontal" />
      <ProductCards variant="desktop" />
    </div>

    {/* Feedback loop arrow — desktop only */}
    <div class="hidden md:flex justify-center mt-6 reveal">
      <svg
        width="90%"
        height="36"
        viewBox="0 0 800 36"
        fill="none"
        preserveAspectRatio="xMidYMid meet"
        class="text-tolemi-sky/25 max-w-3xl"
      >
        <path
          d="M750 4 Q 790 4 790 14 L 790 20 Q 790 30 750 30 L 50 30 Q 10 30 10 20 L 10 16"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-dasharray="6 3"></path>
        <path
          d="M6 20l4-6 4 6"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    {/* ===== MOBILE: vertical stacked flow ===== */}
    <div class="md:hidden reveal">
      <div class="mb-1">
        <CitySeals
          displaySeals={displaySeals.slice(0, 24)}
          allSealIds={allCityIds}
          gridCols={6}
          sealSize="w-7 h-7"
          id="df-seals-grid-mobile"
        />
      </div>
      <FlowArrow direction="vertical" />
      <div class="mb-1">
        <DataSourceCards
          sources={displaySources}
          backOrder={sourceBackOrder}
          cardClass="w-[80px] h-[28px]"
          layout="grid"
          id="df-sources-mobile"
        />
      </div>
      <FlowArrow direction="vertical" />
      <div class="flex justify-center mb-1">
        <TolemiLogo size="sm" />
      </div>
      <FlowArrow direction="vertical" />
      <ProductCards variant="mobile" />
    </div>

  </div>
</section>

<style>
  .flip-card {
    perspective: 300px;
  }
  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }
  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
  }
  .flip-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: inherit;
    overflow: hidden;
  }
  .flip-back {
    transform: rotateY(180deg);
  }
  .df-source-face {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px 4px;
    background: white;
  }
</style>

<script>
  import pipelineData from "../../../data/pipeline.json";

  const { allCityIds, allSources } = pipelineData;

  function pick<T>(arr: T[]): T {
    return arr[Math.floor(Math.random() * arr.length)];
  }

  // Seal flips
  const sealCards = document.querySelectorAll(".df-seal");
  function flipSeal() {
    if (!sealCards.length) return;
    const card = pick([...sealCards]) as HTMLElement;
    const back = card.querySelector(".flip-back img") as HTMLImageElement;
    if (back) back.src = `/city_seals/${pick(allCityIds)}.png`;
    card.classList.toggle("flipped");
    setTimeout(flipSeal, 2000 + Math.random() * 3000);
  }
  if (sealCards.length) setTimeout(flipSeal, 1500);

  // Source flips — track what each card currently shows to avoid duplicates
  const sourceCards = document.querySelectorAll(".df-source");
  const sourceState: string[] = [];
  sourceCards.forEach((card) => {
    const isFlipped = card.classList.contains("flipped");
    const face = isFlipped ? ".flip-back img" : ".flip-front img";
    const img = card.querySelector(face) as HTMLImageElement;
    const src = img?.src?.split("/data_sources/")[1] || "";
    sourceState.push(decodeURIComponent(src));
  });

  function flipSource() {
    if (!sourceCards.length) return;
    const idx = Math.floor(Math.random() * sourceCards.length);
    const card = sourceCards[idx] as HTMLElement;
    const isFlipped = card.classList.contains("flipped");
    const hiddenFace = isFlipped ? ".flip-front img" : ".flip-back img";
    const img = card.querySelector(hiddenFace) as HTMLImageElement;

    const visibleSet = new Set(sourceState);
    const available = allSources.filter((s) => !visibleSet.has(s));
    const next = available.length > 0 ? pick(available) : pick(allSources);

    if (img) img.src = `/data_sources/${next}`;
    card.classList.toggle("flipped");
    sourceState[idx] = next;

    setTimeout(flipSource, 3000 + Math.random() * 4000);
  }
  if (sourceCards.length) setTimeout(flipSource, 2500);
</script>
