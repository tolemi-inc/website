---
// Pipeline — "Your Data, Unified" diagram
// Cities → Data Sources → Tolemi → Products flow

import CitySeals from "./CitySeals.astro";
import DataSourceCards from "./DataSourceCards.astro";
import FlowArrow from "./FlowArrow.astro";
import TolemiLogo from "./TolemiLogo.astro";
import ProductCards from "./ProductCards.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import pipelineData from "../../../data/pipeline.json";

const { cityGroups, sourceGroups } = pipelineData;

const pick = <T,>(arr: T[]) => arr[Math.floor(Math.random() * arr.length)];

const displaySeals = pick(cityGroups);
const displaySources = pick(sourceGroups);
---

<section
  id="pipeline"
  class="py-20 md:py-28 px-6 bg-surface relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto">
    <SectionHeader
      heading="Your Data, Unified"
      subtitle="Tolemi connects to your city's existing data sources and transforms them into a single, intelligent platform."
    />

    {/* ===== DESKTOP: single-row horizontal flow ===== */}
    <div class="hidden md:flex items-center justify-between gap-2 lg:gap-4 reveal max-w-6xl mx-auto">
      <CitySeals
        displaySeals={displaySeals}
        gridCols={3}
        sealSize="w-11 h-11"
        id="df-seals-grid"
      />
      <FlowArrow direction="horizontal" />
      <DataSourceCards
        sources={displaySources}
        cardClass="w-[130px] h-[52px]"
        layout="vertical"
        id="df-sources"
      />
      <FlowArrow direction="horizontal" />
      <TolemiLogo class="w-40 h-40" />
      <FlowArrow direction="horizontal" />
      <ProductCards variant="desktop" />
    </div>

    {/* Feedback loop arrow — desktop only */}
    <div class="hidden md:flex justify-center mt-6 reveal">
      <svg
        width="90%"
        height="36"
        viewBox="0 0 800 36"
        fill="none"
        preserveAspectRatio="xMidYMid meet"
        class="text-tolemi-sky/25 max-w-5xl"
      >
        <path
          d="M750 4 Q 790 4 790 14 L 790 20 Q 790 30 750 30 L 50 30 Q 10 30 10 20 L 10 16"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-dasharray="6 3"></path>
        <path
          d="M6 20l4-6 4 6"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </div>

    {/* ===== MOBILE: vertical stacked flow ===== */}
    <div class="md:hidden reveal">
      <div class="mb-1">
        <CitySeals
          displaySeals={displaySeals.slice(0, 24)}
          gridCols={6}
          sealSize="w-7 h-7"
          id="df-seals-grid-mobile"
        />
      </div>
      <FlowArrow direction="vertical" />
      <div class="mb-1">
        <DataSourceCards
          sources={displaySources}
          cardClass="w-[80px] h-[36px]"
          layout="grid"
          id="df-sources-mobile"
        />
      </div>
      <FlowArrow direction="vertical" />
      <div class="flex justify-center mb-1">
        <TolemiLogo class="w-12 h-12" />
      </div>
      <FlowArrow direction="vertical" />
      <ProductCards variant="mobile" />
    </div>

  </div>
</section>


<script>
  import pipelineData from "../../../data/pipeline.json";

  const { cityGroups, sourceGroups } = pipelineData;
  const FADE_MS = 500;
  const INTERVAL_MS = 5000;

  function pickDifferent(arr: any[], currentIdx: number): number {
    if (arr.length <= 1) return 0;
    let next = Math.floor(Math.random() * arr.length);
    while (next === currentIdx) next = Math.floor(Math.random() * arr.length);
    return next;
  }

  // Blink helper — fade out, swap content, fade in
  function setupBlink(
    containerSelector: string,
    cardSelector: string,
    groups: any[][],
    makeSrc: (item: any) => string,
    intervalMs: number,
    delayMs: number,
  ) {
    const containers = document.querySelectorAll(containerSelector);
    if (!containers.length) return;

    let currentIdx = 0;

    function blink() {
      const nextIdx = pickDifferent(groups, currentIdx);
      currentIdx = nextIdx;
      const nextGroup = groups[nextIdx];

      containers.forEach((container) => {
        (container as HTMLElement).style.opacity = "0";

        setTimeout(() => {
          const cards = container.querySelectorAll(cardSelector);
          cards.forEach((card, i) => {
            const img = card.querySelector("img") as HTMLImageElement;
            if (img && nextGroup[i] !== undefined) {
              img.src = makeSrc(nextGroup[i]);
            }
          });
          (container as HTMLElement).style.opacity = "1";
        }, FADE_MS);
      });

      setTimeout(blink, intervalMs + Math.random() * 3000);
    }

    setTimeout(blink, delayMs);
  }

  // City seals blink
  setupBlink(
    ".df-seal-container",
    ".df-seal",
    cityGroups,
    (id: number) => `/city_seals/${id}.png`,
    INTERVAL_MS,
    4000,
  );

  // Data sources blink
  setupBlink(
    ".df-source-container",
    ".df-source",
    sourceGroups,
    (file: string) => `/data_sources/${file}`,
    INTERVAL_MS,
    6000,
  );
</script>
