---
import fs from "node:fs";
import path from "node:path";

interface Props {
  id?: string;
}
const { id } = Astro.props;

const geojsonPath = path.join(process.cwd(), "public/maps/boston_blocks.geojson");
const geojson = JSON.parse(fs.readFileSync(geojsonPath, "utf-8"));

const SVG_WIDTH = 400;
const SVG_HEIGHT = 300;
const PADDING = 10;

// Geographic area constants (Boston latitude)
const BOSTON_LAT_RAD = 42.36 * Math.PI / 180;
const LAT_M = 111320;
const LNG_M = 111320 * Math.cos(BOSTON_LAT_RAD);
const SQM_PER_ACRE = 4046.86;

// Compute bounding box
let minLng = Infinity, maxLng = -Infinity, minLat = Infinity, maxLat = -Infinity;
for (const f of geojson.features) {
  for (const mp of f.geometry.coordinates) {
    for (const ring of mp) {
      for (const [lng, lat] of ring) {
        if (lng < minLng) minLng = lng;
        if (lng > maxLng) maxLng = lng;
        if (lat < minLat) minLat = lat;
        if (lat > maxLat) maxLat = lat;
      }
    }
  }
}

const lngRange = maxLng - minLng;
const latRange = maxLat - minLat;
const drawW = SVG_WIDTH - PADDING * 2;
const drawH = SVG_HEIGHT - PADDING * 2;

const lngScale = drawW / lngRange;
const latScale = drawH / latRange;
const scale = Math.min(lngScale, latScale);
const offsetX = PADDING + (drawW - lngRange * scale) / 2;
const offsetY = PADDING + (drawH - latRange * scale) / 2;

function project(lng: number, lat: number): [number, number] {
  const x = offsetX + (lng - minLng) * scale;
  const y = offsetY + (maxLat - lat) * scale;
  return [Math.round(x * 100) / 100, Math.round(y * 100) / 100];
}

// Build SVG path data + compute geographic area in acres
const parcels = geojson.features.map((f: any) => {
  const allPts: [number, number][] = [];
  const rings = f.geometry.coordinates.flatMap((mp: any) =>
    mp.map((ring: any) => {
      const pts = ring.map((coord: any) => {
        const p = project(coord[0], coord[1]);
        allPts.push(p);
        return p;
      });
      return "M" + pts.map((p: any) => p.join(",")).join("L") + "Z";
    })
  );
  const cx = allPts.reduce((s, p) => s + p[0], 0) / allPts.length;
  const cy = allPts.reduce((s, p) => s + p[1], 0) / allPts.length;

  // Geographic area via shoelace on lat/lng
  let geoArea = 0;
  for (const mp of f.geometry.coordinates) {
    for (const ring of mp) {
      let a = 0;
      for (let j = 0; j < ring.length - 1; j++) {
        a += ring[j][0] * ring[j + 1][1] - ring[j + 1][0] * ring[j][1];
      }
      geoArea += Math.abs(a) / 2;
    }
  }
  const acres = geoArea * LAT_M * LNG_M / SQM_PER_ACRE;

  return { d: rings.join(" "), cx, cy, acres: Math.round(acres * 10000) / 10000 };
});

// Heatmap: tolemi logo colors — sky → green → yellow → red
// Use percentile-based mapping so outlier areas don't dominate
const allAcres = parcels.map((p: any) => p.acres);
const sortedAcres = [...allAcres].sort((a: number, b: number) => a - b);
const minAcres = sortedAcres[0];
const maxAcres = sortedAcres[sortedAcres.length - 1];

// Build percentile rank for each parcel (0–1 evenly distributed)
const acresRank = new Map<number, number>();
allAcres.forEach((a: number, i: number) => {
  const rank = sortedAcres.filter((v: number) => v <= a).length / sortedAcres.length;
  acresRank.set(i, rank);
});

// #4CD5FF (sky) → #37A04F (green) → #FFCB1B (yellow) → #FF0025 (red)
const STOPS = [
  { r: 76, g: 213, b: 255 },
  { r: 55, g: 160, b: 79 },
  { r: 255, g: 203, b: 27 },
  { r: 255, g: 0, b: 37 },
];

function rankToColor(t: number): string {
  const clamped = Math.max(0, Math.min(1, t));
  const segCount = STOPS.length - 1;
  const seg = Math.min(Math.floor(clamped * segCount), segCount - 1);
  const local = clamped * segCount - seg;
  const a = STOPS[seg], b = STOPS[seg + 1];
  const r = Math.round(a.r + (b.r - a.r) * local);
  const g = Math.round(a.g + (b.g - a.g) * local);
  const bl = Math.round(a.b + (b.b - a.b) * local);
  return `rgb(${r},${g},${bl})`;
}

const minAcresLabel = minAcres < 0.01 ? "<0.01" : minAcres.toFixed(2);
const maxAcresLabel = maxAcres.toFixed(2);

// Full parcel metadata for client-side filtering & details
const parcelMeta = geojson.features.map((f: any, i: number) => ({
  street_address: f.properties.street_address,
  property_value: f.properties.property_value,
  assessed_value: f.properties.assessed_value,
  last_sale_date: f.properties.last_sale_date,
  is_rental: f.properties.is_rental,
  is_owner_occupied: f.properties.is_owner_occupied,
  is_vacant: f.properties.is_vacant,
  building_permits: f.properties.building_permits,
  count_permits_last_six_months: f.properties.count_permits_last_six_months,
  count_police_calls_last_six_months: f.properties.count_police_calls_last_six_months,
  zoning: f.properties.zoning,
  acres: parcels[i].acres,
}));
---

<div
  id={id}
  class="w-full aspect-[4/3] rounded-xl bg-surface border border-text-muted/10 shadow-sm overflow-hidden relative"
  data-map-container
>
  <div class="absolute inset-0 bg-gradient-to-br from-tolemi-indigo-50/20 to-transparent"></div>
  <svg
    class="absolute inset-0 w-full h-full"
    viewBox={`0 0 ${SVG_WIDTH} ${SVG_HEIGHT}`}
    preserveAspectRatio="xMidYMid slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <filter id="selection-glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>
    <g stroke="rgba(255,255,255,0.25)" stroke-width="0.3">
      {parcels.map((p: any, i: number) => (
        <path
          d={p.d}
          fill={rankToColor(acresRank.get(i) ?? 0)}
          fill-opacity="0.75"
          data-idx={i}
          data-fill={rankToColor(acresRank.get(i) ?? 0)}
          style="transition: fill-opacity 0.3s;"
        />
      ))}
    </g>
    <g id="hover-overlay"></g>
    <g id="selection-overlay"></g>
  </svg>
  <!-- Legend -->
  <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center gap-2 bg-white/80 backdrop-blur-sm rounded-md px-3 py-1.5">
    <span class="text-[9px] text-text-muted font-medium shrink-0">{minAcresLabel} ac</span>
    <div class="flex-1 h-2 rounded-sm" style="background: linear-gradient(to right, #4CD5FF, #37A04F, #FFCB1B, #FF0025)"></div>
    <span class="text-[9px] text-text-muted font-medium shrink-0">{maxAcresLabel} ac</span>
  </div>
  <script is:inline type="application/json" data-parcel-meta set:html={JSON.stringify(parcelMeta)} />
</div>
