  {
    title: "Building Permits",
    desc: "New construction, renovations, demolitions, all in one place.",
    bgColor: "bg-tolemi-sky/10",
    iconColor: "text-tolemi-sky-600",
    icon: "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21",
  },
  {
    title: "Zoning",
    desc: "Districts, overlays, variances",
    bgColor: "bg-tolemi-yellow/10",
    iconColor: "text-tolemi-yellow-600",
    icon: "M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z",
  },
  {
    title: "Assessed Value",
    desc: "Violations, inspections, compliance",
    bgColor: "bg-tolemi-red/10",
    iconColor: "text-tolemi-red",
    icon: "M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z",
  },
  {
    title: "Last Sale Date",
    desc: "Values, classifications, ownership history",
    bgColor: "bg-tolemi-green/10",
    iconColor: "text-tolemi-green",
    icon: "M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z",
  },
];
---

<div class="space-y-3">
  {
    cards.map((card, i) => (
      <div class="flex items-center gap-3 p-4 rounded-xl bg-surface border border-text-muted/10 shadow-sm transition-all duration-400" data-card={i}>
        <div
          class={`w-9 h-9 rounded-lg ${card.bgColor} flex items-center justify-center flex-shrink-0`}
        >
          <svg
            class={`w-[18px] h-[18px] ${card.iconColor}`}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d={card.icon}
            />
          </svg>
        </div>
        <div>
          <div class="font-heading text-sm font-bold text-text-primary">
            {card.title}
          </div>
          <div class="text-xs text-text-muted">{card.desc}</div>
        </div>
      </div>
    ))
  }
</div>
