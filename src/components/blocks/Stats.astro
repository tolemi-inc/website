---
interface StatItem {
  value: string;
  label: string;
}

interface Props {
  heading?: string;
  items?: StatItem[];
}

const { heading, items = [] } = Astro.props;
---

<section class="py-32 md:py-40 px-6 relative overflow-hidden bg-surface-secondary">
  <div class="max-w-7xl mx-auto relative z-10">
    {heading && (
      <div class="text-center mb-20 md:mb-24 reveal">
        <p class="text-xs font-semibold tracking-widest uppercase text-tolemi-indigo mb-4">By the numbers</p>
        <h2 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary">{heading}</h2>
      </div>
    )}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {items.map((item, i) => (
        <div
          class="text-center p-8 md:p-10 rounded-2xl border border-tolemi-indigo/10 backdrop-blur-sm reveal bg-gradient-to-br from-tolemi-indigo/5 via-tolemi-sky/5 to-transparent"
          style={`transition-delay: ${i * 100}ms`}
        >
          <div class="font-heading text-4xl md:text-5xl font-bold mb-3 bg-gradient-to-r from-tolemi-indigo to-tolemi-sky bg-clip-text text-transparent">
            {item.value}
          </div>
          <div class="text-sm text-text-secondary">{item.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
