---
import ImageCarousel from "../ui/ImageCarousel.astro";

interface Props {
  title: string;
  bodyHtml: string;
  images?: readonly (string | null)[] | null;
  reverse?: boolean;
}

const { title, bodyHtml, images, reverse = false } = Astro.props;
const validImages = (images || []).filter((s): s is string => typeof s === "string" && s.length > 0);
const hasImages = validImages.length > 0;

const textOrder = reverse ? "md:order-2" : "md:order-1";
const mediaOrder = reverse ? "md:order-1" : "md:order-2";
---

<article class="reveal">
  {hasImages ? (
    <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
      <div class={textOrder}>
        <h3 class="font-heading text-2xl md:text-3xl font-semibold text-text-primary mb-4">{title}</h3>
        <div class="richtext max-w-none">
          <Fragment set:html={bodyHtml} />
        </div>
      </div>
      <div class={mediaOrder}>
        <ImageCarousel images={validImages} alt={title} />
      </div>
    </div>
  ) : (
    <div class="max-w-3xl mx-auto">
      <h3 class="font-heading text-2xl md:text-3xl font-semibold text-text-primary mb-4">{title}</h3>
      <div class="prose prose-lg text-text-secondary max-w-none">
        <Fragment set:html={bodyHtml} />
      </div>
    </div>
  )}
</article>
