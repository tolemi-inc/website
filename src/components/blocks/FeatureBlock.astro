---
import ImageCarousel from "../ui/ImageCarousel.astro";

interface FeatureImage {
  src: string | null;
  alt?: string;
}

interface Props {
  title: string;
  bodyHtml: string;
  images?: readonly (FeatureImage | null)[] | null;
  reverse?: boolean;
  index?: number;
}

const { title, bodyHtml, images, reverse = false, index = 0 } = Astro.props;
const validImages = (images || [])
  .filter((img): img is FeatureImage => !!img && typeof img.src === "string" && img.src.length > 0)
  .map((img) => ({ src: img.src as string, alt: img.alt ?? "" }));
const hasImages = validImages.length > 0;

const textOrder = reverse ? "md:order-2" : "md:order-1";
const mediaOrder = reverse ? "md:order-1" : "md:order-2";

const accentClass =
  index % 3 === 0
    ? "w-8 h-1 rounded-full bg-gradient-to-r from-tolemi-sky-600 to-tolemi-sky mb-5"
    : index % 3 === 1
      ? "w-8 h-1 rounded-full bg-gradient-to-r from-tolemi-red to-tolemi-yellow mb-5"
      : "w-8 h-1 rounded-full bg-gradient-to-r from-tolemi-yellow to-tolemi-sky mb-5";
---

<article class="reveal">
  {hasImages ? (
    <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
      <div class={textOrder}>
        <div class={accentClass}></div>
        <h3 class="font-heading text-2xl md:text-3xl font-semibold text-text-primary mb-4">{title}</h3>
        <div class="richtext max-w-none">
          <Fragment set:html={bodyHtml} />
        </div>
      </div>
      <div class={mediaOrder}>
        <ImageCarousel images={validImages} fallbackAlt={title} />
      </div>
    </div>
  ) : (
    <div class="max-w-3xl mx-auto">
      <div class={accentClass}></div>
      <h3 class="font-heading text-2xl md:text-3xl font-semibold text-text-primary mb-4">{title}</h3>
      <div class="richtext max-w-none">
        <Fragment set:html={bodyHtml} />
      </div>
    </div>
  )}
</article>
