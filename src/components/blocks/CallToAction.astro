---
import DemoButton from "../ui/DemoButton.astro";

interface Props {
  heading: string;
  text?: string;
  buttonText?: string;
  buttonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  buildingColor?: string;
  buildingOpacity?: string;
  highlightColorA?: string;
  highlightColorB?: string;
  highlightColorC?: string;
  highlightOpacity?: string;
}

const {
  heading,
  text,
  buttonText,
  buttonLink,
  secondaryButtonText,
  secondaryButtonLink,
  buildingColor = "bg-tolemi-dark",
  buildingOpacity = "opacity-[0.11]",
  highlightColorA = "bg-tolemi-sky",
  highlightColorB = "bg-tolemi-yellow",
  highlightColorC = "bg-tolemi-red",
  highlightOpacity = "opacity-60",
} = Astro.props;

// SVGs are used as masks so the fill color comes from a Tailwind bg-* class
const mapLayer = (src: string) =>
  `mask: url(${src}) center / cover no-repeat; -webkit-mask: url(${src}) center / cover no-repeat;`;
---

<section id="contact" class="relative py-32 md:py-40 px-6 overflow-hidden">
  <!-- Light background with subtle gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-surface via-surface-secondary to-surface"></div>

  <!-- Warm accent glows -->
  <div class="absolute top-0 right-0 w-1/2 h-1/2 bg-tolemi-yellow/8 blur-[140px]"></div>
  <div class="absolute bottom-0 left-0 w-1/3 h-1/2 bg-tolemi-sky/6 blur-[120px]"></div>

  <!-- Map background: Boston building footprints (BPDA), with a few highlighted buildings -->
  <div aria-hidden="true">
    <div class={`absolute inset-0 ${buildingColor} ${buildingOpacity}`} style={mapLayer("/maps/boston_buildings_footprints.svg")}></div>
    <div class={`absolute inset-0 ${highlightColorA} ${highlightOpacity}`} style={mapLayer("/maps/boston_buildings_highlight_a.svg")}></div>
    <div class={`absolute inset-0 ${highlightColorB} ${highlightOpacity}`} style={mapLayer("/maps/boston_buildings_highlight_b.svg")}></div>
    <div class={`absolute inset-0 ${highlightColorC} ${highlightOpacity}`} style={mapLayer("/maps/boston_buildings_highlight_c.svg")}></div>
    <!-- Soften the map behind the copy -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--color-surface)_0%,transparent_65%)] opacity-80"></div>
  </div>

  <div class="relative z-10 max-w-3xl mx-auto text-center reveal">
    <h2 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-8">{heading}</h2>
    {text && <p class="text-lg md:text-xl text-text-secondary mb-12 leading-relaxed">{text}</p>}
    <div class="flex flex-wrap items-center justify-center gap-4">
      {buttonText && (
        <DemoButton href={buttonLink || "#"} size="lg" arrow>{buttonText}</DemoButton>
      )}
      {secondaryButtonText && (
        <a
          href={secondaryButtonLink || "#"}
          class="inline-flex items-center justify-center font-semibold px-8 py-4 text-base rounded-full border-2 border-tolemi-dark text-tolemi-dark hover:border-tolemi-red hover:text-tolemi-red transition-all"
        >
          {secondaryButtonText}
        </a>
      )}
    </div>
  </div>

  <!-- Bottom gradient bar (coral → indigo → sky) -->
  <div class="absolute bottom-0 left-0 w-full h-2 bg-gradient-to-r from-tolemi-red via-tolemi-yellow to-tolemi-sky"></div>
</section>
