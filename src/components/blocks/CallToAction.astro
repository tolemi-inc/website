---
interface Props {
  heading: string;
  text?: string;
  buttonText?: string;
  buttonLink?: string;
}

const { heading, text, buttonText, buttonLink } = Astro.props;
---

<section id="contact" class="relative py-32 md:py-40 px-6 overflow-hidden">
  <!-- Light background with subtle gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-surface via-surface-secondary to-surface"></div>

  <!-- Warm accent glows -->
  <div class="absolute top-0 right-0 w-1/2 h-1/2 bg-tolemi-yellow/8 blur-[140px]"></div>
  <div class="absolute bottom-0 left-0 w-1/3 h-1/2 bg-tolemi-sky/6 blur-[120px]"></div>

  <!-- Map background -->
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <!-- Street grid -->
    <g opacity="0.06" stroke="#343332" stroke-width="1">
      <line x1="100" y1="100" x2="1100" y2="100"/>
      <line x1="80" y1="200" x2="1120" y2="200"/>
      <line x1="100" y1="300" x2="1100" y2="300"/>
      <line x1="120" y1="400" x2="1080" y2="400"/>
      <line x1="100" y1="500" x2="1100" y2="500"/>
      <line x1="200" y1="50" x2="200" y2="550"/>
      <line x1="400" y1="50" x2="400" y2="550"/>
      <line x1="600" y1="50" x2="600" y2="550"/>
      <line x1="800" y1="50" x2="800" y2="550"/>
      <line x1="1000" y1="50" x2="1000" y2="550"/>
      <line x1="100" y1="80" x2="1100" y2="520" stroke-width="1.5"/>
    </g>
    <!-- City blocks -->
    <g opacity="0.04" fill="#343332">
      <rect x="210" y="110" width="180" height="80" rx="2"/>
      <rect x="410" y="110" width="180" height="80" rx="2"/>
      <rect x="610" y="110" width="180" height="80" rx="2"/>
      <rect x="210" y="210" width="180" height="80" rx="2"/>
      <rect x="410" y="210" width="180" height="80" rx="2"/>
      <rect x="610" y="210" width="180" height="80" rx="2"/>
      <rect x="810" y="210" width="180" height="80" rx="2"/>
      <rect x="210" y="310" width="180" height="80" rx="2"/>
      <rect x="410" y="310" width="180" height="80" rx="2"/>
      <rect x="610" y="310" width="180" height="80" rx="2"/>
      <rect x="810" y="310" width="180" height="80" rx="2"/>
      <rect x="410" y="410" width="180" height="80" rx="2"/>
      <rect x="610" y="410" width="180" height="80" rx="2"/>
    </g>
    <!-- Subtle data pins (sky + indigo only) -->
    <circle cx="300" cy="150" r="6" fill="#4CD5FF" opacity="0.12"/>
    <circle cx="500" cy="250" r="8" fill="#FFCB1B" opacity="0.1"/>
    <circle cx="700" cy="350" r="7" fill="#4CD5FF" opacity="0.1"/>
    <circle cx="900" cy="250" r="5" fill="#FFCB1B" opacity="0.12"/>
    <circle cx="450" cy="450" r="6" fill="#4CD5FF" opacity="0.08"/>
  </svg>

  <div class="relative z-10 max-w-3xl mx-auto text-center reveal">
    <p class="text-xs font-semibold tracking-widest uppercase text-tolemi-sky-600 mb-6">Get started</p>
    <h2 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-8">{heading}</h2>
    {text && <p class="text-lg md:text-xl text-text-secondary mb-12 leading-relaxed">{text}</p>}
    {buttonText && (
      <a
        href={buttonLink || "#"}
        class="inline-flex items-center gap-2 bg-tolemi-dark text-white font-semibold px-8 py-4 rounded-full hover:shadow-xl hover:shadow-tolemi-dark/15 transition-all text-base"
      >
        {buttonText}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    )}
  </div>

  <!-- Bottom gradient bar (coral → indigo → sky) -->
  <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-tolemi-red via-tolemi-yellow to-tolemi-sky"></div>
</section>
