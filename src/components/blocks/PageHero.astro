---
interface Props {
  headline: string;
  subheadline?: string;
  image?: { src: string | null; alt?: string } | null;
}

const { headline, subheadline, image } = Astro.props;
const imageSrc = image?.src ?? null;
const imageAlt = image?.alt?.trim() ? image.alt : headline;
---

<section class="relative pt-44 pb-12 md:pt-52 md:pb-16 px-6 overflow-hidden z-0">
  <div class="absolute inset-0 bg-gradient-to-br from-surface via-white to-tolemi-sky/[0.03]"></div>
  <div class="relative max-w-4xl mx-auto text-center reveal">
    <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary mb-8">{headline}</h1>
    {subheadline && (
      <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">{subheadline}</p>
    )}
  </div>
  {imageSrc && (
    <div class="relative mt-14 md:mt-20 max-w-5xl mx-auto reveal">
      <img
        src={imageSrc}
        alt={imageAlt}
        class="w-full h-auto rounded-2xl shadow-xl shadow-tolemi-dark/10 border border-text-muted/10"
      />
    </div>
  )}
</section>
