---
// LandingBody — all sections on the landing page, in narrative order:
// mission → story graph → products → registration → how we work → why us
// → cities → investors → CTA.

import HeroGraph from "./landing/HeroGraph.astro";
import StoryGraph from "./landing/StoryGraph.astro";
import ProductTabs from "./landing/ProductTabs.astro";
import RegistrationSpotlight from "./landing/RegistrationSpotlight.astro";
import HowWeWork from "./landing/HowWeWork.astro";
import WhyUs from "./landing/WhyUs.astro";
import CityLogos from "./CityLogos.astro";
import Stats from "./landing/Stats.astro";
import Investors from "./Investors.astro";
import CallToAction from "./CallToAction.astro";

interface Props {
  hero?: { headline: string; subheadline?: string; ctaText?: string; ctaLink?: string };
  story?: { heading?: string; subheading?: string; stages?: any[]; layers?: any[] };
  products?: { heading?: string; subheading?: string; items?: any[] };
  registration?: {
    eyebrow?: string;
    heading: string;
    body?: string;
    bullets?: any[];
    imagePath?: string;
    imageAlt?: string;
    ctaText?: string;
    ctaLink?: string;
  };
  howWeWork?: { heading?: string; subheading?: string; steps?: any[]; closing?: string };
  whyUs?: { heading?: string; body?: string; points?: any[] };
  logos?: { heading?: string; subheading?: string };
  stats?: { heading?: string; items?: any[] };
  cta?: { heading: string; text?: string; buttonText?: string; buttonLink?: string };
}

const { hero, story, products, registration, howWeWork, whyUs, logos, stats, cta } = Astro.props;
---

{/* Mission hero — the ownership graph over the mission statement */}
{hero && <HeroGraph {...hero} />}

{/* Story graph — data → insights → workflows → action */}
{story && <StoryGraph {...story} />}

{/* Products — Slate, BuildingBlocks, PubliCity */}
{products && <ProductTabs {...products} />}

{/* Property registration spotlight */}
{registration && <RegistrationSpotlight {...registration} />}

{/* How we work — turnkey lifecycle */}
{howWeWork && <HowWeWork {...howWeWork} />}

{/* Why us */}
{whyUs && <WhyUs {...whyUs} />}

{/* City logos — Trusted by Cities Nationwide */}
{logos && <CityLogos {...logos} />}

{/* Stats — only renders if a stats block exists in the CMS */}
{stats && <Stats {...stats} />}

{/* Investors */}
<Investors />

{/* CTA */}
{cta && <CallToAction {...cta} />}
