---
// LandingBody — all sections on the landing page

import Hero from "./Hero.astro";
import Products from "./landing/Products.astro";
import Pipeline from "./landing/Pipeline.astro";
import PropertyDetails from "./landing/PropertyDetails.astro";
import Insights from "./landing/Insights.astro";
import CityLogos from "./CityLogos.astro";
import Stats from "./landing/Stats.astro";
import Investors from "./Investors.astro";
import CallToAction from "./CallToAction.astro";

interface Props {
  hero?: { headline: string; subheadline?: string; ctaText?: string; ctaLink?: string };
  features?: { heading?: string; subheading?: string; items?: any[] };
  stats?: { heading?: string; items?: any[] };
  cta?: { heading: string; text?: string; buttonText?: string; buttonLink?: string };
}

const { hero, stats, cta } = Astro.props;
---

{/* Hero */}
{hero && <Hero {...hero} />}

{/* Products — What is Tolemi? */}
<Products />

{/* Pipeline — Your Data, Unified */}
<Pipeline />

{/* Property Details — Every Property. Every Detail. */}
<PropertyDetails />

{/* Insights — Tolemi Insights typewriter */}
<Insights />

{/* City logos — Trusted by Cities Nationwide */}
<CityLogos />

{/* Stats — Trusted by Growing Cities */}
{stats && <Stats {...stats} />}

{/* Investors */}
<Investors />

{/* CTA — Ready to Transform Your Data? */}
{cta && <CallToAction {...cta} />}
