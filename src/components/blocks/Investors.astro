---
// Investor logos section
// Using text placeholders — replace with actual SVGs/PNGs when available
const investors = [
  { name: "Y Combinator", logo: "/logos/investors/ycombinator.svg", sizeClass: "h-8 md:h-10" },
  { name: "Lightspeed", logo: "/logos/investors/lightspeed.png", sizeClass: "h-40 md:h-56" },
  { name: "Fika Ventures", logo: "/logos/investors/fika.png", sizeClass: "h-20 md:h-28" },
];
---

<section class="py-28 md:py-36 bg-surface relative">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-16 md:mb-20 reveal">
      <h2
        class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary tracking-tight mb-5"
      >
        Backed by the Best
      </h2>
      <p
        class="text-base md:text-lg text-text-secondary max-w-lg mx-auto leading-relaxed"
      >
        We're proud to be supported by world-class investors who believe in the
        future of civic technology.
      </p>
    </div>

    <div
      class="flex flex-wrap items-center justify-center gap-12 md:gap-16 reveal"
    >
      {
        investors.map((inv) => (
          <div class="flex items-center justify-center group">
            {inv.logo ? (
              <img
                src={inv.logo}
                alt={inv.name}
                class={`${inv.sizeClass} w-auto`}
              />
            ) : (
              <div class="h-10 md:h-12 px-6 flex items-center justify-center bg-surface-secondary rounded-lg border border-text-muted/15">
                <span class="font-heading text-sm font-semibold text-text-muted group-hover:text-text-primary transition-colors">
                  {inv.name}
                </span>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Decorative bottom border (gradient) -->
  <div
    class="absolute bottom-0 left-1/2 -translate-x-1/2 w-32 h-1 rounded-full bg-gradient-to-r from-tolemi-red via-tolemi-yellow to-tolemi-sky"
  >
  </div>
</section>
