---
// City seals — 3 rows, scroll sideways on page scroll
const row1 = [57, 58, 63, 70, 75, 79, 83, 89, 90, 101, 110, 118, 120, 124, 126, 127, 128, 131, 133, 134, 139, 143, 149, 150, 151, 154, 155, 157, 158, 163, 164, 168, 169, 171, 174, 175, 178, 179, 182, 184, 186, 187, 188, 189, 190, 192, 193, 194, 195, 196, 197, 198, 199, 201, 202, 204];
const row2 = [205, 206, 208, 209, 211, 212, 220, 222, 224, 225, 226, 227, 228, 230, 231, 232, 233, 234, 235, 236, 238, 239, 240, 254, 258, 259, 260, 261, 262, 264, 265, 266, 267, 268, 269, 270, 272, 273, 274, 276, 277, 279, 280, 281, 282, 283, 284, 285, 286, 287, 288, 289, 292, 296, 297];
const row3 = [298, 302, 305, 307, 311, 325, 326, 327, 330, 332, 336, 337, 338, 340, 341, 342, 343, 344, 348, 350, 351, 352, 353, 355, 357, 358, 365, 367, 368, 369, 371, 372, 375, 377, 378, 379, 381, 382, 383, 384, 385, 386, 387, 389, 390, 394, 397, 398, 401, 402, 403, 404, 405, 406, 408];
---

<section id="city-logos" class="py-28 md:py-36 relative overflow-hidden bg-surface">
  <div class="max-w-7xl mx-auto px-6 mb-16 md:mb-20 reveal">
    <div class="text-center">
      <h2 class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary tracking-tight mb-5">
        Trusted by Cities Nationwide
      </h2>
      <p class="text-base md:text-lg text-text-secondary max-w-xl mx-auto leading-relaxed">
        Over 100 municipal governments use Tolemi to manage and understand their data.
      </p>
    </div>
  </div>

  <!-- Row 1 -->
  <div class="mb-5 overflow-hidden">
    <div class="city-row city-row-1 flex w-max">
      {row1.map((id) => (
        <div class="flex-shrink-0 w-20 h-20 md:w-24 md:h-24 mx-3 rounded-xl bg-surface border border-text-muted/10 shadow-sm flex items-center justify-center p-3 hover:shadow-lg hover:scale-105 transition-all duration-300">
          <img
            src={`/city_seals/${id}.png`}
            alt="City seal"
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Row 2 -->
  <div class="mb-5 overflow-hidden">
    <div class="city-row city-row-2 flex w-max">
      {row2.map((id) => (
        <div class="flex-shrink-0 w-20 h-20 md:w-24 md:h-24 mx-3 rounded-xl bg-surface border border-text-muted/10 shadow-sm flex items-center justify-center p-3 hover:shadow-lg hover:scale-105 transition-all duration-300">
          <img
            src={`/city_seals/${id}.png`}
            alt="City seal"
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Row 3 -->
  <div class="overflow-hidden">
    <div class="city-row city-row-3 flex w-max">
      {row3.map((id) => (
        <div class="flex-shrink-0 w-20 h-20 md:w-24 md:h-24 mx-3 rounded-xl bg-surface border border-text-muted/10 shadow-sm flex items-center justify-center p-3 hover:shadow-lg hover:scale-105 transition-all duration-300">
          <img
            src={`/city_seals/${id}.png`}
            alt="City seal"
            class="w-full h-full object-contain"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-surface-secondary to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-surface-secondary to-transparent z-10 pointer-events-none"></div>
</section>

<script>
  const section = document.getElementById('city-logos');
  const row1 = document.querySelector('.city-row-1') as HTMLElement;
  const row2 = document.querySelector('.city-row-2') as HTMLElement;
  const row3 = document.querySelector('.city-row-3') as HTMLElement;

  function onCityScroll() {
    if (!section || !row1 || !row2 || !row3) return;

    const rect = section.getBoundingClientRect();
    const viewH = window.innerHeight;
    const progress = Math.max(0, Math.min(1, (viewH - rect.top) / (viewH + rect.height)));

    const maxShift = 300;
    const shift = (progress - 0.5) * maxShift * 2;

    row1.style.transform = `translateX(${-shift}px)`;
    row2.style.transform = `translateX(${shift}px)`;
    row3.style.transform = `translateX(${-shift * 0.7}px)`;
  }

  window.addEventListener('scroll', onCityScroll, { passive: true });
  onCityScroll();
</script>
