---
// City seals — 3 rows in a slow continuous marquee (CSS only, never tied to
// page scroll). Each row is duplicated once for a seamless loop.
interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = "Trusted by Cities Nationwide",
  subheading = "Over 100 municipal governments across the US use Tolemi to understand their data, run their programs, and make smarter decisions.",
} = Astro.props;

const row1 = [
  57, 58, 63, 70, 75, 79, 83, 89, 90, 101, 110, 118, 120, 124, 126, 127, 128,
  131, 133, 134, 139, 143, 149, 150, 151, 154, 155, 157, 158, 163, 164, 168,
  169, 171, 174, 175, 178, 179, 182, 184, 186, 187, 188, 189, 190, 192, 193,
  194, 195, 196, 197, 198, 199, 201, 202, 204,
];
const row2 = [
  205, 206, 208, 209, 211, 212, 220, 222, 224, 225, 226, 227, 228, 230, 231,
  232, 233, 234, 235, 236, 238, 239, 240, 254, 258, 259, 260, 261, 262, 264,
  265, 266, 267, 268, 269, 270, 272, 273, 274, 276, 277, 279, 280, 281, 282,
  283, 284, 285, 286, 287, 288, 289, 292, 296, 297,
];
const row3 = [
  298, 302, 305, 307, 311, 325, 326, 327, 330, 332, 336, 337, 338, 340, 341,
  342, 343, 344, 348, 350, 351, 352, 353, 355, 357, 358, 365, 367, 368, 369,
  371, 372, 375, 377, 378, 379, 381, 382, 383, 384, 385, 386, 387, 389, 390,
  394, 397, 398, 401, 402, 403, 404, 405, 406, 408,
];

const rows = [
  { ids: row1, reverse: false, duration: "180s" },
  { ids: row2, reverse: true, duration: "200s" },
  { ids: row3, reverse: false, duration: "220s" },
];
---

<section id="city-logos" class="py-28 md:py-36 relative overflow-hidden bg-surface">
  <div class="max-w-7xl mx-auto px-6 mb-16 md:mb-20 reveal">
    <div class="text-center">
      <h2
        class="font-heading text-3xl md:text-5xl lg:text-6xl font-bold text-text-primary tracking-tight mb-5"
      >
        {heading}
      </h2>
      <p class="text-base md:text-lg text-text-secondary max-w-xl mx-auto leading-relaxed">
        {subheading}
      </p>
    </div>
  </div>

  {rows.map((row, i) => (
    <div class:list={["overflow-hidden", i < rows.length - 1 && "mb-5"]}>
      <div
        class:list={["city-row flex w-max", row.reverse && "city-row--reverse"]}
        style={`animation-duration: ${row.duration}`}
      >
        {[...row.ids, ...row.ids].map((id) => (
          <div class="flex-shrink-0 w-20 h-20 md:w-24 md:h-24 mx-3 rounded-xl bg-surface border border-text-muted/10 shadow-sm flex items-center justify-center p-3 hover:shadow-lg hover:scale-105 transition-all duration-300">
            <img
              src={`/city_seals/${id}.png`}
              alt="City seal"
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  ))}

  <!-- Fade edges -->
  <div
    class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-surface to-transparent z-10 pointer-events-none"
  >
  </div>
  <div
    class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-surface to-transparent z-10 pointer-events-none"
  >
  </div>
</section>

<style>
  .city-row {
    animation-name: cityMarquee;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .city-row--reverse {
    animation-direction: reverse;
  }
  .city-row:hover {
    animation-play-state: paused;
  }
  @keyframes cityMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .city-row {
      animation: none;
    }
  }
</style>
