---
import DemoButton from "../ui/DemoButton.astro";

interface Job {
  title: string;
  department?: string;
  location?: string;
  type?: string;
  description?: string;
  applyLink?: string;
}

interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
---

<section class="py-16 md:py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-10 reveal">Open Positions</h2>
    <div class="flex flex-col gap-6">
      {jobs.map((job) => (
        <div class="bg-white rounded-2xl border border-black/[0.06] p-8 reveal">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div class="flex-1">
              <h3 class="font-heading text-xl font-semibold text-text-primary">{job.title}</h3>
              <div class="flex flex-wrap gap-3 mt-2">
                {job.department && (
                  <span class="text-xs font-medium bg-tolemi-sky/10 text-tolemi-sky-600 px-3 py-1 rounded-full">{job.department}</span>
                )}
                {job.location && (
                  <span class="text-xs font-medium bg-tolemi-sky/10 text-tolemi-sky-700 px-3 py-1 rounded-full">{job.location}</span>
                )}
                {job.type && (
                  <span class="text-xs font-medium bg-tolemi-sky-100 text-tolemi-sky-700 px-3 py-1 rounded-full">{job.type}</span>
                )}
              </div>
              {job.description && <p class="text-text-secondary text-sm mt-4 leading-relaxed">{job.description}</p>}
            </div>
            {job.applyLink && (
              <DemoButton href={job.applyLink} size="sm" arrow class="shrink-0">Apply</DemoButton>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
